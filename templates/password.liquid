{%- comment -%} Page de garde — la boutique n'est pas encore ouverte. {%- endcomment -%}
<div class="mot-de-passe__bloc">
  {%- if settings.logo_clair != blank -%}
    <img src="{{ settings.logo_clair | image_url: height: 140 }}" alt="{{ shop.name | escape }}"
         width="{{ settings.logo_clair.width }}" height="{{ settings.logo_clair.height }}"
         style="height: 34px; width: auto;">
  {%- else -%}
    <p class="pied__mot">{{ shop.name }}</p>
  {%- endif -%}

  {%- if settings.signature != blank -%}
    <p class="pied__signature">{{ settings.signature }}</p>
  {%- endif -%}

  <h1 class="mot-de-passe__titre equilibre">{{ shop.password_message | default: 'Le site ouvre bientôt.' }}</h1>

  {%- form 'storefront_password', class: 'formulaire mot-de-passe__formulaire' -%}
    {%- if form.errors -%}
      <p class="formulaire__message formulaire__message--erreur" role="alert">
        {{ form.errors.translated_fields.form }} {{ form.errors.messages.form }}
      </p>
    {%- endif -%}
    <label class="champ">
      <input type="password" name="password" id="mdp-boutique" class="champ__saisie" placeholder=" " autocomplete="current-password" required>
      <span class="champ__label">{{ 'compte.mot_de_passe' | t }}</span>
    </label>
    <div class="formulaire__actions">
      <button type="submit" class="btn btn--clair">{{ 'compte.connexion' | t }}</button>
    </div>
  {%- endform -%}

  {%- if settings.cabinet_tel != blank or settings.cabinet_email != blank -%}
    <p class="mot-de-passe__contact">
      {%- if settings.cabinet_tel != blank -%}
        <a class="lien" href="tel:{{ settings.cabinet_tel | remove: ' ' | remove: '.' }}">{{ settings.cabinet_tel }}</a>
      {%- endif -%}
      {%- if settings.cabinet_email != blank -%}
        <a class="lien" href="mailto:{{ settings.cabinet_email }}">{{ settings.cabinet_email }}</a>
      {%- endif -%}
    </p>
  {%- endif -%}
</div>
