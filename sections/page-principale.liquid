{%- comment -%}
  Page éditoriale générique — mentions légales, à propos, conditions.
  Sert de gabarit par défaut pour toute page sans suffixe dédié.
{%- endcomment -%}

<section class="section">
  <div class="lisiere">
    <nav class="ariane" aria-label="{{ 'referencement.accueil' | t }}">
      <a href="{{ routes.root_url }}">{{ 'referencement.accueil' | t }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ page.title }}</span>
    </nav>

    <div class="grille-12 mt-9 gap-y-10">
      <div class="col-span-12 lg:col-span-4">
        {%- if section.settings.surtitre != blank -%}
          <p class="surtitre" data-index="{{ section.settings.index }}" data-reveal>
            {{ section.settings.surtitre }}
          </p>
        {%- endif -%}
        <h1 class="mt-5 equilibre max-w-[16ch]" data-reveal style="--reveal-delay: 60ms">
          {{ page.title }}
        </h1>
        <span class="filet mt-8 w-full max-w-30" data-reveal-rule aria-hidden="true"></span>
      </div>

      <div class="col-span-12 lg:col-span-7 lg:col-start-6">
        <div class="prose-ely page-simple__corps" data-reveal style="--reveal-delay: 120ms">
          {{ page.content }}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "—" },
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Le cabinet" }
  ]
}
{% endschema %}
