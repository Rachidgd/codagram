{%- comment -%}
  Demande de rendez-vous.

  Le visiteur indique le soin qui l'intéresse, la ville où il souhaite venir
  et la date qui l'arrange. Le cabinet répond en confirmant cette date ou en
  proposant autre chose. Aucun créneau n'est bloqué en ligne, et la page le
  dit clairement plutôt que de laisser croire à une réservation ferme.

  Le formulaire de contact Shopify est conservé entier : sans JavaScript, les
  quatre temps s'affichent à la suite et l'envoi fonctionne. Le script ne fait
  que replier les panneaux et valider la saisie.
{%- endcomment -%}

{%- liquid
  assign secondes_jour = 86400
  assign depart = 'now' | date: '%s' | plus: 0
  assign delai = section.settings.delai_jours | times: secondes_jour
  assign date_min = depart | plus: delai | date: '%Y-%m-%d'
  assign portee = section.settings.horizon_jours | times: secondes_jour
  assign date_max = depart | plus: portee | date: '%Y-%m-%d'
-%}

<section
  id="{{ section.settings.ancre | default: 'rendez-vous' | handleize }}"
  class="section {{ section.settings.surface }}"
>
  <div class="lisiere">
    <div class="grille-12 gap-y-12">
      <div class="col-span-12 lg:col-span-4">
        {%- render 'entete-section',
          index: section.settings.index,
          surtitre: section.settings.surtitre,
          titre: section.settings.titre,
          niveau: section.settings.niveau_titre
        -%}

        {%- if section.settings.chapo != blank -%}
          <div class="mt-7 text-sm text-grain texte-mesure" data-reveal style="--reveal-delay: 140ms">
            {{ section.settings.chapo }}
          </div>
        {%- endif -%}

        {%- if settings.cabinet_horaires != blank -%}
          <div class="rdv__horaires" data-reveal style="--reveal-delay: 200ms">
            <p class="surtitre">{{ 'cabinet.horaires' | t }}</p>
            <p class="nombres-tabulaires">{{ settings.cabinet_horaires | newline_to_br }}</p>
          </div>
        {%- endif -%}

        {%- if settings.cabinet_tel != blank -%}
          <p class="rdv__appel" data-reveal style="--reveal-delay: 260ms">
            {{ section.settings.mention_appel }}
            <a class="lien nombres-tabulaires" href="tel:{{ settings.cabinet_tel | remove: ' ' | remove: '.' }}">
              {{ settings.cabinet_tel }}
            </a>
          </p>
        {%- endif -%}
      </div>

      <div class="col-span-12 lg:col-span-7 lg:col-start-6">
        {%- form 'contact', id: 'formulaire-rendez-vous', class: 'formulaire' -%}
          {%- if form.posted_successfully? -%}
            <p class="formulaire__message formulaire__message--succes" role="status" tabindex="-1">
              {{ 'rdv.succes' | t }}
            </p>
          {%- elsif form.errors -%}
            <div class="formulaire__message formulaire__message--erreur" role="alert" tabindex="-1">
              <p>{{ 'formulaire.erreurs_a_corriger' | t }}</p>
              <ul role="list" class="mt-2">
                {%- for champ in form.errors -%}
                  <li>{{ form.errors.messages[champ] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <ely-formulaire
            class="block"
            data-libelle-suivant="{{ 'diagnostic.suivant' | t }}"
            data-libelle-precedent="{{ 'diagnostic.precedent' | t }}"
            data-libelle-envoyer="{{ section.settings.libelle_bouton }}"
            data-libelle-etape="{{ 'formulaire.etape_sur' | t: courante: '%C%', total: '%T%' }}"
            data-erreur-requis="{{ 'formulaire.obligatoire' | t }}"
            data-erreur-email="{{ 'formulaire.email_invalide' | t }}"
            data-erreur-telephone="{{ 'formulaire.telephone_invalide' | t }}"
            data-erreur-consentement="{{ 'formulaire.consentement_requis' | t }}"
          >
            <div class="formulaire__etapes" data-formulaire-avancement hidden>
              <span data-formulaire-compteur></span>
              <span class="formulaire__jauge" aria-hidden="true"></span>
            </div>

            {%- comment -%} Temps 1 : le soin {%- endcomment -%}
            <fieldset class="formulaire__panneau" data-panneau="1">
              <legend class="formulaire__legende">{{ section.settings.legende_soin }}</legend>

              <label class="champ">
                <select id="rdv-soin" class="champ__saisie" name="contact[Soin souhaité]" data-requis>
                  <option value=""></option>
                  {%- for bloc in section.blocks -%}
                    {%- if bloc.type == 'soin' -%}
                      <option value="{{ bloc.settings.nom | escape }}">
                        {{ bloc.settings.nom }}
                        {%- if bloc.settings.duree != blank %} ({{ bloc.settings.duree }}){% endif -%}
                      </option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
                <span class="champ__label">{{ 'rdv.soin' | t }}</span>
                <span class="champ__erreur" data-erreur hidden></span>
              </label>

              {%- if section.settings.aide_soin != blank -%}
                <p class="text-sm text-grain texte-mesure">{{ section.settings.aide_soin }}</p>
              {%- endif -%}
            </fieldset>

            {%- comment -%} Temps 2 : la ville {%- endcomment -%}
            <fieldset class="formulaire__panneau" data-panneau="2">
              <legend class="formulaire__legende">{{ section.settings.legende_ville }}</legend>

              <div>
                <div class="formulaire__villes">
                  {%- for bloc in section.blocks -%}
                    {%- if bloc.type == 'ville' -%}
                      <label class="choix" {{ bloc.shopify_attributes }}>
                        <input
                          type="radio"
                          name="contact[Ville]"
                          value="{{ bloc.settings.libelle | escape }}"
                          {% if forloop.first %}
                            data-requis
                          {% endif %}
                        >
                        <span>{{ bloc.settings.libelle }}</span>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <span class="champ__erreur" data-erreur hidden></span>
              </div>
            </fieldset>

            {%- comment -%}
              Temps 3 : la date.

              Un champ date natif plutôt qu'un calendrier maison : il ouvre le
              sélecteur du système, se remplit au clavier, se lit par un
              lecteur d'écran et connaît déjà le format du pays du visiteur.
              Les bornes empêchent de demander hier ou dans deux ans.
            {%- endcomment -%}
            <fieldset class="formulaire__panneau" data-panneau="3">
              <legend class="formulaire__legende">{{ section.settings.legende_date }}</legend>

              <div>
                <ely-calendrier
                  data-libelle-precedent="{{ 'calendrier.mois_precedent' | t }}"
                  data-libelle-suivant="{{ 'calendrier.mois_suivant' | t }}"
                >
                  <label class="champ">
                    <input
                      type="date"
                      id="rdv-date"
                      class="champ__saisie"
                      name="contact[Date souhaitée]"
                      min="{{ date_min }}"
                      max="{{ date_max }}"
                      data-requis
                    >
                    <span class="champ__label champ__label--fixe">{{ 'rdv.date' | t }}</span>
                  </label>
                </ely-calendrier>
                <span class="champ__erreur" data-erreur hidden></span>
              </div>

              <div class="formulaire__rangee formulaire__rangee--deux">
                <label class="champ">
                  <select id="rdv-moment" class="champ__saisie" name="contact[Moment de la journée]">
                    <option value="">{{ 'rdv.peu_importe' | t }}</option>
                    <option value="Matin">{{ 'rdv.matin' | t }}</option>
                    <option value="Après-midi">{{ 'rdv.apres_midi' | t }}</option>
                    <option value="Fin de journée">{{ 'rdv.fin_journee' | t }}</option>
                  </select>
                  <span class="champ__label champ__label--fixe">{{ 'rdv.moment' | t }}</span>
                </label>
              </div>

              <label class="champ">
                <input
                  type="date"
                  id="rdv-date-repli"
                  class="champ__saisie"
                  name="contact[Deuxième date possible]"
                  min="{{ date_min }}"
                  max="{{ date_max }}"
                >
                <span class="champ__label champ__label--fixe">
                  {{ 'rdv.date_repli' | t }} ({{ 'formulaire.facultatif' | t }})
                </span>
              </label>

              <p class="text-sm text-grain texte-mesure">{{ section.settings.mention_confirmation }}</p>
            </fieldset>

            {%- comment -%} Temps 4 : les coordonnées {%- endcomment -%}
            <fieldset class="formulaire__panneau" data-panneau="4">
              <legend class="formulaire__legende">{{ section.settings.legende_coordonnees }}</legend>

              <div class="formulaire__rangee formulaire__rangee--deux">
                <label class="champ">
                  <input
                    type="text"
                    id="rdv-nom"
                    class="champ__saisie"
                    name="contact[name]"
                    autocomplete="name"
                    placeholder=" "
                    value="{{ form.name }}"
                    data-requis
                  >
                  <span class="champ__label">{{ 'formulaire.nom' | t }}</span>
                  <span class="champ__erreur" data-erreur hidden></span>
                </label>

                <label class="champ">
                  <input
                    type="email"
                    id="rdv-email"
                    class="champ__saisie"
                    name="contact[email]"
                    autocomplete="email"
                    inputmode="email"
                    placeholder=" "
                    value="{{ form.email }}"
                    data-requis
                    data-type="email"
                  >
                  <span class="champ__label">{{ 'formulaire.email' | t }}</span>
                  <span class="champ__erreur" data-erreur hidden></span>
                </label>
              </div>

              <label class="champ">
                <input
                  type="tel"
                  id="rdv-tel"
                  class="champ__saisie"
                  name="contact[phone]"
                  autocomplete="tel"
                  inputmode="tel"
                  placeholder=" "
                  data-requis
                  data-type="telephone"
                >
                <span class="champ__label">{{ 'formulaire.telephone' | t }}</span>
                <span class="champ__erreur" data-erreur hidden></span>
              </label>

              <label class="champ">
                <textarea
                  id="rdv-message"
                  class="champ__saisie"
                  name="contact[body]"
                  rows="3"
                  placeholder=" "
                >{{ form.body }}</textarea>
                <span class="champ__label">
                  {{ 'rdv.precision' | t }} ({{ 'formulaire.facultatif' | t }})
                </span>
              </label>

              <div>
                <label class="choix">
                  <input type="checkbox" name="contact[Consentement]" value="Accordé" data-requis data-type="consentement">
                  <span>{{ 'formulaire.consentement' | t }}</span>
                </label>
                <span class="champ__erreur" data-erreur hidden></span>
              </div>

              {%- if section.settings.mention_rgpd != blank -%}
                <p class="text-xs text-grain texte-mesure">{{ section.settings.mention_rgpd }}</p>
              {%- endif -%}
            </fieldset>

            {%- comment -%} Leurre anti-robot. {%- endcomment -%}
            <div class="formulaire__leurre" aria-hidden="true">
              <label for="rdv-reference">Ne pas remplir ce champ</label>
              <input type="text" id="rdv-reference" name="contact[reference-rdv]" tabindex="-1" autocomplete="off">
            </div>

            <div class="formulaire__actions" data-formulaire-actions>
              <button type="submit" class="btn" data-formulaire-envoyer>
                {{ section.settings.libelle_bouton }}
              </button>
            </div>
          </ely-formulaire>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Demande de rendez-vous",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "ancre",
      "label": "Ancre",
      "info": "Permet de pointer vers cette section depuis un lien : #rendez-vous",
      "default": "rendez-vous"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "options": [
        { "value": "", "label": "Porcelaine" },
        { "value": "surface-craie", "label": "Craie" },
        { "value": "surface-peau", "label": "Peau pâle" }
      ]
    },
    { "type": "text", "id": "index", "label": "Index", "default": "01" },
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Rendez-vous" },
    {
      "type": "textarea",
      "id": "titre",
      "label": "Titre",
      "default": "Dites-nous quand vous êtes libre."
    },
    {
      "type": "select",
      "id": "niveau_titre",
      "label": "Niveau du titre",
      "options": [
        { "value": "h1", "label": "H1, page dédiée" },
        { "value": "h2", "label": "H2, section dans une page" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "chapo",
      "label": "Texte d'accompagnement",
      "default": "<p>Choisissez le soin, la ville et la date qui vous arrange. Nous vous rappelons pour confirmer, ou pour vous proposer un autre horaire si celui-ci est déjà pris.</p>"
    },
    {
      "type": "text",
      "id": "mention_appel",
      "label": "Phrase avant le téléphone",
      "default": "Vous préférez appeler ?"
    },

    { "type": "header", "content": "Choix de la date" },
    {
      "type": "range",
      "id": "delai_jours",
      "label": "Première date possible",
      "info": "Nombre de jours à laisser avant la première date possible.",
      "min": 0,
      "max": 14,
      "step": 1,
      "unit": "j",
      "default": 1
    },
    {
      "type": "range",
      "id": "horizon_jours",
      "label": "Dernière date possible",
      "min": 30,
      "max": 180,
      "step": 30,
      "unit": "j",
      "default": 90
    },
    {
      "type": "textarea",
      "id": "mention_confirmation",
      "label": "Mention sous les dates",
      "info": "Doit rester exacte : tant que le cabinet n'a pas répondu, la date n'est pas retenue.",
      "default": "Cette date est une préférence, pas un rendez-vous confirmé. Nous vous répondons sous 24 h ouvrées pour la valider ou vous proposer le créneau le plus proche."
    },

    { "type": "header", "content": "Textes du formulaire" },
    { "type": "text", "id": "legende_soin", "label": "Légende, temps 1", "default": "Le soin" },
    { "type": "text", "id": "legende_ville", "label": "Légende, temps 2", "default": "La ville" },
    { "type": "text", "id": "legende_date", "label": "Légende, temps 3", "default": "La date" },
    {
      "type": "text",
      "id": "legende_coordonnees",
      "label": "Légende, temps 4",
      "default": "Vos coordonnées"
    },
    {
      "type": "textarea",
      "id": "aide_soin",
      "label": "Aide sous le choix du soin",
      "default": "Si vous hésitez, choisissez le bilan : c'est lui qui détermine le protocole adapté à votre peau."
    },
    { "type": "text", "id": "libelle_bouton", "label": "Libellé du bouton", "default": "Envoyer ma demande" },
    {
      "type": "textarea",
      "id": "mention_rgpd",
      "label": "Mention sur les données",
      "default": "Vos informations servent uniquement à traiter votre demande de rendez-vous. Elles ne sont ni cédées ni revendues, et vous pouvez demander leur suppression à tout moment."
    }
  ],
  "blocks": [
    {
      "type": "soin",
      "name": "Soin",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "nom", "label": "Nom", "default": "Nouveau soin" },
        { "type": "text", "id": "duree", "label": "Durée affichée", "default": "60 min" }
      ]
    },
    {
      "type": "ville",
      "name": "Ville",
      "limit": 6,
      "settings": [{ "type": "text", "id": "libelle", "label": "Libellé", "default": "Paris" }]
    }
  ],
  "presets": [
    {
      "name": "Demande de rendez-vous",
      "blocks": [
        { "type": "soin", "settings": { "nom": "Bilan avant premier soin", "duree": "40 min" } },
        { "type": "soin", "settings": { "nom": "Hydrafacial", "duree": "60 min" } },
        { "type": "soin", "settings": { "nom": "Microneedling", "duree": "75 min" } },
        { "type": "soin", "settings": { "nom": "Peeling", "duree": "45 min" } },
        { "type": "soin", "settings": { "nom": "HIFU et radiofréquence", "duree": "90 min" } },
        { "type": "soin", "settings": { "nom": "Luminothérapie LED", "duree": "30 min" } },
        { "type": "soin", "settings": { "nom": "Drainage lymphatique", "duree": "60 min" } },
        { "type": "ville", "settings": { "libelle": "Paris Champs-Élysées" } },
        { "type": "ville", "settings": { "libelle": "Casablanca" } }
      ]
    }
  ]
}
{% endschema %}
