{%- comment -%}
  Liste des guides. Pagination native Shopify, jamais de chargement infini :
  les pages paginées doivent rester indexables et partageables.
{%- endcomment -%}

<section class="cc-pagehead surface-dark" data-surface="dark">
  <span class="grid-field" aria-hidden="true"></span>
  <div class="shell">
    <nav aria-label="Fil d'Ariane">
      <ol class="cc-crumb" role="list">
        <li><a href="{{ routes.root_url }}">Accueil</a></li>
        <li aria-current="page">{{ blog.title }}</li>
      </ol>
    </nav>
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow" style="margin-top:1rem" data-reveal>{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="cc-pagehead__title" data-reveal>{{ section.settings.title | default: blog.title }}</h1>
    {%- if section.settings.lead != blank -%}
      <p class="cc-pagehead__lead" data-reveal>{{ section.settings.lead }}</p>
    {%- endif -%}

    {%- if blog.all_tags.size > 0 -%}
      <nav class="cc-tags" aria-label="Filtrer par thème" data-reveal>
        <a class="cc-tags__pill{% unless current_tags %} is-active{% endunless %}" href="{{ blog.url }}">Tous</a>
        {%- for tag in blog.all_tags -%}
          <a class="cc-tags__pill{% if current_tags contains tag %} is-active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</section>

<section class="surface-paper section-y" data-surface="paper">
  <div class="shell">
    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size > 0 -%}
        <div class="cc-posts">
          {%- for article in blog.articles -%}
            <a class="cc-post card card--hover" href="{{ article.url }}" data-reveal>
              <p class="cc-post__meta">
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d.%m.%Y' }}</time>
                {%- if article.tags.size > 0 -%}<span>{{ article.tags.first }}</span>{%- endif -%}
              </p>
              <h2 class="cc-post__title">{{ article.title }}</h2>
              {%- if article.excerpt_or_content != blank -%}
                <p class="cc-post__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p>
              {%- endif -%}
              <span class="cc-post__go">Lire le guide{%- render 'icon', name: 'arrow', size: 14 -%}</span>
            </a>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="cc-pagi" aria-label="Pagination">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span class="{% if part.title == paginate.current_page %}is-current{% endif %}">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="fg-muted">Aucun guide publié pour le moment.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog — Liste",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Ressources" },
    { "type": "text", "id": "title", "label": "Titre (H1)" },
    { "type": "textarea", "id": "lead", "label": "Accroche" }
  ]
}
{% endschema %}
