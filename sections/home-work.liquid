{%- comment -%}
  RÉALISATIONS

  Grille asymétrique : la première réalisation occupe deux colonnes. Évite le
  damier régulier qui signale immédiatement un gabarit, et hiérarchise le
  portfolio au lieu de tout mettre au même niveau.
{%- endcomment -%}

<section class="cc-work surface-paper section-y" data-surface="paper">
  <div class="shell">

    <div class="cc-head-block cc-head-block--split" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.title }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <p class="cc-head-block__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="cc-work__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_wide = false
          if forloop.first
            assign is_wide = true
          endif
        -%}
        <figure class="cc-piece{% if is_wide %} cc-piece--wide{% endif %}" data-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a class="cc-piece__hit" href="{{ block.settings.link }}"{% if block.settings.external %} target="_blank" rel="noopener"{% endif %}>
              <span class="visually-hidden">{{ block.settings.title }}</span>
            </a>
          {%- endif -%}

          <div class="cc-piece__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image
                | image_url: width: 1400
                | image_tag:
                  widths: '400,600,800,1000,1200,1400',
                  sizes: '(max-width: 767px) 92vw, (max-width: 1239px) 46vw, 600px',
                  loading: 'lazy',
                  alt: block.settings.alt | default: block.settings.title,
                  class: 'cc-piece__img'
              }}
            {%- else -%}
              <span class="cc-piece__ph" aria-hidden="true">{%- render 'icon', name: 'layers', size: 22 -%}</span>
            {%- endif -%}
          </div>

          <figcaption class="cc-piece__cap">
            <span class="cc-piece__meta">{{ block.settings.service }}</span>
            <span class="cc-piece__title">{{ block.settings.title }}</span>
            {%- if block.settings.link != blank -%}
              {%- render 'icon', name: 'arrow-up-right', size: 16, class: 'cc-piece__go' -%}
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Accueil — Réalisations",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Réalisations" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Des interfaces construites autour de la décision d'achat." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Chaque projet part du parcours réel : ce que le visiteur doit comprendre, dans quel ordre, et ce qui l'empêche encore d'agir." }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Réalisation",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Visuel" },
        { "type": "text", "id": "alt", "label": "Texte alternatif" },
        { "type": "text", "id": "service", "label": "Prestation", "default": "Shopify · CRO" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Nom du projet" },
        { "type": "url", "id": "link", "label": "Lien" },
        { "type": "checkbox", "id": "external", "label": "Ouvrir dans un nouvel onglet", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "Accueil — Réalisations" }]
}
{% endschema %}
