{%- comment -%}
  Journal — liste des articles.
  Index éditorial plutôt que grille de vignettes : la première publication est
  mise en avant, les suivantes se lisent en filets.
{%- endcomment -%}

<section class="section">
  <div class="lisiere">
    <div class="grille-12 gap-y-8">
      <div class="col-span-12 lg:col-span-6">
        {%- render 'entete-section',
          index: section.settings.index,
          surtitre: section.settings.surtitre,
          titre: blog.title,
          niveau: 'h1'
        -%}
      </div>
      {%- if section.settings.chapo != blank -%}
        <div
          class="col-span-12 lg:col-span-5 lg:col-start-8 self-end text-sm text-grain"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          {{ section.settings.chapo }}
        </div>
      {%- endif -%}
    </div>

    {%- if blog.all_tags.size > 0 and section.settings.afficher_filtres -%}
      <nav class="journal__filtres" aria-label="{{ 'journal.categorie' | t }}" data-reveal>
        <a
          class="journal__filtre {% unless current_tags %}est-actif{% endunless %}"
          href="{{ blog.url }}"
        >
          {{ 'journal.tous_les_articles' | t }}
        </a>
        {%- for tag in blog.all_tags -%}
          <a
            class="journal__filtre {% if current_tags contains tag %}est-actif{% endif %}"
            href="{{ blog.url }}/tagged/{{ tag | handle }}"
          >
            {{ tag }}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.par_page -%}
      {%- liquid
        comment
          La mise en avant n'a de sens que sur la première page non filtrée.
          Ailleurs, la liste occupe toute la largeur : aucune balise n'est
          ouverte dans une boucle, la structure reste valide dans tous les cas.
        endcomment
        assign mise_en_avant = false
        if paginate.current_page == 1 and current_tags == blank and blog.articles.size > 0
          assign mise_en_avant = true
          assign article_une = blog.articles.first
        endif
      -%}

      {%- if blog.articles.size > 0 -%}
        <div class="mt-12 grid gap-x-10 gap-y-12 lg:mt-14 lg:grid-cols-12">
          {%- if mise_en_avant -%}
            <article class="lg:col-span-7" data-reveal>
              <a class="journal__une block" href="{{ article_une.url }}" data-curseur="lien">
                {%- render 'image-reactive',
                  image: article_une.image,
                  ratio: 'paysage',
                  tailles: '(min-width: 64rem) 54vw, 92vw',
                  alt: article_une.title,
                  priorite: true,
                  zoom: true
                -%}
                <div class="mt-6 flex flex-col gap-3">
                  <span class="journal__meta">
                    <time datetime="{{ article_une.published_at | date: '%Y-%m-%d' }}">
                      {{ article_une.published_at | date: '%d.%m.%Y' }}
                    </time>
                    {%- if article_une.tags.size > 0 -%}
                      <span class="journal__separateur" aria-hidden="true">—</span>
                      <span>{{ article_une.tags.first }}</span>
                    {%- endif -%}
                  </span>
                  <h2 class="journal__titre">{{ article_une.title }}</h2>
                  <p class="journal__extrait">
                    {{ article_une.excerpt_or_content | strip_html | truncate: 200 }}
                  </p>
                </div>
              </a>
            </article>
          {%- endif -%}

          <div
            class="{% if mise_en_avant %}lg:col-span-4 lg:col-start-9{% else %}lg:col-span-12{% endif %}"
            data-reveal-groupe
            data-reveal-pas="60"
          >
            {%- for article in blog.articles -%}
              {%- unless mise_en_avant and forloop.first -%}
                <article data-reveal>
                  <a class="journal__ligne" href="{{ article.url }}" data-curseur="lien">
                    <span class="journal__meta">
                      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                        {{ article.published_at | date: '%d.%m.%Y' }}
                      </time>
                    </span>
                    <span class="journal__ligne-titre">{{ article.title }}</span>
                    {%- render 'icone', nom: 'ui.fleche-diagonale', taille: 14, classe: 'journal__ligne-fleche' -%}
                  </a>
                </article>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a class="pagination__lien" href="{{ paginate.previous.url }}" rel="prev">
                {%- render 'icone', nom: 'ui.fleche-gauche', taille: 15 -%}
                <span>{{ paginate.previous.title }}</span>
              </a>
            {%- endif -%}
            <span class="pagination__etat nombres-tabulaires">
              {{ paginate.current_page }} / {{ paginate.pages }}
            </span>
            {%- if paginate.next -%}
              <a class="pagination__lien" href="{{ paginate.next.url }}" rel="next">
                <span>{{ paginate.next.title }}</span>
                {%- render 'icone', nom: 'ui.fleche-droite', taille: 15 -%}
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="mt-12 text-sm text-grain">{{ 'journal.aucun_article' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Journal — liste",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "01" },
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Le journal" },
    {
      "type": "textarea",
      "id": "chapo",
      "label": "Texte d'accompagnement",
      "default": "Ce qu'on explique en cabinet, écrit une bonne fois. Aucun article n'est là pour vendre un protocole."
    },
    { "type": "checkbox", "id": "afficher_filtres", "label": "Afficher les catégories", "default": true },
    {
      "type": "range",
      "id": "par_page",
      "label": "Articles par page",
      "min": 6,
      "max": 24,
      "step": 2,
      "default": 12
    }
  ]
}
{% endschema %}
