<section class="cc-plain surface-dark section-y" data-surface="dark">
  <span class="grid-field" aria-hidden="true"></span>
  <div class="shell cc-404">
    <p class="eyebrow">Accès restreint</p>
    <h1 class="cc-404__title">{{ shop.name }}</h1>
    <p class="cc-404__text">Le site est momentanément fermé.</p>

    {%- form 'storefront_password' -%}
      <div class="cc-searchform" style="margin-top:1.25rem">
        <label class="visually-hidden" for="Password">Mot de passe</label>
        <input class="field" type="password" id="Password" name="password" autocomplete="current-password">
        <button class="btn btn--primary" type="submit">Entrer</button>
      </div>
      {%- if form.errors -%}
        <p class="cc-diag__err" style="display:block" role="alert">{{ form.errors.messages.form }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Mot de passe", "settings": [] }
{% endschema %}
