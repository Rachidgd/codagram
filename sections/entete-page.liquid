{%- comment -%}
  En-tête de page intérieure — plus léger que celui des protocoles.

  Porte le H1 et le fil d'Ariane. Sert aux pages éditoriales : le cabinet,
  les tarifs, les mentions. Le titre est un réglage : il peut différer du
  titre de page Shopify sans changer l'intention (règle du rédacteur 19,
  le H1 n'est pas le <title>).
{%- endcomment -%}

<section class="entete-page {{ section.settings.surface }}">
  <div class="lisiere">
    {%- if section.settings.afficher_ariane -%}
      <nav class="ariane" aria-label="{{ 'referencement.accueil' | t }}">
        <a href="{{ routes.root_url }}">{{ 'referencement.accueil' | t }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ section.settings.titre | default: page.title }}</span>
      </nav>
    {%- endif -%}

    <div class="grille-12 mt-9 gap-y-8">
      <div class="col-span-12 lg:col-span-6">
        {%- if section.settings.surtitre != blank -%}
          <p
            class="surtitre"
            {% if section.settings.index != blank %}
              data-index="{{ section.settings.index }}"
            {% endif %}
            data-reveal
          >
            {{ section.settings.surtitre }}
          </p>
        {%- endif -%}

        <h1 class="mt-5 equilibre max-w-[17ch]" data-reveal style="--reveal-delay: 60ms">
          {{ section.settings.titre | default: page.title }}
        </h1>

        <span class="filet mt-8 w-full max-w-30" data-reveal-rule aria-hidden="true"></span>
      </div>

      {%- if section.settings.chapo != blank -%}
        <div
          class="col-span-12 lg:col-span-5 lg:col-start-8 self-end text-lg text-grain texte-mesure"
          data-reveal
          style="--reveal-delay: 130ms"
        >
          {{ section.settings.chapo }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <dl class="entete-page__reperes" data-reveal-groupe data-reveal-pas="70">
        {%- for bloc in section.blocks -%}
          <div class="entete-page__repere" data-reveal {{ bloc.shopify_attributes }}>
            <dt class="entete-page__valeur">{{ bloc.settings.valeur }}</dt>
            <dd class="entete-page__libelle">{{ bloc.settings.libelle }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "En-tête de page",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "options": [
        { "value": "", "label": "Porcelaine" },
        { "value": "surface-craie", "label": "Craie" },
        { "value": "surface-peau", "label": "Peau pâle" }
      ]
    },
    { "type": "checkbox", "id": "afficher_ariane", "label": "Afficher le fil d'Ariane", "default": true },
    { "type": "text", "id": "index", "label": "Index", "default": "01" },
    { "type": "text", "id": "surtitre", "label": "Surtitre" },
    {
      "type": "textarea",
      "id": "titre",
      "label": "Titre (H1)",
      "info": "Laisser vide pour reprendre le titre de la page. Le H1 peut différer du titre de recherche sans changer l'intention."
    },
    { "type": "richtext", "id": "chapo", "label": "Chapô" }
  ],
  "blocks": [
    {
      "type": "repere",
      "name": "Repère chiffré",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "valeur", "label": "Valeur", "default": "07" },
        { "type": "text", "id": "libelle", "label": "Libellé", "default": "protocoles" }
      ]
    }
  ],
  "presets": [{ "name": "En-tête de page" }]
}
{% endschema %}
