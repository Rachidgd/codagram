{%- comment -%}
  GRILLE DE CONTENU

  Sert les livrables, inclusions, bénéfices. Deux densités possibles pour ne
  pas imposer la même maille à trois éléments et à neuf.
{%- endcomment -%}

{%- liquid
  assign surface = section.settings.surface | default: 'dark'
  assign surface_class = 'surface-dark'
  if surface == 'paper'
    assign surface_class = 'surface-paper'
  elsif surface == 'deep'
    assign surface_class = 'surface-deep'
  endif
  assign surface_attr = 'dark'
  if surface == 'paper'
    assign surface_attr = 'paper'
  endif
-%}

<section class="cc-cgrid {{ surface_class }} section-y" data-surface="{{ surface_attr }}">
  <div class="shell">

    {%- if section.settings.title != blank -%}
      <div class="cc-head-block" data-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="cc-head-block__text">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="cc-cgrid__grid cc-cgrid__grid--{{ section.settings.density | default: 'comfortable' }}">
      {%- for block in section.blocks -%}
        <article class="cc-cgrid__item card" data-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="cc-cgrid__ico">{%- render 'icon', name: block.settings.icon, size: 17 -%}</span>
          {%- endif -%}
          <h3 class="cc-cgrid__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="cc-cgrid__text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <a class="tlink cc-cgrid__link" href="{{ block.settings.link | default: routes.root_url }}">
              {{ block.settings.link_label }}{%- render 'icon', name: 'arrow', size: 14 -%}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contenu — Grille",
  "settings": [
    {
      "type": "select", "id": "surface", "label": "Fond", "default": "dark",
      "options": [
        { "value": "dark", "label": "Graphite" },
        { "value": "deep", "label": "Graphite profond" },
        { "value": "paper", "label": "Clair" }
      ]
    },
    {
      "type": "select", "id": "density", "label": "Densité", "default": "comfortable",
      "options": [
        { "value": "comfortable", "label": "Confortable (2 à 3 colonnes)" },
        { "value": "dense", "label": "Dense (3 à 4 colonnes)" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "title", "label": "Titre" },
    { "type": "textarea", "id": "text", "label": "Texte" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Élément",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Pictogramme", "default": "check",
          "options": [
            { "value": "none", "label": "Aucun" },
            { "value": "check", "label": "Validation" },
            { "value": "signal", "label": "Signal / SEO" },
            { "value": "layers", "label": "Site sur mesure" },
            { "value": "cart", "label": "E-commerce" },
            { "value": "gauge", "label": "Conversion" },
            { "value": "megaphone", "label": "Publicité" },
            { "value": "target", "label": "Audit" }
          ]
        },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [{ "name": "Contenu — Grille" }]
}
{% endschema %}
