{%- comment -%}
  En-tête de page « ville ».

  Porte le H1 géolocalisé et l'adresse du cabinet dans cette ville.

  Les données structurées suivent ce que la page déclare réellement. Quand
  l'adresse est renseignée, la section publie un établissement local complet,
  avec son propre identifiant, son adresse postale, son téléphone et ses
  horaires : c'est ce qui permet à Google de rattacher la page à la fiche
  établissement de la ville. Sans adresse, elle se limite à décrire un service
  rendu pour une zone, plutôt que d'inventer un lieu.
{%- endcomment -%}

<section class="protocole-heros" data-entete-inverse>
  {%- if section.settings.image != blank -%}
    <div class="protocole-heros__fond" aria-hidden="true">
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="
          {{ section.settings.image | image_url: width: 900 }} 900w,
          {{ section.settings.image | image_url: width: 1400 }} 1400w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        alt=""
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      >
    </div>
  {%- endif -%}

  <div class="lisiere relative">
    <nav class="ariane" aria-label="{{ 'referencement.accueil' | t }}">
      <a href="{{ routes.root_url }}">{{ 'referencement.accueil' | t }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ section.settings.ville | default: page.title }}</span>
    </nav>

    <div class="grille-12 mt-9 gap-y-8">
      <div class="col-span-12 lg:col-span-8">
        {%- if section.settings.surtitre != blank -%}
          <p class="surtitre heros__surtitre" data-reveal>{{ section.settings.surtitre }}</p>
        {%- endif -%}

        <h1 class="mt-6 equilibre max-w-[19ch]" data-reveal style="--reveal-delay: 70ms">
          {{ section.settings.titre | default: page.title }}
        </h1>

        {%- if section.settings.mention_statut != blank -%}
          <p class="ville-statut" data-reveal style="--reveal-delay: 110ms">
            <span class="ville-statut__pastille" aria-hidden="true"></span>
            {{ section.settings.mention_statut }}
          </p>
        {%- endif -%}

        {%- if section.settings.chapo != blank -%}
          <p class="heros__chapo" data-reveal style="--reveal-delay: 160ms">
            {{ section.settings.chapo }}
          </p>
        {%- endif -%}

        <div class="heros__actions" data-reveal style="--reveal-delay: 220ms">
          {%- render 'bouton',
            libelle: section.settings.libelle_principal,
            lien: section.settings.ancre_principale,
            style: 'clair',
            fleche: true
          -%}
          {%- if section.settings.ancre_secondaire != blank -%}
            {%- render 'bouton',
              libelle: section.settings.libelle_secondaire,
              lien: section.settings.ancre_secondaire,
              style: 'fantome'
            -%}
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%}
      Adresse locale. Une page de ville sans plan d'accès envoie le visiteur
      chercher ailleurs, et prive la page de son signal le plus fort.
    {%- endcomment -%}
    {%- if section.settings.rue != blank -%}
      <div class="ville-adresse" data-reveal style="--reveal-delay: 280ms">
        <p class="ville-adresse__ligne">
          <span class="surtitre">{{ 'cabinet.adresse' | t }}</span>
          {{ section.settings.rue }}, {{ section.settings.code_postal }} {{ section.settings.ville }}
          {%- if section.settings.lien_itineraire != blank -%}
            <a class="lien" href="{{ section.settings.lien_itineraire }}" target="_blank" rel="noopener">
              {{ 'cabinet.itineraire' | t }}
            </a>
          {%- endif -%}
        </p>

        {%- if section.settings.telephone != blank -%}
          <p class="ville-adresse__ligne">
            <span class="surtitre">{{ 'cabinet.telephone' | t }}</span>
            <a class="lien nombres-tabulaires" href="tel:{{ section.settings.telephone | remove: ' ' | remove: '.' }}">
              {{ section.settings.telephone }}
            </a>
          </p>
        {%- endif -%}

        {%- if section.settings.horaires != blank -%}
          <p class="ville-adresse__ligne">
            <span class="surtitre">{{ 'cabinet.horaires' | t }}</span>
            <span class="nombres-tabulaires">{{ section.settings.horaires }}</span>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <dl class="protocole-heros__fiche" data-reveal-groupe data-reveal-pas="70">
        {%- for bloc in section.blocks -%}
          <div class="protocole-heros__champ" data-reveal {{ bloc.shopify_attributes }}>
            <dt class="protocole-heros__cle">{{ bloc.settings.cle }}</dt>
            <dd class="protocole-heros__valeur">{{ bloc.settings.valeur }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
  </div>
</section>

{%- comment -%}
  Deux cas, deux déclarations.

  Adresse renseignée : un établissement à part entière, avec son propre
  identifiant, rattaché à la marque. C'est ce qui permet à Google de relier
  cette page à la bonne fiche établissement plutôt qu'à celle du siège.

  Pas d'adresse : un service rendu pour une zone. Aucun lieu n'est inventé.
{%- endcomment -%}
{%- if section.settings.ville != blank -%}
  {%- if section.settings.rue != blank -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": {{ settings.seo_type_etablissement | default: 'HealthAndBeautyBusiness' | json }},
        "@id": {{ shop.url | append: page.url | append: '#etablissement' | json }},
        "name": {{ settings.cabinet_nom | default: shop.name | append: ' ' | append: section.settings.ville | json }},
        "url": {{ shop.url | append: page.url | json }},
        "parentOrganization": { "@id": {{ shop.url | append: '/#etablissement' | json }} },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ section.settings.rue | json }},
          "postalCode": {{ section.settings.code_postal | json }},
          "addressLocality": {{ section.settings.ville | json }},
          "addressCountry": {{ section.settings.code_pays | default: 'MA' | json }}
        }
        {%- if section.settings.telephone != blank -%}
          , "telephone": {{ section.settings.telephone | json }}
        {%- endif -%}
        {%- if section.settings.horaires_donnees != blank -%}
          , "openingHours": {{ section.settings.horaires_donnees | split: '
' | json }}
        {%- endif -%}
        {%- if section.settings.chapo != blank -%}
          , "description": {{ section.settings.chapo | json }}
        {%- endif -%}
      }
    </script>
  {%- else -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": {{ section.settings.titre | default: page.title | json }},
        "serviceType": {{ section.settings.type_service | default: 'Soin esthétique' | json }},
        "provider": { "@id": {{ shop.url | append: '/#etablissement' | json }} },
        "areaServed": {
          "@type": "City",
          "name": {{ section.settings.ville | json }}
          {%- if section.settings.pays != blank -%}
            , "containedInPlace": { "@type": "Country", "name": {{ section.settings.pays | json }} }
          {%- endif -%}
        }
        {%- if section.settings.chapo != blank -%}
          , "description": {{ section.settings.chapo | json }}
        {%- endif -%}
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "En-tête de ville",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "ville", "label": "Ville", "default": "Casablanca" },
    { "type": "text", "id": "pays", "label": "Pays", "default": "Maroc" },
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Casablanca, Maroc" },
    {
      "type": "textarea",
      "id": "titre",
      "label": "Titre (H1)",
      "info": "Doit contenir le soin phare et la ville. Exemple : Hydrafacial et soins esthétiques à Casablanca.",
      "default": "Hydrafacial et soins esthétiques à Casablanca"
    },
    {
      "type": "text",
      "id": "type_service",
      "label": "Type de service (données structurées)",
      "default": "Soin esthétique du visage"
    },
    {
      "type": "text",
      "id": "mention_statut",
      "label": "Statut affiché",
      "info": "Ce que la page annonce sur cette implantation. Laissez vide pour ne rien afficher.",
      "default": "Les sept protocoles sont disponibles sur place, sur rendez-vous."
    },
    {
      "type": "textarea",
      "id": "chapo",
      "label": "Chapô",
      "default": "Le même bilan avant tout soin, les mêmes protocoles, la même exigence de résultat qu'au cabinet parisien. Dites-nous ce que vous cherchez à corriger : vous recevez un plan de soin, pas une grille tarifaire."
    },
    { "type": "image_picker", "id": "image", "label": "Image de fond" },

    { "type": "header", "content": "Adresse du cabinet" },
    {
      "type": "paragraph",
      "content": "Renseignez la rue pour afficher le plan d'accès et publier un établissement local dans les données structurées. Laissée vide, la page décrit seulement un service rendu dans la ville."
    },
    { "type": "text", "id": "rue", "label": "Rue" },
    { "type": "text", "id": "code_postal", "label": "Code postal" },
    {
      "type": "text",
      "id": "code_pays",
      "label": "Code pays",
      "info": "Deux lettres. MA pour le Maroc, FR pour la France.",
      "default": "MA"
    },
    { "type": "text", "id": "telephone", "label": "Téléphone" },
    { "type": "text", "id": "horaires", "label": "Horaires affichés", "default": "Du mardi au samedi" },
    {
      "type": "textarea",
      "id": "horaires_donnees",
      "label": "Horaires pour les moteurs de recherche",
      "info": "Une plage par ligne, au format Tu,We,Th,Fr 10:00-19:00",
      "default": "Tu,We,Th,Fr 10:00-19:00\nSa 10:00-17:00"
    },
    { "type": "url", "id": "lien_itineraire", "label": "Lien d'itinéraire" },
    {
      "type": "text",
      "id": "libelle_principal",
      "label": "Bouton principal",
      "default": "Demander un bilan"
    },
    { "type": "text", "id": "ancre_principale", "label": "Lien du bouton principal", "default": "#contact" },
    {
      "type": "text",
      "id": "libelle_secondaire",
      "label": "Bouton secondaire",
      "default": "Voir les protocoles"
    },
    { "type": "text", "id": "ancre_secondaire", "label": "Lien du bouton secondaire", "default": "#protocoles" }
  ],
  "blocks": [
    {
      "type": "repere",
      "name": "Repère",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "cle", "label": "Intitulé", "default": "Protocoles" },
        { "type": "text", "id": "valeur", "label": "Valeur", "default": "7" }
      ]
    }
  ],
  "presets": [
    {
      "name": "En-tête de ville",
      "blocks": [
        { "type": "repere", "settings": { "cle": "Protocoles pratiqués", "valeur": "7" } },
        { "type": "repere", "settings": { "cle": "Bilan préalable", "valeur": "Systématique" } },
        { "type": "repere", "settings": { "cle": "Réponse", "valeur": "Sous 24 h ouvrées" } }
      ]
    }
  ]
}
{% endschema %}
