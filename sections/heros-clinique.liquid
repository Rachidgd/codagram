{%- comment -%}
  Héros.

  Choix de conception : l'accroche est ancrée en bas à gauche, pas centrée.
  Le média occupe toute la fenêtre et passe sous l'en-tête transparent. Les
  repères chiffrés remplacent la rangée de pastilles de réassurance : ils
  disent quelque chose de vérifiable plutôt que d'orner.
{%- endcomment -%}

<section
  class="heros"
  data-entete-inverse
  style="min-height: {{ section.settings.hauteur }}svh;"
>
  <div class="heros__media">
    {%- if section.settings.video != blank -%}
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        {% if section.settings.image != blank %}
          poster="{{ section.settings.image | image_url: width: 1600 }}"
        {% endif %}
        aria-hidden="true"
      >
        <source src="{{ section.settings.video }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="
          {{ section.settings.image | image_url: width: 750 }} 750w,
          {{ section.settings.image | image_url: width: 1100 }} 1100w,
          {{ section.settings.image | image_url: width: 1600 }} 1600w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w,
          {{ section.settings.image | image_url: width: 2600 }} 2600w
        "
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.titre | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      >
    {%- endif -%}
  </div>

  <div class="heros__contenu">
    <div class="lisiere">
      {%- if section.settings.surtitre != blank -%}
        <p
          class="surtitre heros__surtitre"
          {% if section.settings.index != blank %}
            data-index="{{ section.settings.index }}"
          {% endif %}
          data-reveal
        >
          {{ section.settings.surtitre }}
        </p>
      {%- endif -%}

      {%- if section.settings.titre != blank -%}
        <h1 class="heros__titre mt-5 equilibre" data-reveal style="--reveal-delay: 80ms">
          {{ section.settings.titre }}
        </h1>
      {%- endif -%}

      {%- if section.settings.chapo != blank -%}
        <p class="heros__chapo" data-reveal style="--reveal-delay: 160ms">
          {{ section.settings.chapo }}
        </p>
      {%- endif -%}

      <div class="heros__actions" data-reveal style="--reveal-delay: 240ms">
        {%- render 'bouton', rdv: true, style: 'clair', fleche: true -%}
        {%- if section.settings.lien_secondaire != blank -%}
          {%- render 'bouton',
            libelle: section.settings.libelle_secondaire,
            lien: section.settings.lien_secondaire,
            style: 'fantome'
          -%}
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <dl class="heros__reperes" data-reveal-groupe data-reveal-pas="90">
          {%- for bloc in section.blocks -%}
            <div class="heros__repere" data-reveal {{ bloc.shopify_attributes }}>
              <dt class="heros__repere-valeur">{{ bloc.settings.valeur }}</dt>
              <dd class="heros__repere-libelle">{{ bloc.settings.libelle }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Héros",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image de fond",
      "info": "Format paysage, 2600 px de large minimum. Sert aussi d'affiche si une vidéo est utilisée."
    },
    {
      "type": "url",
      "id": "video",
      "label": "Vidéo de fond (MP4)",
      "info": "Optionnel. Muette et en boucle. Garder un fichier léger : 3 Mo maximum."
    },
    {
      "type": "range",
      "id": "hauteur",
      "label": "Hauteur",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "text",
      "id": "index",
      "label": "Index",
      "default": "01"
    },
    {
      "type": "text",
      "id": "surtitre",
      "label": "Surtitre",
      "default": "Cabinet de soin esthétique — Paris"
    },
    {
      "type": "textarea",
      "id": "titre",
      "label": "Titre (H1)",
      "default": "Une peau se lit avant de se traiter.",
      "info": "Un H1 court convertit mieux et tient sur toutes les tailles d'écran. Viser 4 à 9 mots."
    },
    {
      "type": "textarea",
      "id": "chapo",
      "label": "Chapô",
      "default": "Bilan cutané, protocole construit séance après séance, résultat mesuré. Sept soins, aucune cure imposée."
    },
    {
      "type": "text",
      "id": "libelle_secondaire",
      "label": "Libellé du second bouton",
      "default": "Trouver mon protocole"
    },
    {
      "type": "url",
      "id": "lien_secondaire",
      "label": "Lien du second bouton"
    }
  ],
  "blocks": [
    {
      "type": "repere",
      "name": "Repère chiffré",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "valeur",
          "label": "Valeur",
          "default": "07"
        },
        {
          "type": "text",
          "id": "libelle",
          "label": "Libellé",
          "default": "protocoles, tous conduits en cabinet"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Héros",
      "blocks": [
        {
          "type": "repere",
          "settings": { "valeur": "07", "libelle": "protocoles, tous conduits en cabinet" }
        },
        {
          "type": "repere",
          "settings": { "valeur": "40 min", "libelle": "de bilan avant la première séance" }
        },
        {
          "type": "repere",
          "settings": { "valeur": "0", "libelle": "cure vendue sans indication" }
        }
      ]
    }
  ]
}
{% endschema %}
