<section class="k-section">
  <div class="k-container">
    <div class="k-section-head k-account__head">
      <h1 class="k-h2">{{ 'customer.account.title' | t }}</h1>
      <hr class="k-rule">
    </div>

    <div class="k-account__layout">
      <div class="k-account__main">
        <h2 class="k-h4">{{ 'customer.account.orders' | t }}</h2>
        {%- if customer.orders.size > 0 -%}
          <div class="k-table-wrap">
            <table class="k-table">
              <thead>
                <tr>
                  <th>{{ 'customer.orders.order_number' | t }}</th>
                  <th>{{ 'customer.orders.date' | t }}</th>
                  <th>{{ 'customer.orders.payment_status' | t }}</th>
                  <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
                  <th>{{ 'customer.orders.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a class="k-link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{% render 'date', date: order.created_at %}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- else -%}
          <p class="k-form-note">{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
      </div>

      <aside class="k-account__side k-card k-card--pad">
        <h2 class="k-h4">{{ 'customer.account.details' | t }}</h2>
        <div class="k-text">{{ customer.default_address | format_address }}</div>
        <a class="k-link" href="{{ routes.account_addresses_url }}">{{ 'customer.account.addresses' | t }}</a>
        <a class="k-link" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
      </aside>
    </div>
  </div>
</section>
