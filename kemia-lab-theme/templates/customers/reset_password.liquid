<section class="k-section">
  <div class="k-container k-account">
    <div class="k-card k-card--pad k-account__panel">
      <h1 class="k-h3 k-account__title">{{ 'customer.reset.title' | t }}</h1>
      {% form 'reset_customer_password', class: 'k-account__form' %}
        {{ form.errors | default_errors }}
        <div class="k-field">
          <label class="k-label" for="reset-password">{{ 'customer.reset.password' | t }}</label>
          <input class="k-input" id="reset-password" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div class="k-field">
          <label class="k-label" for="reset-confirm">{{ 'customer.reset.confirm' | t }}</label>
          <input class="k-input" id="reset-confirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>
        <button class="k-btn k-btn--block" type="submit">{{ 'customer.reset.submit' | t }}</button>
      {% endform %}
    </div>
  </div>
</section>
