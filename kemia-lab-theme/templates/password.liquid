<h1 class="k-h2">{{ shop.name }}</h1>
<hr class="k-rule">
<div class="k-text">{{ shop.password_message }}</div>

{% form 'customer', class: 'k-password__form' %}
  <input type="hidden" name="contact[tags]" value="newsletter">
  <label class="k-visually-hidden" for="password-email">Email</label>
  <input class="k-input" id="password-email" type="email" name="contact[email]" placeholder="Votre email" required>
  <button class="k-btn" type="submit">S'inscrire</button>
  {%- if form.posted_successfully? -%}
    <p class="k-form-message k-form-message--success">{{ 'general.newsletter.success' | t }}</p>
  {%- endif -%}
{% endform %}

{% form 'storefront_password', class: 'k-password__form' %}
  {{ form.errors | default_errors }}
  <label class="k-visually-hidden" for="password-code">Mot de passe</label>
  <input class="k-input" id="password-code" type="password" name="password" placeholder="Mot de passe">
  <button class="k-btn k-btn--outline" type="submit">Entrer</button>
{% endform %}
