{%- case node.type -%}
  {%- when 'text' -%}
    {%- if node.bold -%}<strong>{%- endif -%}
    {%- if node.italic -%}<em>{%- endif -%}
    {{- node.value | escape | newline_to_br -}}
    {%- if node.italic -%}</em>{%- endif -%}
    {%- if node.bold -%}</strong>{%- endif -%}

  {%- when 'link' -%}
    <a href="{{ node.url | escape }}"{% if node.title != blank %} title="{{ node.title | escape }}"{% endif %}{% if node.target == '_blank' %} target="_blank" rel="noopener"{% endif %}>
      {%- for child in node.children -%}
        {%- if child.bold -%}<strong>{%- endif -%}
        {%- if child.italic -%}<em>{%- endif -%}
        {{- child.value | escape -}}
        {%- if child.italic -%}</em>{%- endif -%}
        {%- if child.bold -%}</strong>{%- endif -%}
      {%- endfor -%}
    </a>
{%- endcase -%}
