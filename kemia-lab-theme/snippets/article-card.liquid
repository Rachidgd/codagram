{%- liquid
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200
  if minutes < 1
    assign minutes = 1
  endif
  assign category = article.tags.first
  assign filter_tags = article.tags | join: '|'
-%}
<article class="k-article-card"{% if use_filter %} data-k-filter-item="{{ filter_tags | escape }}"{% endif %}>
  <a class="k-article-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
    {% render 'image', image: article.image, ratio: '62%', sizes: '(min-width: 990px) 33vw, 90vw', placeholder_icon: 'image' %}
    {%- if category != blank -%}
      <span class="k-article-card__tag">{{ category }}</span>
    {%- endif -%}
  </a>
  <div class="k-article-card__body">
    <h3 class="k-article-card__title">
      <a href="{{ article.url }}">{{ article.title }}</a>
    </h3>
    {%- if show_excerpt and article.excerpt_or_content != blank -%}
      <p class="k-article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
    {%- endif -%}
    <p class="k-article-card__meta">
      <span>{{ article.published_at | date: '%-d %B %Y' }}</span>
      <span class="k-article-card__dot" aria-hidden="true">•</span>
      <span>{{ 'blogs.reading_time' | t: count: minutes }}</span>
    </p>
  </div>
</article>
