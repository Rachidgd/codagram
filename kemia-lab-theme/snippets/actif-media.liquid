{%- liquid
  assign custom = ''
  case position
    when 1
      assign custom = settings.image_1
    when 2
      assign custom = settings.image_2
    when 3
      assign custom = settings.image_3
    when 4
      assign custom = settings.image_4
    when 5
      assign custom = settings.image_5
    when 6
      assign custom = settings.image_6
    when 7
      assign custom = settings.image_7
    when 8
      assign custom = settings.image_8
  endcase

  assign source = fallback
  if custom != blank
    assign source = custom
  endif
-%}
{% render 'image', image: source, ratio: '100%', fit: 'contain', class: 'k-media--plain', sizes: '96px', placeholder_icon: 'leaf' %}
