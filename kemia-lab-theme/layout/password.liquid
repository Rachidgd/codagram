<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ shop.name }}</title>
    <style>
      {{ settings.font_body | font_face: font_display: 'swap' }}
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ settings.font_display | font_face: font_display: 'swap' }}

      :root {
        --k-font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --k-font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --k-font-display: {{ settings.font_display.family }}, {{ settings.font_display.fallback_families }};
        --k-bg: {{ settings.color_bg }};
        --k-bg-soft: {{ settings.color_bg_soft }};
        --k-bg-beige: {{ settings.color_bg_beige }};
        --k-surface: {{ settings.color_surface }};
        --k-ink: {{ settings.color_ink }};
        --k-body: {{ settings.color_body }};
        --k-gold: {{ settings.color_gold }};
        --k-gold-dark: {{ settings.color_gold_dark }};
        --k-gold-soft: {{ settings.color_gold_soft }};
        --k-navy: {{ settings.color_navy }};
        --k-blue: {{ settings.color_blue }};
        --k-blue-tint: {{ settings.color_blue_tint }};
        --k-border: {{ settings.color_border }};
        --k-border-soft: {{ settings.color_border_soft }};
        --k-layout-width: {{ settings.layout_width }}px;
        --k-radius-card: {{ settings.radius_card }}px;
        --k-radius-btn: {{ settings.radius_button }}px;
        --k-h-scale: 1;
        --k-fs-body: {{ settings.font_body_size }}px;
        --k-fs-h1: clamp(1.875rem, 1.05rem + 3.4vw, 3.25rem);
        --k-fs-h2: clamp(1.5rem, 1.05rem + 1.85vw, 2.25rem);
        --k-fs-h3: clamp(1.1875rem, 1rem + 0.85vw, 1.5rem);
        --k-fs-h4: clamp(1.0625rem, 0.98rem + 0.35vw, 1.1875rem);
        --k-fs-eyebrow: 12px;
        --k-gutter: clamp(20px, 4vw, 40px);
        --k-space-3: 12px;
        --k-space-5: 24px;
        --k-space-6: 32px;
        --k-space-8: 48px;
        --k-space-section: clamp(44px, 5.5vw, 84px);
      }
    </style>
    {{ 'kemia.css' | asset_url | stylesheet_tag }}
    {{ 'kemia-sections.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main class="k-section">
      <div class="k-container k-container--narrow">
        <div class="k-section-head">
          <span class="k-header__logo">{% render 'logo' %}</span>
          {{ content_for_layout }}
        </div>
      </div>
    </main>
  </body>
</html>
