<div
  class="k-announcement k-announcement--rotate-{{ section.settings.rotate }}"
  style="background: {{ section.settings.background }}; color: {{ section.settings.text_color }}"
>
  <div class="k-container">
    <ul
      class="k-announcement__list"
      data-k-announce="{{ section.settings.rotate }}"
      data-interval="{{ section.settings.interval | times: 1000 }}"
    >
      {%- for block in section.blocks -%}
        <li class="k-announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            {% render 'icon', name: block.settings.icon, class: 'k-icon--sm' %}
          {%- endif -%}
          {%- capture item_text -%}
            <span class="k-announcement__text">{{ block.settings.text }}</span>
            {%- if block.settings.note != blank -%}
              <span class="k-announcement__note">{{ block.settings.note }}</span>
            {%- endif -%}
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ item_text }}</a>
          {%- else -%}
            <span>{{ item_text }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Barre d'annonce",
  "class": "k-announcement-section",
  "settings": [
    {
      "type": "select",
      "id": "rotate",
      "label": "Affichage",
      "options": [
        { "value": "mobile", "label": "Une info à la fois sur mobile" },
        { "value": "always", "label": "Une info à la fois partout" },
        { "value": "never", "label": "Toutes les infos côte à côte" }
      ],
      "default": "mobile",
      "info": "Sur mobile, afficher les trois mentions côte à côte tronque les textes."
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Durée d'affichage",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fond",
      "default": "#F8F1E9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte",
      "default": "#5C534A"
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "item",
      "name": "Mention",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Pictogramme",
          "options": [
            { "value": "none", "label": "Aucun" },
            { "value": "truck", "label": "Livraison" },
            { "value": "shield-check", "label": "Bouclier" },
            { "value": "lock", "label": "Cadenas" },
            { "value": "clock", "label": "Horloge" },
            { "value": "leaf", "label": "Feuille" },
            { "value": "headset", "label": "Service client" },
            { "value": "package", "label": "Colis" },
            { "value": "hexagon", "label": "Hexagone" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Livraison offerte dès 60€ d'achat"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Seconde ligne",
          "info": "Affichée sous le texte, en doré. Laisser vide pour une seule ligne."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre d'annonce",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "text": "Livraison offerte dès 60€ d'achat" } },
        { "type": "item", "settings": { "icon": "shield-check", "text": "Qualité contrôlée" } },
        { "type": "item", "settings": { "icon": "lock", "text": "Paiement sécurisé" } }
      ]
    }
  ]
}
{% endschema %}
