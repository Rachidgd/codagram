{%- liquid
  assign label_first = section.settings.label_first_name
  if label_first == blank
    assign label_first = 'contact.first_name' | t
  endif

  assign label_last = section.settings.label_last_name
  if label_last == blank
    assign label_last = 'contact.name' | t
  endif

  assign label_email = section.settings.label_email
  if label_email == blank
    assign label_email = 'contact.email' | t
  endif

  assign label_subject = section.settings.label_subject
  if label_subject == blank
    assign label_subject = 'contact.subject' | t
  endif

  assign label_message = section.settings.label_message
  if label_message == blank
    assign label_message = 'contact.message' | t
  endif
-%}
<section class="k-section">
  <div class="k-container">
    <div class="k-contact">
      <div class="k-contact__form k-card k-card--pad">
        {%- if section.settings.form_heading != blank -%}
          <h2 class="k-title-caps k-h4 k-contact__heading">{{ section.settings.form_heading }}</h2>
        {%- endif -%}

        {% form 'contact', class: 'k-contact__fields' %}
          {%- if form.posted_successfully? -%}
            <p class="k-form-message k-form-message--success">{{ 'contact.success' | t }}</p>
          {%- elsif form.errors -%}
            <p class="k-form-message k-form-message--error">{{ 'contact.error' | t }}</p>
          {%- endif -%}

          <div class="k-contact__row">
            <div class="k-field">
              <label class="k-label" for="contact-first-{{ section.id }}">
                {{ label_first }}
              </label>
              <input
                class="k-input"
                id="contact-first-{{ section.id }}"
                type="text"
                name="contact[first_name]"
                autocomplete="given-name"
                required
              >
            </div>
            <div class="k-field">
              <label class="k-label" for="contact-last-{{ section.id }}">
                {{ label_last }}
              </label>
              <input
                class="k-input"
                id="contact-last-{{ section.id }}"
                type="text"
                name="contact[last_name]"
                autocomplete="family-name"
                required
              >
            </div>
          </div>

          <div class="k-field">
            <label class="k-label" for="contact-email-{{ section.id }}">
              {{ label_email }}
            </label>
            <input
              class="k-input"
              id="contact-email-{{ section.id }}"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
            >
          </div>

          {%- if section.blocks.size > 0 -%}
            <div class="k-field">
              <label class="k-label" for="contact-subject-{{ section.id }}">
                {{ label_subject }}
              </label>
              <select class="k-select" id="contact-subject-{{ section.id }}" name="contact[Sujet]" required>
                <option value="">{{ section.settings.subject_placeholder }}</option>
                {%- for block in section.blocks -%}
                  <option value="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}

          {%- if section.settings.show_order_number -%}
            <div class="k-field">
              <label class="k-label" for="contact-order-{{ section.id }}">
                {{ section.settings.label_order_number }}
                {% if section.settings.optional_hint != blank %}
                  <span class="k-label__hint">{{ section.settings.optional_hint }}</span>
                {% endif %}
              </label>
              <input
                class="k-input"
                id="contact-order-{{ section.id }}"
                type="text"
                name="contact[Numéro de commande]"
                placeholder="{{ section.settings.order_number_placeholder | escape }}"
                autocomplete="off"
              >
            </div>
          {%- endif -%}

          <div class="k-field">
            <label class="k-label" for="contact-body-{{ section.id }}">
              {{ label_message }}
            </label>
            <textarea
              class="k-textarea"
              id="contact-body-{{ section.id }}"
              name="contact[body]"
              placeholder="{{ section.settings.message_placeholder | escape }}"
              required
            ></textarea>
          </div>

          {%- if section.settings.legal_note != blank -%}
            <p class="k-contact__legal">{{ section.settings.legal_note }}</p>
          {%- endif -%}

          <button class="k-btn k-btn--block" type="submit">{{ section.settings.button_label }}</button>
        {% endform %}
      </div>

      <aside class="k-contact__aside k-card k-card--pad">
        {%- if section.settings.aside_heading != blank -%}
          <h2 class="k-title-caps k-h4 k-contact__heading">{{ section.settings.aside_heading }}</h2>
        {%- endif -%}

        <ul class="k-contact__list">
          {%- if section.settings.email != blank -%}
            <li class="k-contact__item">
              <span class="k-contact__icon">{% render 'icon', name: 'mail', class: 'k-icon--sm' %}</span>
              <div>
                <span class="k-contact__label">{{ section.settings.email_label }}</span>
                <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
              </div>
            </li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li class="k-contact__item">
              <span class="k-contact__icon">{% render 'icon', name: 'phone', class: 'k-icon--sm' %}</span>
              <div>
                <span class="k-contact__label">{{ section.settings.phone_label }}</span>
                <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
              </div>
            </li>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <li class="k-contact__item">
              <span class="k-contact__icon">{% render 'icon', name: 'clock', class: 'k-icon--sm' %}</span>
              <div>
                <span class="k-contact__label">{{ section.settings.hours_label }}</span>
                <p class="k-contact__hours">{{ section.settings.hours }}</p>
              </div>
            </li>
          {%- endif -%}
          {%- if section.settings.social_label != blank -%}
            <li class="k-contact__item">
              <span class="k-contact__icon">{% render 'icon', name: 'sparkle', class: 'k-icon--sm' %}</span>
              <div>
                <span class="k-contact__label">{{ section.settings.social_label }}</span>
                {%- if section.settings.social_text != blank -%}
                  <p class="k-contact__hours">{{ section.settings.social_text }}</p>
                {%- endif -%}
                <ul class="k-footer__social k-contact__social">
                  {%- if settings.social_instagram != blank -%}
                    <li><a href="{{ settings.social_instagram }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram', class: 'k-icon--sm' %}</a></li>
                  {%- endif -%}
                  {%- if settings.social_tiktok != blank -%}
                    <li><a href="{{ settings.social_tiktok }}" aria-label="TikTok" rel="noopener" target="_blank">{% render 'icon', name: 'tiktok', class: 'k-icon--sm' %}</a></li>
                  {%- endif -%}
                  {%- if settings.social_facebook != blank -%}
                    <li><a href="{{ settings.social_facebook }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', name: 'facebook', class: 'k-icon--sm' %}</a></li>
                  {%- endif -%}
                  {%- if settings.social_youtube != blank -%}
                    <li><a href="{{ settings.social_youtube }}" aria-label="YouTube" rel="noopener" target="_blank">{% render 'icon', name: 'youtube', class: 'k-icon--sm' %}</a></li>
                  {%- endif -%}
                </ul>
              </div>
            </li>
          {%- endif -%}
        </ul>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formulaire de contact",
  "class": "k-contact-section",
  "settings": [
    { "type": "text", "id": "form_heading", "label": "Titre du formulaire", "default": "Envoyez-nous un message" },
    { "type": "header", "content": "Libellés des champs" },
    { "type": "text", "id": "label_first_name", "label": "Prénom", "default": "Prénom" },
    { "type": "text", "id": "label_last_name", "label": "Nom", "default": "Nom" },
    { "type": "text", "id": "label_email", "label": "Adresse e-mail", "default": "Adresse e-mail" },
    { "type": "text", "id": "label_subject", "label": "Sujet", "default": "Sujet" },
    { "type": "text", "id": "subject_placeholder", "label": "Choix par défaut du sujet", "default": "Choisissez un sujet" },
    { "type": "checkbox", "id": "show_order_number", "label": "Champ numéro de commande", "default": true },
    { "type": "text", "id": "label_order_number", "label": "Numéro de commande", "default": "Numéro de commande" },
    { "type": "text", "id": "optional_hint", "label": "Mention facultative", "default": "(facultatif)" },
    { "type": "text", "id": "order_number_placeholder", "label": "Aide du numéro de commande", "default": "Par exemple : #1042" },
    { "type": "text", "id": "label_message", "label": "Message", "default": "Votre message" },
    { "type": "text", "id": "message_placeholder", "label": "Aide du champ message", "default": "Décrivez votre demande..." },
    { "type": "textarea", "id": "legal_note", "label": "Mention sous le formulaire" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Envoyer le message" },
    { "type": "header", "content": "Autres moyens de contact" },
    { "type": "text", "id": "aside_heading", "label": "Titre", "default": "Autres moyens de contact" },
    { "type": "text", "id": "email_label", "label": "Libellé email", "default": "Email" },
    { "type": "text", "id": "email", "label": "Adresse email" },
    { "type": "text", "id": "phone_label", "label": "Libellé téléphone", "default": "Téléphone" },
    { "type": "text", "id": "phone", "label": "Numéro de téléphone" },
    { "type": "text", "id": "hours_label", "label": "Libellé horaires", "default": "Horaires" },
    { "type": "text", "id": "hours", "label": "Horaires", "default": "Du lundi au vendredi, de 10h à 18h, hors jours fériés" },
    { "type": "text", "id": "social_label", "label": "Libellé réseaux sociaux", "default": "Réseaux sociaux" },
    { "type": "text", "id": "social_text", "label": "Texte réseaux sociaux", "default": "Rejoignez-nous sur nos réseaux pour suivre nos actualités." }
  ],
  "blocks": [
    {
      "type": "subject",
      "name": "Sujet",
      "settings": [{ "type": "text", "id": "label", "label": "Libellé", "default": "Question sur un produit" }]
    }
  ],
  "presets": [
    {
      "name": "Formulaire de contact",
      "blocks": [
        { "type": "subject", "settings": { "label": "Question sur un produit" } },
        { "type": "subject", "settings": { "label": "Suivi de commande" } },
        { "type": "subject", "settings": { "label": "Livraison et retours" } },
        { "type": "subject", "settings": { "label": "Autre demande" } }
      ]
    }
  ]
}
{% endschema %}
