{%- liquid
  assign label_first = section.settings.label_first_name
  if label_first == blank
    assign label_first = 'contact.first_name' | t
  endif

  assign label_last = section.settings.label_last_name
  if label_last == blank
    assign label_last = 'contact.name' | t
  endif

  assign label_email = section.settings.label_email
  if label_email == blank
    assign label_email = 'contact.email' | t
  endif

  assign label_subject = section.settings.label_subject
  if label_subject == blank
    assign label_subject = 'contact.subject' | t
  endif

  assign label_message = section.settings.label_message
  if label_message == blank
    assign label_message = 'contact.message' | t
  endif

  assign channels = 0
  assign subjects = 0
  for block in section.blocks
    if block.type == 'channel'
      unless block.settings.title == blank and block.settings.text == blank
        assign channels = channels | plus: 1
      endunless
    endif
    if block.type == 'subject'
      assign subjects = subjects | plus: 1
    endif
  endfor

  assign show_team = false
  if section.settings.team_heading != blank or section.settings.team_text != blank
    assign show_team = true
  endif
-%}

<section class="k-section">
  <div class="k-container">
    <div class="k-contact{% if show_team %} k-contact--with-team{% endif %}">
      {%- if channels > 0 -%}
        <aside class="k-contact__channels k-card">
          <ul class="k-contact__list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'channel' -%}
                {%- unless block.settings.title == blank and block.settings.text == blank -%}
                  <li
                    class="k-contact__item{% if block.settings.highlight %} k-contact__item--highlight{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.icon != 'none' -%}
                      <span class="k-contact__icon k-icon-circle">
                        {% render 'icon', name: block.settings.icon, class: 'k-icon--lg' %}
                      </span>
                    {%- endif -%}
                    <div class="k-contact__body">
                      {%- if block.settings.title != blank -%}
                        <span class="k-contact__label">
                          {{ block.settings.title }}
                          {%- if block.settings.badge != blank -%}
                            <span class="k-contact__badge">{{ block.settings.badge }}</span>
                          {%- endif -%}
                        </span>
                      {%- endif -%}
                      {%- if block.settings.text != blank -%}
                        {%- if block.settings.link_type == 'mail' -%}
                          <a class="k-contact__value" href="mailto:{{ block.settings.text | strip }}">{{ block.settings.text }}</a>
                        {%- elsif block.settings.link_type == 'phone' -%}
                          <a class="k-contact__value" href="tel:{{ block.settings.text | remove: ' ' }}">{{ block.settings.text }}</a>
                        {%- else -%}
                          <p class="k-contact__value">{{ block.settings.text | newline_to_br }}</p>
                        {%- endif -%}
                      {%- endif -%}
                      {%- if block.settings.note != blank -%}
                        <p class="k-contact__note">{{ block.settings.note }}</p>
                      {%- endif -%}
                    </div>
                    {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                      {%- liquid
                        assign cta_href = block.settings.button_link | strip
                        assign cta_externe = true
                        if cta_href == '#'
                          assign cta_externe = false
                        endif
                      -%}
                      <a
                        class="k-btn k-btn--navy k-contact__cta"
                        href="{{ cta_href | escape }}"
                        {%- if cta_externe %} target="_blank" rel="noopener"{% endif %}
                      >
                        {{ block.settings.button_label }}
                        {% render 'icon', name: 'external-link', class: 'k-icon--sm' %}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </aside>
      {%- endif -%}

      <div class="k-contact__form k-card k-card--pad">
        {%- if section.settings.form_heading != blank -%}
          <h2 class="k-title-caps k-h4 k-contact__heading">
            {{ section.settings.form_heading }}
            <hr class="k-rule">
          </h2>
        {%- endif -%}

        {% form 'contact', class: 'k-contact__fields' %}
          {%- if form.posted_successfully? -%}
            <p class="k-form-message k-form-message--success">{{ 'contact.success' | t }}</p>
          {%- elsif form.errors -%}
            <p class="k-form-message k-form-message--error">{{ 'contact.error' | t }}</p>
          {%- endif -%}

          <div class="k-contact__row">
            <div class="k-field">
              <label class="k-label" for="contact-first-{{ section.id }}">
                {{ label_first }}<span class="k-label__req" aria-hidden="true">*</span>
              </label>
              <input
                class="k-input"
                id="contact-first-{{ section.id }}"
                type="text"
                name="contact[first_name]"
                placeholder="{{ section.settings.first_name_placeholder | escape }}"
                autocomplete="given-name"
                required
              >
            </div>
            <div class="k-field">
              <label class="k-label" for="contact-last-{{ section.id }}">
                {{ label_last }}<span class="k-label__req" aria-hidden="true">*</span>
              </label>
              <input
                class="k-input"
                id="contact-last-{{ section.id }}"
                type="text"
                name="contact[last_name]"
                placeholder="{{ section.settings.last_name_placeholder | escape }}"
                autocomplete="family-name"
                required
              >
            </div>
          </div>

          <div class="k-contact__row">
            <div class="k-field">
              <label class="k-label" for="contact-email-{{ section.id }}">
                {{ label_email }}<span class="k-label__req" aria-hidden="true">*</span>
              </label>
              <input
                class="k-input"
                id="contact-email-{{ section.id }}"
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.email_placeholder | escape }}"
                autocomplete="email"
                required
              >
            </div>

            {%- if subjects > 0 -%}
              <div class="k-field">
                <label class="k-label" for="contact-subject-{{ section.id }}">
                  {{ label_subject }}<span class="k-label__req" aria-hidden="true">*</span>
                </label>
                <select class="k-select" id="contact-subject-{{ section.id }}" name="contact[Sujet]" required>
                  <option value="">{{ section.settings.subject_placeholder }}</option>
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'subject' -%}
                      <option value="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
          </div>

          {%- if section.settings.show_order_number -%}
            <div class="k-field">
              <label class="k-label" for="contact-order-{{ section.id }}">
                {{ section.settings.label_order_number }}
                {% if section.settings.optional_hint != blank %}
                  <span class="k-label__hint">{{ section.settings.optional_hint }}</span>
                {% endif %}
              </label>
              <input
                class="k-input"
                id="contact-order-{{ section.id }}"
                type="text"
                name="contact[Numéro de commande]"
                placeholder="{{ section.settings.order_number_placeholder | escape }}"
                autocomplete="off"
              >
            </div>
          {%- endif -%}

          <div class="k-field">
            <label class="k-label" for="contact-body-{{ section.id }}">
              {{ label_message }}<span class="k-label__req" aria-hidden="true">*</span>
            </label>
            <textarea
              class="k-textarea"
              id="contact-body-{{ section.id }}"
              name="contact[body]"
              placeholder="{{ section.settings.message_placeholder | escape }}"
              required
            ></textarea>
          </div>

          <button class="k-btn k-btn--navy k-btn--block" type="submit">
            {{ section.settings.button_label }}
            {% render 'icon', name: 'arrow-right', class: 'k-icon--sm' %}
          </button>
        {% endform %}

        {%- if section.settings.legal_note != blank -%}
          <p class="k-contact__legal">
            {%- if section.settings.legal_icon != 'none' -%}
              {% render 'icon', name: section.settings.legal_icon, class: 'k-icon--xs' %}
            {%- endif -%}
            <span>{{ section.settings.legal_note }}</span>
          </p>
        {%- endif -%}
      </div>

      {%- if show_team -%}
        <aside class="k-contact__team">
          {%- if section.settings.team_icon != 'none' -%}
            <span class="k-contact__team-icon k-icon-circle">
              {% render 'icon', name: section.settings.team_icon, class: 'k-icon--xl' %}
            </span>
          {%- endif -%}
          {%- if section.settings.team_heading != blank -%}
            <h2 class="k-title-caps k-h4 k-contact__team-heading">{{ section.settings.team_heading | newline_to_br }}</h2>
          {%- endif -%}
          {%- if section.settings.team_text != blank -%}
            <p class="k-contact__team-text">{{ section.settings.team_text | newline_to_br }}</p>
          {%- endif -%}
          {%- if section.settings.social_label != blank -%}
            <hr class="k-rule k-contact__team-rule">
            <p class="k-contact__team-social-label">{{ section.settings.social_label }}</p>
          {%- endif -%}
          {% render 'social-links', class: 'k-footer__social k-contact__social' %}
        </aside>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formulaire de contact",
  "class": "k-contact-section",
  "settings": [
    { "type": "header", "content": "Formulaire" },
    { "type": "text", "id": "form_heading", "label": "Titre du formulaire", "default": "Envoyez-nous un message" },
    { "type": "text", "id": "label_first_name", "label": "Prénom", "default": "Prénom" },
    { "type": "text", "id": "first_name_placeholder", "label": "Aide du prénom", "default": "Votre prénom" },
    { "type": "text", "id": "label_last_name", "label": "Nom", "default": "Nom" },
    { "type": "text", "id": "last_name_placeholder", "label": "Aide du nom", "default": "Votre nom" },
    { "type": "text", "id": "label_email", "label": "Adresse e-mail", "default": "Email" },
    { "type": "text", "id": "email_placeholder", "label": "Aide de l'e-mail", "default": "Votre email" },
    { "type": "text", "id": "label_subject", "label": "Sujet", "default": "Sujet" },
    { "type": "text", "id": "subject_placeholder", "label": "Choix par défaut du sujet", "default": "Sélectionnez un sujet" },
    { "type": "checkbox", "id": "show_order_number", "label": "Champ numéro de commande", "default": true },
    { "type": "text", "id": "label_order_number", "label": "Numéro de commande", "default": "N° de commande" },
    { "type": "text", "id": "optional_hint", "label": "Mention facultative", "default": "(facultatif)" },
    { "type": "text", "id": "order_number_placeholder", "label": "Aide du numéro de commande", "default": "Ex : #12345" },
    { "type": "text", "id": "label_message", "label": "Message", "default": "Votre message" },
    { "type": "text", "id": "message_placeholder", "label": "Aide du champ message", "default": "Décrivez votre demande en détail..." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Envoyer ma demande" },
    { "type": "text", "id": "legal_note", "label": "Mention sous le bouton", "default": "Vos informations sont sécurisées et confidentielles." },
    {
      "type": "select",
      "id": "legal_icon",
      "label": "Pictogramme de la mention",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "lock", "label": "Cadenas" },
        { "value": "shield-check", "label": "Bouclier" }
      ],
      "default": "lock"
    },
    { "type": "header", "content": "Panneau de droite" },
    {
      "type": "paragraph",
      "content": "Laissez le titre et le texte vides pour retirer ce panneau. Les réseaux sociaux se règlent dans les paramètres du thème."
    },
    {
      "type": "select",
      "id": "team_icon",
      "label": "Pictogramme",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "headset", "label": "Casque" },
        { "value": "mail", "label": "Enveloppe" },
        { "value": "user", "label": "Personne" },
        { "value": "sparkle", "label": "Étincelle" }
      ],
      "default": "headset"
    },
    { "type": "textarea", "id": "team_heading", "label": "Titre", "default": "Une équipe\nà votre écoute" },
    { "type": "textarea", "id": "team_text", "label": "Texte", "default": "Nous faisons notre maximum pour répondre à vos demandes dans les meilleurs délais." },
    { "type": "text", "id": "social_label", "label": "Titre des réseaux sociaux", "default": "Suivez-nous" }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "channel",
      "name": "Moyen de contact",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Pictogramme",
          "options": [
            { "value": "none", "label": "Aucun" },
            { "value": "mail", "label": "Enveloppe" },
            { "value": "phone", "label": "Téléphone" },
            { "value": "clock", "label": "Horloge" },
            { "value": "quote", "label": "Bulle" },
            { "value": "headset", "label": "Casque" },
            { "value": "package", "label": "Colis" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "sparkle", "label": "Étincelle" }
          ],
          "default": "mail"
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Par email" },
        { "type": "text", "id": "badge", "label": "Pastille à côté du titre", "info": "Par exemple : Nouveau. Laisser vide pour ne rien afficher." },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "hello@kemialab.com" },
        {
          "type": "select",
          "id": "link_type",
          "label": "Rendre le texte cliquable",
          "options": [
            { "value": "none", "label": "Non" },
            { "value": "mail", "label": "Adresse e-mail" },
            { "value": "phone", "label": "Numéro de téléphone" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "note", "label": "Précision dorée" },
        { "type": "checkbox", "id": "highlight", "label": "Mettre en avant sur fond beige", "default": false },
        { "type": "text", "id": "button_label", "label": "Bouton" },
        {
          "type": "text",
          "id": "button_link",
          "label": "Lien du bouton",
          "info": "Par exemple https://wa.me/33600000000. Mettre # tant que le lien n'est pas connu."
        }
      ]
    },
    {
      "type": "subject",
      "name": "Sujet",
      "settings": [{ "type": "text", "id": "label", "label": "Libellé", "default": "Question sur un produit" }]
    }
  ],
  "presets": [
    {
      "name": "Formulaire de contact",
      "blocks": [
        { "type": "channel", "settings": { "icon": "mail", "title": "Par email", "text": "hello@kemialab.com", "link_type": "mail", "note": "Réponse rapide en semaine" } },
        { "type": "channel", "settings": { "icon": "quote", "title": "Formulaire de contact", "text": "Envoyez-nous votre demande via le formulaire ci-contre.", "link_type": "none", "note": "" } },
        { "type": "channel", "settings": { "icon": "clock", "title": "Horaires de réponse", "text": "Du lundi au vendredi", "link_type": "none", "note": "10h - 18h (hors jours fériés)" } },
        { "type": "subject", "settings": { "label": "Question sur un produit" } },
        { "type": "subject", "settings": { "label": "Suivi de commande" } },
        { "type": "subject", "settings": { "label": "Livraison et retours" } },
        { "type": "subject", "settings": { "label": "Autre demande" } }
      ]
    }
  ]
}
{% endschema %}
