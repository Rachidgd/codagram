<header
  class="k-header{% if section.settings.sticky %} k-header--sticky{% endif %}"
  data-k-header
  style="
    background: {{ section.settings.background }};
    --k-header-logo-width: {{ section.settings.logo_width }}px;
    --k-header-logo-scale: {{ section.settings.logo_scale | divided_by: 100.0 }};
    --k-header-drawer-logo-width: {{ section.settings.drawer_logo_width }}px;
  "
>
  <div class="k-container k-header__inner">
    <a class="k-header__logo" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name | default: shop.name | escape }}">
      {% render 'logo',
        logo_width: section.settings.logo_width,
        logo_height: 72,
        background: section.settings.background
      %}
    </a>

    <nav class="k-header__nav" aria-label="Navigation principale">
      <ul class="k-header__menu">
        {%- for link in section.settings.menu.links -%}
          <li class="k-header__item{% if link.links.size > 0 %} k-header__item--has-children{% endif %}">
            <a
              class="k-header__link{% if link.active or link.child_active %} is-active{% endif %}"
              href="{{ link.url }}"
              {% if link.active %}aria-current="page"{% endif %}
            >
              {{ link.title }}
              {%- if link.links.size > 0 -%}
                {% render 'icon', name: 'chevron-down', class: 'k-icon--xs' %}
              {%- endif -%}
            </a>

            {%- if link.links.size > 0 -%}
              <ul class="k-header__submenu">
                {%- for child in link.links -%}
                  <li>
                    <a class="k-header__sublink{% if child.active %} is-active{% endif %}" href="{{ child.url }}">
                      {{ child.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="k-header__actions">
      {%- if section.settings.show_search -%}
        <a class="k-header__action" href="{{ routes.search_url }}" aria-label="{{ 'accessibility.search' | t }}">
          {% render 'icon', name: 'search' %}
        </a>
      {%- endif -%}

      <a class="k-header__action" href="{{ routes.account_url }}" aria-label="{{ 'accessibility.account' | t }}">
        {% render 'icon', name: 'user' %}
      </a>

      <a
        class="k-header__action k-header__cart"
        href="{{ routes.cart_url }}"
        {% if settings.cart_drawer %}data-k-open="k-cart-drawer"{% endif %}
        aria-label="{{ 'accessibility.open_cart' | t }}"
      >
        {% render 'icon', name: 'bag' %}
        <span class="k-header__cart-count" data-k-cart-count>{{ cart.item_count }}</span>
      </a>

      <button class="k-header__action k-header__burger" type="button" data-k-open="k-menu-drawer" aria-label="{{ 'accessibility.open_menu' | t }}">
        {% render 'icon', name: 'menu' %}
      </button>
    </div>
  </div>
</header>

<div class="k-drawer k-drawer--menu" id="k-menu-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Navigation">
  <div class="k-drawer__overlay" data-k-close></div>

  <div class="k-drawer__panel">
    <div class="k-drawer__head">
      <span class="k-header__logo k-header__logo--drawer">
        {% render 'logo',
          logo_width: section.settings.drawer_logo_width,
          logo_height: 58,
          background: section.settings.background
        %}
      </span>

      <button class="k-modal__close" type="button" data-k-close aria-label="{{ 'accessibility.close_menu' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    <div class="k-drawer__body">
      <ul class="k-menu-list">
        {%- for link in section.settings.menu.links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <details class="k-menu-list__group">
                <summary class="k-menu-list__link">
                  {{ link.title }}
                  <span class="k-accordion__icon" aria-hidden="true"></span>
                </summary>

                <ul class="k-menu-list__children">
                  {%- for child in link.links -%}
                    <li>
                      <a class="k-menu-list__child" href="{{ child.url }}">{{ child.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a class="k-menu-list__link{% if link.active %} is-active{% endif %}" href="{{ link.url }}">
                {{ link.title }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- if section.settings.drawer_cta_label != blank -%}
      <div class="k-drawer__foot">
        <a class="k-btn k-btn--block" href="{{ section.settings.drawer_cta_link }}">
          {{ section.settings.drawer_cta_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .k-header__logo {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    flex: 0 0 auto;
    width: var(--k-header-logo-width);
    line-height: 0;
    transform: scale(var(--k-header-logo-scale, 1.18));
    transform-origin: left center;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .k-header__logo img,
  #shopify-section-{{ section.id }} .k-header__logo svg {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 58px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .k-header__logo--drawer {
    width: var(--k-header-drawer-logo-width);
    transform: none;
  }

  #shopify-section-{{ section.id }} .k-header__logo--drawer img,
  #shopify-section-{{ section.id }} .k-header__logo--drawer svg {
    max-height: 58px;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .k-header__logo {
      width: min(var(--k-header-logo-width), 172px);
      transform: scale(1.08);
    }

    #shopify-section-{{ section.id }} .k-header__logo img,
    #shopify-section-{{ section.id }} .k-header__logo svg {
      max-height: 48px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .k-header__logo {
      width: min(var(--k-header-logo-width), 148px);
      transform: scale(1.06);
    }

    #shopify-section-{{ section.id }} .k-header__logo img,
    #shopify-section-{{ section.id }} .k-header__logo svg {
      max-height: 44px;
    }
  }
</style>

{% schema %}
{
  "name": "En-tête",
  "class": "k-header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Modifiable dans Boutique en ligne, Navigation."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fond",
      "default": "#FEFDFC"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Largeur du logo",
      "min": 130,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "logo_scale",
      "label": "Grossissement visuel du logo",
      "min": 100,
      "max": 135,
      "step": 5,
      "unit": "%",
      "default": 115,
      "info": "Agrandit le logo visuellement sans augmenter la hauteur du header."
    },
    {
      "type": "range",
      "id": "drawer_logo_width",
      "label": "Largeur du logo dans le menu mobile",
      "min": 130,
      "max": 230,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "En-tête fixe au défilement",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Afficher la recherche",
      "default": false
    },
    {
      "type": "header",
      "content": "Menu mobile"
    },
    {
      "type": "text",
      "id": "drawer_cta_label",
      "label": "Bouton bas de menu",
      "default": "Découvrir 4 Vitality System"
    },
    {
      "type": "url",
      "id": "drawer_cta_link",
      "label": "Lien du bouton"
    }
  ]
}
{% endschema %}