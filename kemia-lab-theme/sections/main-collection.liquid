<section class="k-section">
  <div class="k-container">
    <div class="k-section-head k-collection__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="k-h2">{{ collection.title }}</h1>
      {%- if section.settings.show_rule -%}<hr class="k-rule">{%- endif -%}
      {%- if collection.description != blank -%}
        <div class="k-section-head__text k-text">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- paginate collection.products by section.settings.per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="k-product-grid">
          {%- for item in collection.products -%}
            {% render 'product-card', card_product: item, show_price: section.settings.show_price, cta_label: section.settings.cta_label %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="k-pagination k-collection__pagination" aria-label="{{ 'general.pagination.label' | t }}">
            {%- if paginate.previous -%}
              <a class="k-pagination__item" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
                {% render 'icon', name: 'chevron-left', class: 'k-icon--xs' %}
              </a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a class="k-pagination__item" href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span class="k-pagination__item{% if part.title == paginate.current_page %} is-active{% endif %}">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a class="k-pagination__item" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
                {% render 'icon', name: 'chevron-right', class: 'k-icon--xs' %}
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="k-form-note">{{ 'collections.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "class": "k-collection-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "checkbox", "id": "show_rule", "label": "Filet doré", "default": true },
    { "type": "checkbox", "id": "show_price", "label": "Afficher les prix", "default": true },
    { "type": "text", "id": "cta_label", "label": "Lien des cartes", "default": "Découvrir" },
    { "type": "range", "id": "per_page", "label": "Produits par page", "min": 6, "max": 24, "step": 3, "default": 12 }
  ]
}
{% endschema %}
