{%- liquid
  assign source = section.settings.product
  if source == blank and product != blank
    assign source = product
  endif
  assign ingredients = source.metafields.kemia.ingredients.value
  assign total = ingredients.size | plus: 0
-%}

{%- if total > 0 -%}
  <section class="k-section{% if section.settings.background == 'soft' %} k-bg-soft{% elsif section.settings.background == 'beige' %} k-bg-beige{% elsif section.settings.background == 'blue-tint' %} k-bg-blue-tint{% endif %}">
    <div class="k-container">
      <div class="k-section-head k-actifs__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="k-h2{% if section.settings.heading_style == 'display' %} k-display{% elsif section.settings.heading_style == 'caps' %} k-title-caps k-h3{% endif %}">
            {%- if section.settings.show_count -%}{{ ingredients.size }} {% endif -%}
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.show_rule -%}<hr class="k-rule">{%- endif -%}
      </div>

      <div class="k-actifs k-carousel" data-k-rail>
        <button class="k-carousel__nav k-actifs__nav k-actifs__nav--prev" type="button" data-k-rail-prev aria-label="{{ 'general.previous' | t }}">
          {% render 'icon', name: 'chevron-left', class: 'k-icon--sm' %}
        </button>

        <div class="k-actifs__track k-rail k-rail--{{ section.settings.per_view }}" data-k-rail-track>
          {%- for item in ingredients -%}
            <article class="k-actif">
              <div class="k-actif__media">
                {% render 'image',
                  image: item.image.value,
                  ratio: '100%',
                  fit: 'contain',
                  class: 'k-media--plain',
                  sizes: '(min-width: 990px) 220px, 45vw',
                  placeholder_icon: 'leaf'
                %}
              </div>
              <h3 class="k-actif__name">{{ item.name.value }}</h3>
              {%- if item.short_benefit.value != blank -%}
                <p class="k-actif__benefit">{{ item.short_benefit.value }}</p>
              {%- endif -%}
              {%- if section.settings.show_dosage -%}
                <p class="k-actif__dose">{{ item.amount.value }}{% if item.unit.value != blank %} {{ item.unit.value }}{% endif %}</p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>

        <button class="k-carousel__nav k-actifs__nav k-actifs__nav--next" type="button" data-k-rail-next aria-label="{{ 'general.next' | t }}">
          {% render 'icon', name: 'chevron-right', class: 'k-icon--sm' %}
        </button>

        {%- if section.settings.show_dots -%}
          <div class="k-carousel__dots" data-k-rail-dots></div>
        {%- endif -%}
      </div>

      {%- if section.settings.note != blank -%}
        <p class="k-actifs__note">{{ section.settings.note }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="k-actifs__cta">
          <a class="k-btn k-btn--outline" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label }}
            {% render 'icon', name: 'arrow-right', class: 'k-icon--sm' %}
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- else -%}
  {% render 'section-empty', message: "Carrousel des actifs : sélectionnez un produit dont le champ méta kemia.ingredients est renseigné." %}
{%- endif -%}

{% schema %}
{
  "name": "Actifs en carrousel",
  "class": "k-actifs-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit source",
      "info": "Les actifs, leurs visuels et leurs bénéfices proviennent du champ méta kemia.ingredients. Sur une fiche produit, laisser vide."
    },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Les actifs de la formule" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "actifs, un rôle pour chacun" },
    { "type": "checkbox", "id": "show_count", "label": "Préfixer le titre par le nombre d'actifs", "default": true },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Style du titre",
      "options": [
        { "value": "sans", "label": "Titres" },
        { "value": "caps", "label": "Majuscules" },
        { "value": "display", "label": "Éditorial" }
      ],
      "default": "sans"
    },
    { "type": "checkbox", "id": "show_rule", "label": "Filet doré", "default": true },
    { "type": "checkbox", "id": "show_dosage", "label": "Afficher le dosage", "default": true },
    {
      "type": "select",
      "id": "per_view",
      "label": "Cartes visibles sur ordinateur",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "5"
    },
    { "type": "checkbox", "id": "show_dots", "label": "Points de navigation", "default": true },
    { "type": "text", "id": "note", "label": "Note sous le carrousel", "default": "VNR : Valeurs Nutritionnelles de Référence." },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "soft", "label": "Beige clair" },
        { "value": "beige", "label": "Beige" },
        { "value": "blue-tint", "label": "Bleu très clair" }
      ],
      "default": "none"
    }
  ],
  "presets": [{ "name": "Actifs en carrousel" }]
}
{% endschema %}
