{%- if section.blocks.size > 0 -%}
  <section class="k-section{% if section.settings.background == 'soft' %} k-bg-soft{% elsif section.settings.background == 'beige' %} k-bg-beige{% endif %}">
    <div class="k-container">
      <div class="k-section-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="k-title-caps k-h3">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.show_rule -%}<hr class="k-rule">{%- endif -%}
      </div>

      <div class="k-compare k-compare--standalone">
        {%- if section.settings.style == 'panels' -%}
          <div class="k-versus">
            <div class="k-versus__side k-versus__side--brand">
              <p class="k-versus__header">{{ section.settings.column_brand }}</p>
              <ul class="k-versus__list">
                {%- for block in section.blocks -%}
                  <li class="k-versus__row" {{ block.shopify_attributes }}>
                    {% render 'icon', name: 'check-circle-solid', class: 'k-icon--sm' %}
                    <span class="k-versus__body">
                      <span class="k-versus__label">{{ block.settings.brand_text }}</span>
                      {%- if block.settings.brand_note != blank -%}
                        <span class="k-versus__note">{{ block.settings.brand_note }}</span>
                      {%- endif -%}
                    </span>
                  </li>
                {%- endfor -%}
              </ul>
            </div>

            {%- if section.settings.versus_label != blank -%}
              <span class="k-versus__badge" aria-hidden="true">{{ section.settings.versus_label }}</span>
            {%- endif -%}

            <div class="k-versus__side k-versus__side--other">
              <p class="k-versus__header">{{ section.settings.column_other }}</p>
              <ul class="k-versus__list">
                {%- for block in section.blocks -%}
                  <li class="k-versus__row">
                    {% render 'icon', name: 'x-circle', class: 'k-icon--sm' %}
                    <span class="k-versus__body">
                      <span class="k-versus__label">{{ block.settings.other_text }}</span>
                      {%- if block.settings.other_note != blank -%}
                        <span class="k-versus__note">{{ block.settings.other_note }}</span>
                      {%- endif -%}
                    </span>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- else -%}
          <div class="k-compare__table">
            <div class="k-compare__header k-compare__header--brand">{{ section.settings.column_brand }}</div>
            <div class="k-compare__header k-compare__header--other">{{ section.settings.column_other }}</div>

            {%- for block in section.blocks -%}
              <div class="k-compare__cell k-compare__cell--brand" {{ block.shopify_attributes }}>
                {% render 'icon', name: 'check-circle', class: 'k-icon--sm' %}
                <span>{{ block.settings.brand_text }}</span>
              </div>
              <div class="k-compare__cell k-compare__cell--other">
                {% render 'icon', name: 'x-circle', class: 'k-icon--sm' %}
                <span>{{ block.settings.other_text }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="k-compare__cta">
            <a class="k-btn" href="{{ section.settings.button_link }}" data-k-track="comparison_cta_clicked">{{ section.settings.button_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Tableau comparatif",
  "class": "k-comparison-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pourquoi choisir cette formule ?" },
    { "type": "checkbox", "id": "show_rule", "label": "Filet doré", "default": true },
    {
      "type": "select",
      "id": "style",
      "label": "Présentation",
      "options": [
        { "value": "panels", "label": "Deux panneaux face à face" },
        { "value": "table", "label": "Tableau à deux colonnes" }
      ],
      "default": "panels"
    },
    { "type": "text", "id": "versus_label", "label": "Pastille centrale", "default": "VS" },
    { "type": "text", "id": "column_brand", "label": "Colonne marque", "default": "4 Vitality System" },
    { "type": "text", "id": "column_other", "label": "Colonne comparée", "default": "Compléments classiques" },
    { "type": "text", "id": "button_label", "label": "Bouton sous le tableau" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "soft", "label": "Beige clair" },
        { "value": "beige", "label": "Beige" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        { "type": "text", "id": "brand_note", "label": "Précision colonne de gauche" },
        { "type": "text", "id": "other_note", "label": "Précision colonne de droite" },
        { "type": "textarea", "id": "brand_text", "label": "Colonne marque", "default": "Une seule formule, 4 bénéfices essentiels" },
        { "type": "textarea", "id": "other_text", "label": "Colonne comparée", "default": "Plusieurs produits pour des bénéfices isolés" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tableau comparatif",
      "blocks": [
        { "type": "row", "settings": { "brand_text": "Une seule formule, 4 bénéfices essentiels", "other_text": "Plusieurs produits pour des bénéfices isolés" } },
        { "type": "row", "settings": { "brand_text": "2 gélules par jour, une routine simple", "other_text": "Plusieurs prises quotidiennes" } },
        { "type": "row", "settings": { "brand_text": "Des dosages affichés pour chaque actif", "other_text": "Des compositions difficiles à comparer" } },
        { "type": "row", "settings": { "brand_text": "Un seul budget à suivre", "other_text": "Un budget réparti sur plusieurs produits" } }
      ]
    }
  ]
}
{% endschema %}
