<div class="k-section k-section--tight">
  <div class="k-container">
    <div class="k-ctacard k-ctacard--{{ section.settings.background }}">
      <div class="k-ctacard__media">
        {% render 'image', image: section.settings.image, ratio: '86%', fit: 'contain', sizes: '(min-width: 750px) 240px, 60vw', placeholder_icon: 'bottle' %}
      </div>
      <div class="k-ctacard__body">
        {%- if section.settings.eyebrow != blank -%}
          <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="k-h3 k-ctacard__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="k-ctacard__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="k-btn k-btn--outline" href="{{ section.settings.button_link }}" data-k-track="{{ section.settings.button_event }}">
            {{ section.settings.button_label }}
            {% render 'icon', name: 'arrow-right', class: 'k-icon--sm' %}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Encart produit",
  "class": "k-ctacard-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Visuel" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Prêt à révéler votre potentiel ?" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Découvrez 4 Vitality System, notre première formule." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir le produit" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "text", "id": "button_event", "label": "Nom d'événement analytics", "default": "home_final_product_click" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "soft", "label": "Beige clair" },
        { "value": "beige", "label": "Beige" },
        { "value": "blue-tint", "label": "Bleu très clair" }
      ],
      "default": "soft"
    }
  ],
  "presets": [{ "name": "Encart produit" }]
}
{% endschema %}
