<section class="k-section{% if section.settings.background == 'soft' %} k-bg-soft{% elsif section.settings.background == 'beige' %} k-bg-beige{% elsif section.settings.background == 'blue-tint' %} k-bg-blue-tint{% endif %}">
  <div class="k-container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="k-section-head k-features__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="k-eyebrow{% if section.settings.accent == 'blue' %} k-eyebrow--blue{% endif %}">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="{% if section.settings.heading_style == 'caps' %}k-title-caps k-h3{% elsif section.settings.heading_style == 'display' %}k-h2 k-display{% else %}k-h2{% endif %}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.show_rule -%}<hr class="k-rule">{%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="k-section-head__text k-text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="k-features k-features--{{ section.blocks.size }}{% if section.settings.dividers %} k-features--dividers{% endif %}{% if section.settings.style == 'card' %} k-features--cards{% endif %}{% if section.settings.accent == 'blue' %} k-features--blue{% endif %}">
      {%- for block in section.blocks -%}
        <li class="k-features__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="k-features__icon{% if section.settings.icon_style == 'circle' %} k-icon-circle{% endif %}">
              {% render 'icon', name: block.settings.icon, class: 'k-icon--lg' %}
            </span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="k-features__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="k-features__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="k-features__cta">
        <a class="k-btn {% if section.settings.accent == 'blue' %}k-btn--blue{% else %}k-btn--outline{% endif %}" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
          {% render 'icon', name: 'arrow-right', class: 'k-icon--sm' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Colonnes à pictogrammes",
  "class": "k-features-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pourquoi choisir Kemia Lab ?" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Style du titre",
      "options": [
        { "value": "caps", "label": "Majuscules" },
        { "value": "sans", "label": "Titres" },
        { "value": "display", "label": "Éditorial" }
      ],
      "default": "caps"
    },
    { "type": "checkbox", "id": "show_rule", "label": "Filet doré", "default": true },
    { "type": "richtext", "id": "text", "label": "Texte d'introduction" },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Style des pictogrammes",
      "options": [
        { "value": "plain", "label": "Simple" },
        { "value": "circle", "label": "Cerclé" }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "accent",
      "label": "Couleur d'accent",
      "options": [
        { "value": "gold", "label": "Doré" },
        { "value": "blue", "label": "Bleu scientifique" }
      ],
      "default": "gold"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Présentation",
      "options": [
        { "value": "plain", "label": "Colonnes" },
        { "value": "card", "label": "Cartes" }
      ],
      "default": "plain"
    },
    { "type": "checkbox", "id": "dividers", "label": "Séparateurs verticaux", "default": true },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "soft", "label": "Beige clair" },
        { "value": "beige", "label": "Beige" },
        { "value": "blue-tint", "label": "Bleu très clair" }
      ],
      "default": "none"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Colonne",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Pictogramme",
          "options": [
            { "value": "none", "label": "Aucun" },
            { "value": "molecule", "label": "Molécule" },
            { "value": "leaf", "label": "Feuille" },
            { "value": "shield-check", "label": "Bouclier" },
            { "value": "chart-up", "label": "Progression" },
            { "value": "flask", "label": "Fiole" },
            { "value": "beaker", "label": "Éprouvette" },
            { "value": "award", "label": "Médaille" },
            { "value": "target", "label": "Cible" },
            { "value": "sparkle", "label": "Étincelle" },
            { "value": "bolt", "label": "Éclair" },
            { "value": "brain", "label": "Cerveau" },
            { "value": "muscle", "label": "Vitalité" },
            { "value": "shield-star", "label": "Bien-être" },
            { "value": "hexagon", "label": "Hexagone" },
            { "value": "dna", "label": "ADN" },
            { "value": "capsule", "label": "Gélule" },
            { "value": "truck", "label": "Livraison" },
            { "value": "headset", "label": "Service client" },
            { "value": "lock", "label": "Cadenas" }
          ],
          "default": "molecule"
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Science & expertise" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Nos formules sont élaborées à partir d'études scientifiques et d'une expertise pointue." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colonnes à pictogrammes",
      "blocks": [
        { "type": "item", "settings": { "icon": "molecule", "title": "Science & expertise", "text": "Nos formules sont élaborées à partir d'études scientifiques et d'une expertise pointue." } },
        { "type": "item", "settings": { "icon": "leaf", "title": "Ingrédients premium", "text": "Nous sélectionnons des ingrédients de la plus haute qualité pour leur pureté, leur traçabilité et leur efficacité." } },
        { "type": "item", "settings": { "icon": "shield-check", "title": "Qualité contrôlée", "text": "De la sélection des matières premières à la fabrication, chaque étape est contrôlée." } },
        { "type": "item", "settings": { "icon": "chart-up", "title": "Pensé pour progresser", "text": "Des formules pensées pour soutenir votre vitalité au quotidien et vos performances." } }
      ]
    }
  ]
}
{% endschema %}
