{%- liquid
  assign rows = 0
  for block in section.blocks
    unless block.settings.situation == blank and block.settings.outcome == blank
      assign rows = rows | plus: 1
    endunless
  endfor
-%}

{%- if rows > 0 -%}
  <section class="k-section{% if section.settings.background == 'soft' %} k-bg-soft{% elsif section.settings.background == 'beige' %} k-bg-beige{% elsif section.settings.background == 'blue-tint' %} k-bg-blue-tint{% endif %}">
    <div class="k-container">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="k-section-head">
          {%- if section.settings.eyebrow != blank -%}
            <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="k-h2">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.show_rule -%}<hr class="k-rule">{%- endif -%}
          {%- if section.settings.intro != blank -%}
            <p class="k-section-head__text">{{ section.settings.intro }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="k-fit">
        {%- if section.settings.col_situation != blank or section.settings.col_outcome != blank -%}
          <div class="k-fit__head">
            <span class="k-fit__coltitle">{{ section.settings.col_situation }}</span>
            <span class="k-fit__coltitle k-fit__coltitle--gold">{{ section.settings.col_outcome }}</span>
          </div>
        {%- endif -%}

        <ul class="k-fit__rows" data-k-reveal>
          {%- for block in section.blocks -%}
            {%- unless block.settings.situation == blank and block.settings.outcome == blank -%}
              <li class="k-fit__row" {{ block.shopify_attributes }}>
                <p class="k-fit__situation">{{ block.settings.situation }}</p>
                <p class="k-fit__outcome">
                  {% render 'icon', name: 'check-circle', class: 'k-icon--sm' %}
                  <span>{{ block.settings.outcome }}</span>
                </p>
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- if section.settings.note != blank -%}
        <p class="k-fit__note">{{ section.settings.note }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="k-fit__cta">
          <a class="k-btn k-btn--blue" href="{{ section.settings.button_link }}" data-k-track="{{ section.settings.button_event }}">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- else -%}
  {% render 'section-empty', message: "Fait pour vous : ajoutez une ligne par situation." %}
{%- endif -%}

{% schema %}
{
  "name": "Fait pour vous",
  "class": "k-fit-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Fait pour vous" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Conçu pour des journées comme les vôtres" },
    { "type": "checkbox", "id": "show_rule", "label": "Filet doré", "default": true },
    { "type": "text", "id": "intro", "label": "Introduction" },
    { "type": "text", "id": "col_situation", "label": "Titre de la colonne gauche", "default": "Votre quotidien" },
    { "type": "text", "id": "col_outcome", "label": "Titre de la colonne droite", "default": "Ce que la formule y apporte" },
    { "type": "text", "id": "note", "label": "Mention sous le tableau" },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "text", "id": "button_event", "label": "Nom de l'évènement", "default": "pdp_fit_click" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "soft", "label": "Beige clair" },
        { "value": "beige", "label": "Beige" },
        { "value": "blue-tint", "label": "Bleu très clair" }
      ],
      "default": "none"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "item",
      "name": "Ligne",
      "settings": [
        { "type": "textarea", "id": "situation", "label": "Votre quotidien" },
        { "type": "textarea", "id": "outcome", "label": "Ce que la formule y apporte" }
      ]
    }
  ],
  "presets": [{ "name": "Fait pour vous" }]
}
{% endschema %}
