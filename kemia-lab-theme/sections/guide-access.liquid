{%- liquid
  assign pdf = section.settings.pdf_url | strip
  assign has_pdf = false
  if pdf != blank and pdf != '#'
    assign has_pdf = true
  endif

  assign read = section.settings.read_url | strip
  if read == blank or read == '#'
    assign read = pdf
  endif
  assign has_read = false
  if read != blank and read != '#'
    if section.settings.read_label != blank
      assign has_read = true
    endif
  endif

  assign has_guide = false
  if has_pdf or has_read
    assign has_guide = true
  endif

  assign steps = 0
  for block in section.blocks
    if block.type == 'step' and block.settings.title != blank
      assign steps = steps | plus: 1
    endif
  endfor
-%}

<section class="k-section k-guide-section">
  <div class="k-container k-container--narrow">
    <div class="k-guide">
      {%- if section.settings.logo != blank -%}
        <img
          class="k-guide__logo"
          src="{{ section.settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name | escape }}"
          width="{{ section.settings.logo_width }}"
          loading="eager"
        >
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <span class="k-eyebrow k-guide__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="k-h2 k-title-caps k-guide__heading">{{ section.settings.heading | newline_to_br }}</h1>
      {%- endif -%}

      {%- if section.settings.show_rule -%}
        <hr class="k-rule k-guide__rule">
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <div class="k-guide__intro k-text">{{ section.settings.intro }}</div>
      {%- endif -%}

      <div class="k-guide__actions">
        {%- if has_pdf -%}
          <a
            class="k-btn k-btn--lg k-guide__cta"
            href="{{ pdf | escape }}"
            download
            data-k-guide-download
          >
            <svg class="k-guide__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 3.5v10.6"/>
              <path d="M7.8 10.2l4.2 4.2 4.2-4.2"/>
              <path d="M4.2 16.4v2.2a2 2 0 002 2h11.6a2 2 0 002-2v-2.2"/>
            </svg>
            <span>{{ section.settings.button_label }}</span>
          </a>
        {%- endif -%}

        {%- if has_read -%}
          {%- if has_pdf -%}
            {%- assign read_class = 'k-btn k-btn--ghost k-guide__read' -%}
          {%- else -%}
            {%- assign read_class = 'k-btn k-btn--lg k-guide__read k-guide__read--solo' -%}
          {%- endif -%}
          <a class="{{ read_class }}" href="{{ read | escape }}" target="_blank" rel="noopener">
            <span>{{ section.settings.read_label }}</span>
            <svg class="k-guide__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M14 4h6v6"/>
              <path d="M20 4l-8.4 8.4"/>
              <path d="M18.5 14.4v4.1a2 2 0 01-2 2H5.5a2 2 0 01-2-2V7.5a2 2 0 012-2h4.1"/>
            </svg>
          </a>
        {%- endif -%}

        {%- unless has_guide -%}
          <p class="k-guide__pending">{{ section.settings.pending_note }}</p>
        {%- endunless -%}
      </div>

      {%- if has_guide and section.settings.note != blank -%}
        <p class="k-guide__note">
          <svg class="k-guide__icon k-guide__icon--xs" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="4.5" y="10.5" width="15" height="10.5" rx="2"/>
            <path d="M8 10.5V7.6a4 4 0 018 0v2.9"/>
          </svg>
          <span>{{ section.settings.note }}</span>
        </p>
      {%- endif -%}

      {%- if steps > 0 -%}
        <ul class="k-guide__steps">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' and block.settings.title != blank -%}
              <li class="k-guide__step" {{ block.shopify_attributes }}>
                <span class="k-guide__step-icon">
                  {%- if block.settings.image != blank -%}
                    <img
                      class="k-guide__step-img"
                      src="{{ block.settings.image | image_url: width: 136 }}"
                      alt=""
                      width="34"
                      height="34"
                      loading="lazy"
                    >
                  {%- elsif block.settings.icon != 'none' -%}
                    {% render 'icon', name: block.settings.icon, class: 'k-icon--lg' %}
                  {%- endif -%}
                </span>
                <span class="k-guide__step-title">{{ block.settings.title }}</span>
                {%- if block.settings.text != blank -%}
                  <span class="k-guide__step-text">{{ block.settings.text }}</span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.help_text != blank -%}
        <p class="k-guide__help">
          <span>{{ section.settings.help_text }}</span>
          {%- if section.settings.help_link_label != blank and section.settings.help_link != blank -%}
            <a href="{{ section.settings.help_link }}">{{ section.settings.help_link_label }}</a>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .k-guide {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .k-guide__logo {
    height: auto;
    max-width: {{ section.settings.logo_width }}px;
    margin-bottom: 6px;
  }

  #shopify-section-{{ section.id }} .k-guide__heading {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .k-guide__rule {
    margin: 2px 0 4px;
  }

  #shopify-section-{{ section.id }} .k-guide__intro {
    max-width: 46ch;
    color: var(--k-body);
  }

  #shopify-section-{{ section.id }} .k-guide__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    width: min(100%, 340px);
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .k-guide__cta,
  #shopify-section-{{ section.id }} .k-guide__read {
    gap: 10px;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .k-guide__icon {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #shopify-section-{{ section.id }} .k-guide__icon--xs {
    width: 15px;
    height: 15px;
    color: var(--k-gold);
  }

  #shopify-section-{{ section.id }} .k-guide__pending {
    padding: 16px 18px;
    border: 1px dashed var(--k-border);
    border-radius: var(--k-radius-card);
    color: var(--k-body);
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .k-guide__note {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    font-size: 12.5px;
    color: var(--k-body);
  }

  #shopify-section-{{ section.id }} .k-guide__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px 14px;
    width: 100%;
    margin: 24px 0 0;
    padding: 22px 0 0;
    list-style: none;
    border-top: 1px solid var(--k-border);
  }

  #shopify-section-{{ section.id }} .k-guide__steps > * {
    grid-column-end: span 2;
  }

  #shopify-section-{{ section.id }} .k-guide__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .k-guide__step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 62px;
    height: 62px;
    border-radius: 999px;
    border: 1px solid var(--k-gold-soft);
    color: var(--k-gold);
  }

  #shopify-section-{{ section.id }} .k-guide__step-img {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .k-guide__step-title {
    font-family: var(--k-font-heading);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.3;
    color: var(--k-ink);
  }

  #shopify-section-{{ section.id }} .k-guide__step-text {
    font-size: 13px;
    line-height: 1.5;
    color: var(--k-body);
  }

  #shopify-section-{{ section.id }} .k-guide__help {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 22px;
    font-size: 13.5px;
    color: var(--k-body);
  }

  #shopify-section-{{ section.id }} .k-guide__help a {
    color: var(--k-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .k-guide__steps > :nth-child(2n + 1):last-child {
      grid-column-start: 2;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .k-guide__actions {
      flex-direction: row;
      width: auto;
    }

    #shopify-section-{{ section.id }} .k-guide__steps {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .k-guide__steps > :nth-child(4n + 1):nth-last-child(1) {
      grid-column-start: 4;
    }

    #shopify-section-{{ section.id }} .k-guide__steps > :nth-child(4n + 1):nth-last-child(2) {
      grid-column-start: 3;
    }

    #shopify-section-{{ section.id }} .k-guide__steps > :nth-child(4n + 1):nth-last-child(3) {
      grid-column-start: 2;
    }
  }
</style>

{%- if has_pdf and section.settings.auto_download -%}
  <script>
    (function () {
      var lancer = function () {
        var lien = document.querySelector('#shopify-section-{{ section.id }} [data-k-guide-download]');
        if (!lien) return;
        window.setTimeout(function () {
          lien.click();
        }, {{ section.settings.auto_delay | times: 1000 }});
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', lancer);
      } else {
        lancer();
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Accès au guide",
  "class": "k-guide-wrap",
  "settings": [
    {
      "type": "paragraph",
      "content": "Page destinée au QR code des cartes. Téléversez le guide dans Contenu puis Fichiers, copiez son adresse et collez-la ci-dessous. Vous pourrez remplacer le fichier plus tard sans réimprimer les cartes."
    },
    {
      "type": "text",
      "id": "pdf_url",
      "label": "Adresse de téléchargement",
      "info": "Adresse du PDF téléversé dans Contenu, Fichiers. Vide : seul le bouton de lecture reste affiché."
    },
    { "type": "text", "id": "button_label", "label": "Bouton de téléchargement", "default": "Télécharger le guide" },
    {
      "type": "text",
      "id": "read_url",
      "label": "Adresse de lecture en ligne",
      "info": "Vide : le bouton de lecture ouvre l'adresse de téléchargement."
    },
    {
      "type": "text",
      "id": "read_label",
      "label": "Bouton de lecture",
      "info": "Ouvre le guide dans un onglet. Vide pour n'afficher que le bouton de téléchargement.",
      "default": "Lire le guide"
    },
    {
      "type": "text",
      "id": "pending_note",
      "label": "Message sans guide",
      "info": "Affiché tant qu'aucune des deux adresses n'est renseignée.",
      "default": "Le guide sera disponible ici très prochainement."
    },
    { "type": "header", "content": "Téléchargement automatique" },
    {
      "type": "checkbox",
      "id": "auto_download",
      "label": "Lancer le téléchargement tout seul",
      "default": false,
      "info": "Certains navigateurs mobiles bloquent un téléchargement non demandé. Le bouton reste toujours affiché."
    },
    { "type": "range", "id": "auto_delay", "label": "Délai avant téléchargement", "min": 0, "max": 5, "step": 1, "unit": "s", "default": 1 },
    { "type": "header", "content": "Contenu" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Largeur du logo", "min": 80, "max": 260, "step": 10, "unit": "px", "default": 150 },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Accès réservé" },
    { "type": "textarea", "id": "heading", "label": "Titre", "default": "Votre guide\nd'utilisation" },
    { "type": "checkbox", "id": "show_rule", "label": "Filet doré sous le titre", "default": true },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Merci pour votre confiance. Retrouvez ici tout ce qu'il faut savoir pour tirer le meilleur de votre cure.</p>"
    },
    { "type": "text", "id": "note", "label": "Mention sous les boutons", "default": "Accès réservé aux clients Kemia Lab" },
    { "type": "header", "content": "Aide" },
    { "type": "text", "id": "help_text", "label": "Texte d'aide", "default": "Une question sur votre cure ?" },
    { "type": "text", "id": "help_link_label", "label": "Libellé du lien", "default": "Écrivez-nous" },
    { "type": "url", "id": "help_link", "label": "Lien" }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "step",
      "name": "Repère",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icône téléversée",
          "info": "Remplace le pictogramme choisi ci-dessous, à la même taille."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Pictogramme",
          "options": [
            { "value": "none", "label": "Aucun" },
            { "value": "capsule", "label": "Gélule" },
            { "value": "calendar", "label": "Calendrier" },
            { "value": "clock", "label": "Horloge" },
            { "value": "leaf", "label": "Feuille" },
            { "value": "shield-check", "label": "Bouclier" },
            { "value": "bolt", "label": "Éclair" },
            { "value": "brain", "label": "Cerveau" },
            { "value": "droplet", "label": "Goutte" },
            { "value": "headset", "label": "Service client" }
          ],
          "default": "capsule"
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "2 gélules par jour" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Le matin, avec un grand verre d'eau." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Accès au guide",
      "blocks": [
        { "type": "step", "settings": { "icon": "capsule", "title": "2 gélules par jour", "text": "Le matin, avec un grand verre d'eau." } },
        { "type": "step", "settings": { "icon": "calendar", "title": "30 jours de cure", "text": "Pour des résultats durables." } },
        { "type": "step", "settings": { "icon": "leaf", "title": "Une routine simple", "text": "À intégrer à votre quotidien." } }
      ]
    }
  ]
}
{% endschema %}
