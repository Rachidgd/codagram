<section class="k-section">
  <div class="k-container">
    <div class="k-section-head k-cart__head">
      <h1 class="k-h2">{{ 'cart.title' | t }}</h1>
      <hr class="k-rule">
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="k-cart__empty">
        <p class="k-text">{{ 'cart.empty' | t }}</p>
        <a class="k-btn" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="k-cart">
        <ul class="k-cart__lines">
          {%- for line in cart.items -%}
            <li class="k-cart-line k-cart-line--page">
              <a class="k-cart-line__media" href="{{ line.url }}" tabindex="-1" aria-hidden="true">
                {% render 'image', image: line.image, ratio: '100%', fit: 'contain', sizes: '120px', placeholder_icon: 'bottle' %}
              </a>
              <div class="k-cart-line__info">
                <a class="k-cart-line__title" href="{{ line.url }}">{{ line.product.title }}</a>
                {%- unless line.product.has_only_default_variant -%}
                  <p class="k-cart-line__variant">{{ line.variant.title }}</p>
                {%- endunless -%}
                <div class="k-cart-line__row">
                  <div class="k-quantity k-quantity--sm" data-k-quantity>
                    <button class="k-quantity__btn" type="button" data-k-qty-step="-1" aria-label="{{ 'products.decrease' | t }}">
                      {% render 'icon', name: 'minus', class: 'k-icon--xs' %}
                    </button>
                    <input class="k-quantity__input" type="number" min="0" value="{{ line.quantity }}" data-k-cart-qty="{{ forloop.index }}" aria-label="{{ 'cart.quantity' | t }}">
                    <button class="k-quantity__btn" type="button" data-k-qty-step="1" aria-label="{{ 'products.increase' | t }}">
                      {% render 'icon', name: 'plus', class: 'k-icon--xs' %}
                    </button>
                  </div>
                  <span class="k-cart-line__price">{{ line.final_line_price | money }}</span>
                </div>
                <button class="k-cart-line__remove" type="button" data-k-cart-remove="{{ forloop.index }}">{{ 'cart.remove' | t }}</button>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <aside class="k-cart__summary k-card k-card--pad">
          <div class="k-cart-drawer__total">
            <span>{{ 'cart.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <p class="k-form-note">{{ 'cart.taxes_and_shipping' | t }}</p>
          <button class="k-btn k-btn--block k-btn--lg" type="submit" name="checkout" data-k-track="checkout_started">{{ 'cart.checkout' | t }}</button>
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Panier",
  "class": "k-cart-section",
  "settings": []
}
{% endschema %}
