{%- liquid
  assign source = section.settings.product
  if source == blank and product != blank
    assign source = product
  endif
  assign benefits = source.metafields.kemia.benefits.value
-%}

{%- if benefits.size > 0 -%}
  <section class="k-section{% if section.settings.background == 'soft' %} k-bg-soft{% elsif section.settings.background == 'beige' %} k-bg-beige{% endif %}">
    <div class="k-container">
      <div class="k-pillars">
        <div class="k-pillars__head">
          {%- if section.settings.heading != blank -%}
            <h2 class="k-title-caps k-h3">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="k-pillars__sub">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>

        <div class="k-pillars__diagram">
          <svg class="k-pillars__hex" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
            <path d="M100 4l83 48v96l-83 48-83-48V52z" fill="none" stroke="currentColor" stroke-width="0.8" />
          </svg>

          <div class="k-pillars__center">
            {% render 'image', image: section.settings.image, ratio: '118%', fit: 'contain', sizes: '(min-width: 990px) 240px, 60vw', placeholder_icon: 'bottle' %}
          </div>

          {%- for benefit in benefits limit: 4 -%}
            <div class="k-pillars__item k-pillars__item--{{ forloop.index }}">
              <span class="k-pillars__icon">{% render 'icon', name: benefit.icon.value, class: 'k-icon--lg' %}</span>
              <div class="k-pillars__body">
                <h3 class="k-pillars__title">{{ benefit.label.value }}</h3>
                {%- if benefit.short_text.value != blank -%}
                  <p class="k-pillars__text">{{ benefit.short_text.value }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.note != blank -%}
          <p class="k-pillars__note">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- else -%}
  {% render 'section-empty', message: "Section Piliers : sélectionnez un produit dont le champ méta kemia.benefits est renseigné." %}
{%- endif -%}

{% schema %}
{
  "name": "Piliers du produit",
  "class": "k-pillars-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit source",
      "info": "Les piliers proviennent du champ méta kemia.benefits. Sur une fiche produit, laisser vide."
    },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le pouvoir du 4" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Quatre piliers essentiels, une seule formule." },
    { "type": "image_picker", "id": "image", "label": "Visuel central" },
    { "type": "text", "id": "note", "label": "Note sous le bloc" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "soft", "label": "Beige clair" },
        { "value": "beige", "label": "Beige" }
      ],
      "default": "soft"
    }
  ],
  "presets": [{ "name": "Piliers du produit" }]
}
{% endschema %}
