{%- liquid
  assign target = blogs[section.settings.blog]
  assign count = section.settings.slides_count
  assign available = target.articles.size | plus: 0
  assign shown = count
  if available < count
    assign shown = available
  endif
-%}

{%- if available > 0 -%}
  <section class="k-section">
    <div class="k-container">
      <div class="k-blogrow__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="k-title-caps k-h3">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="k-link k-link--caps" href="{{ target.url }}">
            {{ section.settings.link_label }}
            {% render 'icon', name: 'arrow-right', class: 'k-icon--sm' %}
          </a>
        {%- endif -%}
      </div>

      <div class="k-blogrow k-carousel" data-k-rail>
        {%- if shown > 1 -%}
          <button class="k-carousel__nav k-blogrow__nav k-blogrow__nav--prev" type="button" data-k-rail-prev aria-label="{{ 'general.previous' | t }}">
            {% render 'icon', name: 'chevron-left', class: 'k-icon--sm' %}
          </button>
        {%- endif -%}

        <div class="k-blogrow__track k-rail k-rail--{{ section.settings.per_view }}" data-k-rail-track>
          {%- for article in target.articles limit: count -%}
            {% render 'article-card', article: article %}
          {%- endfor -%}
        </div>

        {%- if shown > 1 -%}
          <button class="k-carousel__nav k-blogrow__nav k-blogrow__nav--next" type="button" data-k-rail-next aria-label="{{ 'general.next' | t }}">
            {% render 'icon', name: 'chevron-right', class: 'k-icon--sm' %}
          </button>
        {%- endif -%}

        {%- if section.settings.show_dots and shown > 1 -%}
          <div class="k-carousel__dots" data-k-rail-dots></div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- else -%}
  {% render 'section-empty', message: "Section Articles du blog : sélectionnez un blog contenant au moins un article." %}
{%- endif -%}

{% schema %}
{
  "name": "Articles du blog",
  "class": "k-blogrow-section",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le blog Kemia Lab" },
    { "type": "text", "id": "link_label", "label": "Lien", "default": "Voir tous les articles" },
    { "type": "range", "id": "slides_count", "label": "Nombre d'articles dans le slider", "min": 2, "max": 12, "step": 1, "default": 6 },
    {
      "type": "select",
      "id": "per_view",
      "label": "Articles visibles sur ordinateur",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "checkbox", "id": "show_dots", "label": "Afficher les points", "default": true }
  ],
  "presets": [{ "name": "Articles du blog" }]
}
{% endschema %}
