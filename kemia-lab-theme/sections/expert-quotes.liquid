{%- liquid
  assign filled = 0
  for block in section.blocks
    unless block.settings.quote == blank
      assign filled = filled | plus: 1
    endunless
  endfor
-%}

{%- if filled > 0 -%}
  <section class="k-section{% if section.settings.background == 'soft' %} k-bg-soft{% elsif section.settings.background == 'beige' %} k-bg-beige{% elsif section.settings.background == 'blue-tint' %} k-bg-blue-tint{% endif %}">
    <div class="k-container">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="k-section-head">
          {%- if section.settings.eyebrow != blank -%}
            <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="k-title-caps k-h3">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.show_rule -%}<hr class="k-rule">{%- endif -%}
        </div>
      {%- endif -%}

      <div class="k-experts k-experts--{{ filled }}">
        {%- for block in section.blocks -%}
          {%- if block.settings.quote != blank -%}
            <figure class="k-expert" {{ block.shopify_attributes }}>
              <span class="k-expert__mark" aria-hidden="true">{% render 'icon', name: 'quote' %}</span>
              <blockquote class="k-expert__quote">{{ block.settings.quote }}</blockquote>
              <figcaption class="k-expert__author">
                {%- if block.settings.image != blank -%}
                  <span class="k-expert__avatar">
                    {% render 'image', image: block.settings.image, ratio: '100%', sizes: '56px', placeholder_icon: 'user' %}
                  </span>
                {%- endif -%}
                <span class="k-expert__identity">
                  {%- if block.settings.name != blank -%}
                    <span class="k-expert__name">{{ block.settings.name }}</span>
                  {%- endif -%}
                  {%- if block.settings.role != blank -%}
                    <span class="k-expert__role">{{ block.settings.role }}</span>
                  {%- endif -%}
                  {%- if block.settings.detail != blank -%}
                    <span class="k-expert__detail">{{ block.settings.detail }}</span>
                  {%- endif -%}
                </span>
              </figcaption>
              {%- if block.settings.source_url != blank and block.settings.source_label != blank -%}
                <a class="k-expert__source" href="{{ block.settings.source_url }}" target="_blank" rel="noopener nofollow">
                  {{ block.settings.source_label }}
                  {% render 'icon', name: 'arrow-right', class: 'k-icon--xs' %}
                </a>
              {%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.note != blank -%}
        <p class="k-experts__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </section>
{%- else -%}
  {% render 'section-empty', message: "Citations et références : ajoutez un bloc et renseignez la citation. Toute citation reprise d'un tiers doit porter son lien de source. Tant qu'aucune citation n'est saisie, la section reste invisible sur le site." %}
{%- endif -%}

{% schema %}
{
  "name": "Citations et références",
  "class": "k-experts-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Sources et références" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce que disent les référentiels" },
    { "type": "checkbox", "id": "show_rule", "label": "Filet doré", "default": true },
    {
      "type": "text",
      "id": "note",
      "label": "Mention sous la section",
      "info": "Doit préciser la portée des références affichées, et l'existence d'une contrepartie si un professionnel rémunéré est cité."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "soft", "label": "Beige clair" },
        { "value": "beige", "label": "Beige" },
        { "value": "blue-tint", "label": "Bleu très clair" }
      ],
      "default": "none"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "quote",
      "name": "Avis",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Texte affiché", "info": "Indication, conclusion ou citation. La section reste invisible tant que ce champ est vide." },
        { "type": "text", "id": "name", "label": "Actif concerné", "info": "Par exemple : Extrait de ginseng. C'est ce qui s'affiche en gras." },
        { "type": "text", "id": "role", "label": "Source", "info": "Par exemple : Agence européenne des médicaments, ou le nom du professionnel cité." },
        { "type": "text", "id": "detail", "label": "Précision", "info": "Référence du document, de l'étude ou de la structure." },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "source_label", "label": "Libellé de la source", "info": "Par exemple : Voir la monographie, Lire l'article." },
        { "type": "url", "id": "source_url", "label": "Lien vers la source", "info": "Obligatoire dès qu'une citation est reprise d'un tiers : le lecteur doit pouvoir la vérifier." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Citations et références",
      "blocks": [{ "type": "quote" }, { "type": "quote" }]
    }
  ]
}
{% endschema %}
