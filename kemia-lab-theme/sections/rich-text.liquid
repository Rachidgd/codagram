<section class="k-section{% if section.settings.background == 'soft' %} k-bg-soft{% elsif section.settings.background == 'beige' %} k-bg-beige{% elsif section.settings.background == 'blue-tint' %} k-bg-blue-tint{% endif %}">
  <div class="k-container">
    <div class="k-richtext k-richtext--{{ section.settings.layout }}{% if section.settings.reverse %} k-richtext--reverse{% endif %}">
      <div class="k-richtext__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="{% if section.settings.heading_style == 'display' %}k-h2 k-display{% elsif section.settings.heading_style == 'caps' %}k-title-caps k-h3{% else %}k-h2{% endif %} k-richtext__heading">
            {{ section.settings.heading | newline_to_br }}{% if section.settings.highlight != blank %} <span class="k-gold">{{ section.settings.highlight }}</span>{% endif %}
          </h2>
        {%- endif -%}
        {%- if section.settings.show_rule -%}<hr class="k-rule k-richtext__rule">{%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="k-richtext__body k-text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="k-btn{% if section.settings.button_style == 'outline' %} k-btn--outline{% endif %} k-richtext__cta" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label }}
            {% render 'icon', name: 'arrow-right', class: 'k-icon--sm' %}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.layout == 'split' -%}
        <div class="k-richtext__media">
          {% render 'image', image: section.settings.image, ratio: '72%', sizes: '(min-width: 990px) 50vw, 100vw', placeholder_icon: 'image' %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Texte et visuel",
  "class": "k-richtext-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        { "value": "split", "label": "Texte et visuel" },
        { "value": "center", "label": "Texte centré" },
        { "value": "full", "label": "Texte pleine largeur" }
      ],
      "default": "split"
    },
    { "type": "checkbox", "id": "reverse", "label": "Inverser le sens", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "textarea", "id": "heading", "label": "Titre", "info": "Chaque retour à la ligne saisi ici crée une ligne de titre." },
    { "type": "text", "id": "highlight", "label": "Fin de titre en doré" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Style du titre",
      "options": [
        { "value": "sans", "label": "Titres" },
        { "value": "caps", "label": "Majuscules" },
        { "value": "display", "label": "Éditorial" }
      ],
      "default": "sans"
    },
    { "type": "checkbox", "id": "show_rule", "label": "Filet doré", "default": false },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "image_picker", "id": "image", "label": "Visuel" },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style du bouton",
      "options": [
        { "value": "solid", "label": "Doré plein" },
        { "value": "outline", "label": "Doré contour" }
      ],
      "default": "outline"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "soft", "label": "Beige clair" },
        { "value": "beige", "label": "Beige" },
        { "value": "blue-tint", "label": "Bleu très clair" }
      ],
      "default": "none"
    }
  ],
  "presets": [{ "name": "Texte et visuel" }]
}
{% endschema %}
