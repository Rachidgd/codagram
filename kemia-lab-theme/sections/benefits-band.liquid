<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
>

{%- liquid
  assign source = section.settings.product

  if source == blank and product != blank
    assign source = product
  endif

  assign benefits = source.metafields.kemia.benefits.value
  assign metafield_benefit_count = benefits.size | plus: 0
  assign manual_benefit_count = 0
  assign figure_count = 0
  assign overlay_alpha = section.settings.overlay_opacity | times: 0.01

  for block in section.blocks
    if block.type == 'benefit'
      assign manual_benefit_count = manual_benefit_count | plus: 1
    elsif block.type == 'figure'
      assign figure_count = figure_count | plus: 1
    endif
  endfor

  assign benefit_count = metafield_benefit_count
  if manual_benefit_count > 0
    assign benefit_count = manual_benefit_count
  endif
-%}

{%- if benefit_count > 0 -%}
  <section
    class="k-section k-benefitsband-section k-benefitsband-section--banner{% if section.settings.background_image != blank %} k-benefitsband-section--has-bg{% endif %}"
    style="
      --k-benefits-height: {{ section.settings.banner_height }}px;
      --k-benefits-overlay: {{ overlay_alpha }};
      --k-benefits-bg-position: {{ section.settings.background_position }};
      {% if section.settings.background_image != blank %}
        --k-benefits-bg-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
      {% endif %}
    "
  >
    <div class="k-container">
      <div class="k-benefitsband">
        <div class="k-benefitsband__content">
          <div class="k-benefitsband__head">
            {%- if section.settings.eyebrow != blank -%}
              <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h2 class="k-benefitsband__heading">{{ section.settings.heading | newline_to_br }}</h2>
            {%- endif -%}

            {%- if section.settings.intro != blank -%}
              <div class="k-benefitsband__intro">{{ section.settings.intro }}</div>
            {%- endif -%}
          </div>

          <ul class="k-benefitsband__list">
            {%- if manual_benefit_count > 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'benefit' -%}
                  <li class="k-benefitsband__item" {{ block.shopify_attributes }}>
                    {%- if block.settings.custom_icon != blank -%}
                      <span class="k-benefitsband__icon" aria-hidden="true">
                        <img
                          class="k-benefitsband__icon-img"
                          src="{{ block.settings.custom_icon | image_url: width: 168 }}"
                          alt=""
                          loading="lazy"
                        >
                      </span>
                    {%- elsif block.settings.icon != 'none' -%}
                      <span class="k-benefitsband__icon k-benefitsband__icon--{{ block.settings.icon_tone }}" aria-hidden="true">
                        <i class="fa-solid {{ block.settings.icon }}"></i>
                      </span>
                    {%- endif -%}

                    {%- if block.settings.label != blank -%}
                      <span class="k-benefitsband__label">{{ block.settings.label }}</span>
                    {%- endif -%}

                    {%- if section.settings.show_text and block.settings.text != blank -%}
                      <span class="k-benefitsband__text">{{ block.settings.text }}</span>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for benefit in benefits -%}
                {%- liquid
                  assign icon_key = benefit.icon.value | default: benefit.label.value | handleize
                  assign fa_icon = 'fa-circle-check'

                  case icon_key
                    when 'bolt', 'energy', 'energie', 'energie-endurance', 'lightning'
                      assign fa_icon = 'fa-bolt'
                    when 'brain', 'clarte-mentale', 'mental', 'focus', 'concentration'
                      assign fa_icon = 'fa-brain'
                    when 'vitalite-physique', 'physical', 'physique', 'muscle', 'force', 'endurance'
                      assign fa_icon = 'fa-dumbbell'
                    when 'bien-etre-intime', 'intime', 'shield', 'protection'
                      assign fa_icon = 'fa-shield-halved'
                    when 'heart', 'coeur', 'cardio'
                      assign fa_icon = 'fa-heart-pulse'
                    when 'moon', 'sommeil', 'sleep'
                      assign fa_icon = 'fa-moon'
                    when 'target', 'cible'
                      assign fa_icon = 'fa-bullseye'
                    when 'capsule', 'capsules', 'gelule', 'gelules'
                      assign fa_icon = 'fa-capsules'
                    when 'clock', 'horloge', 'time'
                      assign fa_icon = 'fa-clock'
                  endcase
                -%}

                <li class="k-benefitsband__item">
                  <span class="k-benefitsband__icon k-benefitsband__icon--{{ section.settings.icon_tone }}" aria-hidden="true">
                    <i class="fa-solid {{ fa_icon }}"></i>
                  </span>

                  <span class="k-benefitsband__label">{{ benefit.label.value }}</span>

                  {%- if section.settings.show_text and benefit.short_text.value != blank -%}
                    <span class="k-benefitsband__text">{{ benefit.short_text.value }}</span>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>

          {%- if figure_count > 0 -%}
            <ul class="k-benefitsband__figures k-benefitsband__figures--{{ section.settings.figures_style }}">
              {%- for block in section.blocks -%}
                {%- if block.type == 'figure' -%}
                  <li {{ block.shopify_attributes }}>
                    {%- if section.settings.figures_style == 'checks' -%}
                      <i class="fa-solid fa-circle-check k-benefitsband__figure-icon k-benefitsband__figure-icon--{{ section.settings.figure_icon_tone }}" aria-hidden="true"></i>
                    {%- endif -%}

                    <span class="k-benefitsband__value">{{ block.settings.value }}</span>
                    <span class="k-benefitsband__unit">{{ block.settings.label }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <a class="k-btn{% if section.settings.button_style == 'light' %} k-btn--light{% endif %} k-benefitsband__cta" href="{{ section.settings.button_link | default: source.url | default: '#' }}">
              {{ section.settings.button_label }}
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- else -%}
  {% render 'section-empty', message: "Bandeau bénéfices : ajoutez des blocs Bénéfice manuel ou sélectionnez un produit dont le champ méta kemia.benefits est renseigné." %}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} .k-benefitsband-section--banner {
    position: relative;
    width: 100vw;
    max-width: 100vw;
    min-height: var(--k-benefits-height, 420px);
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: clamp(34px, 4vw, 58px) 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    background-color: #071326;
    background-image:
      linear-gradient(
        rgba(5, 13, 28, var(--k-benefits-overlay, 0.25)),
        rgba(5, 13, 28, var(--k-benefits-overlay, 0.25))
      ),
      var(--k-benefits-bg-image, none);
    background-size: cover;
    background-position: var(--k-benefits-bg-position, center center);
    background-repeat: no-repeat;
  }

  #shopify-section-{{ section.id }} .k-benefitsband,
  #shopify-section-{{ section.id }} .k-benefitsband__content {
    width: 100%;
    margin: 0;
    padding: 0;
    color: #fff;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
  }

  #shopify-section-{{ section.id }} .k-benefitsband__content {
    max-width: 860px;
  }

  #shopify-section-{{ section.id }} .k-benefitsband__media {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .k-eyebrow,
  #shopify-section-{{ section.id }} .k-benefitsband__heading,
  #shopify-section-{{ section.id }} .k-benefitsband__intro,
  #shopify-section-{{ section.id }} .k-benefitsband__label,
  #shopify-section-{{ section.id }} .k-benefitsband__text,
  #shopify-section-{{ section.id }} .k-benefitsband__value,
  #shopify-section-{{ section.id }} .k-benefitsband__unit {
    color: inherit;
  }

  #shopify-section-{{ section.id }} .k-benefitsband__heading {
    max-width: 560px;
    margin-bottom: 0;
    color: #fff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.32);
  }

  #shopify-section-{{ section.id }} .k-benefitsband__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 20px);
    width: min(60vw, 720px);
    max-width: 60%;
    margin: clamp(24px, 3vw, 38px) 0 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .k-benefitsband__item {
    display: flex;
    flex-direction: column;
    align-items: center !important;
    justify-content: flex-start;
    gap: 10px;
    min-width: 0;
    padding: 0 !important;
    text-align: center !important;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
  }

  #shopify-section-{{ section.id }} .k-benefitsband__item::before,
  #shopify-section-{{ section.id }} .k-benefitsband__item::after,
  #shopify-section-{{ section.id }} .k-benefitsband__icon::before,
  #shopify-section-{{ section.id }} .k-benefitsband__icon::after {
    content: none !important;
    display: none !important;
  }

  #shopify-section-{{ section.id }} .k-benefitsband__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto !important;
    height: auto !important;
    min-width: 0 !important;
    min-height: 0 !important;
    padding: 0 !important;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    outline: 0 !important;
  }

  #shopify-section-{{ section.id }} .k-benefitsband__icon i {
    font-size: clamp(30px, 2.4vw, 42px);
    line-height: 1;
  }

  /* Une icone televersee occupe exactement la place d une icone de la
     liste, la meme mesure que le font-size ci-dessus. */
  #shopify-section-{{ section.id }} .k-benefitsband__icon-img {
    width: clamp(30px, 2.4vw, 42px);
    height: clamp(30px, 2.4vw, 42px);
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .k-benefitsband__icon--gold-metallic i,
  #shopify-section-{{ section.id }} .k-benefitsband__figure-icon--gold-metallic {
    background: linear-gradient(135deg, #fff1bf 0%, #d59a2f 30%, #8f5c13 52%, #f4d47b 72%, #b8791d 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent !important;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 1px 2px rgba(213, 154, 47, 0.32));
  }

  #shopify-section-{{ section.id }} .k-benefitsband__icon--blue-lightning-metallic i,
  #shopify-section-{{ section.id }} .k-benefitsband__figure-icon--blue-lightning-metallic {
    background: linear-gradient(135deg, #d8ecff 0%, #2d69bd 28%, #061a3d 52%, #7fb4ff 74%, #0b2f6f 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent !important;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 1px 3px rgba(11, 47, 111, 0.42));
  }

  #shopify-section-{{ section.id }} .k-benefitsband__label {
    display: block;
    width: 100%;
    min-width: 0;
    color: #fff;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.06em;
    text-align: center !important;
    text-transform: uppercase;
    white-space: normal;
    overflow-wrap: normal;
    word-break: normal;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.32);
  }

  #shopify-section-{{ section.id }} .k-benefitsband__text {
    display: block;
    width: 100%;
    color: #fff;
    opacity: 0.86;
    text-align: center !important;
  }

  #shopify-section-{{ section.id }} .k-benefitsband__figures {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(18px, 3vw, 38px);
    width: min(60vw, 720px);
    max-width: 60%;
    margin: clamp(22px, 2.8vw, 34px) 0 0;
    padding: 20px 0 0;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.26);
  }

  #shopify-section-{{ section.id }} .k-benefitsband__figures li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 0 !important;
    color: #fff;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
  }

  #shopify-section-{{ section.id }} .k-benefitsband__cta {
    margin-top: clamp(22px, 2.8vw, 32px);
  }

  #shopify-section-{{ section.id }} .k-benefitsband__cta i {
    margin-left: 8px;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .k-benefitsband__content,
    #shopify-section-{{ section.id }} .k-benefitsband__list,
    #shopify-section-{{ section.id }} .k-benefitsband__figures {
      width: 100%;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .k-benefitsband__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .k-benefitsband-section--banner {
      min-height: auto;
      padding: 46px 0;
    }

    #shopify-section-{{ section.id }} .k-benefitsband__list {
      gap: 22px 18px;
      margin-top: 24px;
    }

    #shopify-section-{{ section.id }} .k-benefitsband__item {
      align-items: center !important;
      text-align: center !important;
    }

    #shopify-section-{{ section.id }} .k-benefitsband__label,
    #shopify-section-{{ section.id }} .k-benefitsband__text {
      text-align: center !important;
    }

    #shopify-section-{{ section.id }} .k-benefitsband__icon i {
      font-size: 32px;
    }

    #shopify-section-{{ section.id }} .k-benefitsband__icon-img {
      width: 32px;
      height: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "Bandeau bénéfices",
  "class": "k-benefitsband-wrap",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit source",
      "info": "Utilisé uniquement si aucun bloc Bénéfice manuel n'est ajouté."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image de fond"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Position de l'image de fond",
      "options": [
        { "value": "center center", "label": "Centrée" },
        { "value": "center top", "label": "Haut" },
        { "value": "center bottom", "label": "Bas" },
        { "value": "right center", "label": "Droite" },
        { "value": "left center", "label": "Gauche" }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Hauteur de la bannière",
      "min": 300,
      "max": 560,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacité du voile sombre",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "select",
      "id": "icon_tone",
      "label": "Couleur par défaut des icônes du metafield",
      "options": [
        { "value": "gold-metallic", "label": "Doré métallique" },
        { "value": "blue-lightning-metallic", "label": "Bleu marine éclair métallique" }
      ],
      "default": "gold-metallic"
    },
    {
      "type": "select",
      "id": "figure_icon_tone",
      "label": "Couleur des icônes chiffres clés",
      "options": [
        { "value": "gold-metallic", "label": "Doré métallique" },
        { "value": "blue-lightning-metallic", "label": "Bleu marine éclair métallique" }
      ],
      "default": "gold-metallic"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Quatre bénéfices, une seule formule"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Titre",
      "default": "4 piliers essentiels.\nUne seule formule."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "checkbox",
      "id": "show_text",
      "label": "Afficher le texte sous chaque bénéfice",
      "default": true
    },
    {
      "type": "select",
      "id": "figures_style",
      "label": "Style des chiffres clés",
      "options": [
        { "value": "numbers", "label": "Grands chiffres" },
        { "value": "checks", "label": "Ligne de repères cochés" }
      ],
      "default": "checks"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton",
      "default": "Découvrir le produit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton",
      "info": "Vide : la fiche du produit source."
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style du bouton",
      "options": [
        { "value": "gold", "label": "Doré plein" },
        { "value": "light", "label": "Blanc" }
      ],
      "default": "gold"
    }
  ],
  "max_blocks": 16,
  "blocks": [
    {
      "type": "benefit",
      "name": "Bénéfice manuel",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Titre du bénéfice",
          "default": "Énergie & endurance"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte sous le bénéfice",
          "default": "Un soutien ciblé pour accompagner votre vitalité au quotidien."
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Icône téléversée",
          "info": "Remplace l'icône choisie ci-dessous, à la même taille. La couleur ne s'applique pas à une image téléversée."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icône Font Awesome",
          "options": [
            { "value": "none", "label": "Aucune" },
            { "value": "fa-bolt", "label": "Éclair" },
            { "value": "fa-brain", "label": "Cerveau" },
            { "value": "fa-dumbbell", "label": "Haltère" },
            { "value": "fa-shield-halved", "label": "Bouclier" },
            { "value": "fa-heart-pulse", "label": "Cœur" },
            { "value": "fa-moon", "label": "Lune" },
            { "value": "fa-bullseye", "label": "Cible" },
            { "value": "fa-capsules", "label": "Gélules" },
            { "value": "fa-clock", "label": "Horloge" },
            { "value": "fa-leaf", "label": "Feuille" },
            { "value": "fa-fire", "label": "Feu" },
            { "value": "fa-star", "label": "Étoile" },
            { "value": "fa-circle-check", "label": "Check" },
            { "value": "fa-atom", "label": "Atome" },
            { "value": "fa-flask", "label": "Fiole" },
            { "value": "fa-dna", "label": "ADN" },
            { "value": "fa-microscope", "label": "Microscope" }
          ],
          "default": "fa-bolt"
        },
        {
          "type": "select",
          "id": "icon_tone",
          "label": "Couleur de cette icône",
          "options": [
            { "value": "gold-metallic", "label": "Doré métallique" },
            { "value": "blue-lightning-metallic", "label": "Bleu marine éclair métallique" }
          ],
          "default": "gold-metallic"
        }
      ]
    },
    {
      "type": "figure",
      "name": "Chiffre clé",
      "settings": [
        { "type": "text", "id": "value", "label": "Chiffre", "default": "7" },
        { "type": "text", "id": "label", "label": "Libellé", "default": "actifs" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau bénéfices",
      "blocks": [
        { "type": "benefit", "settings": { "label": "Énergie & endurance", "text": "Un soutien ciblé pour accompagner votre vitalité au quotidien.", "icon": "fa-bolt", "icon_tone": "gold-metallic" } },
        { "type": "benefit", "settings": { "label": "Clarté mentale", "text": "Une formule pensée pour soutenir la concentration et la lucidité.", "icon": "fa-brain", "icon_tone": "blue-lightning-metallic" } },
        { "type": "benefit", "settings": { "label": "Vitalité physique", "text": "Des actifs sélectionnés pour accompagner l'énergie du corps.", "icon": "fa-dumbbell", "icon_tone": "gold-metallic" } },
        { "type": "benefit", "settings": { "label": "Bien-être intime", "text": "Un accompagnement complet pour l'équilibre masculin.", "icon": "fa-shield-halved", "icon_tone": "gold-metallic" } },
        { "type": "figure", "settings": { "value": "7", "label": "actifs" } },
        { "type": "figure", "settings": { "value": "2", "label": "gélules / jour" } },
        { "type": "figure", "settings": { "value": "30", "label": "jours" } }
      ]
    }
  ]
}
{% endschema %}