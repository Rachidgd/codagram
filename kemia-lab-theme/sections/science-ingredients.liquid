{%- liquid
  assign actifs = section.settings.product.metafields.kemia.ingredients.value

  assign block_actifs = 0
  for block in section.blocks
    if block.type == 'actif' and block.settings.name != blank
      assign block_actifs = block_actifs | plus: 1
    endif
  endfor

  if block_actifs > 0
    assign total = block_actifs
  else
    assign total = actifs.size | plus: 0
  endif

  assign heading = section.settings.heading
  if heading != blank
    if section.settings.show_count
      assign heading = total | append: ' ' | append: heading
    endif
    if section.settings.heading_prefix != blank
      assign heading = section.settings.heading_prefix | append: ' ' | append: heading
    endif
  endif
-%}

{%- if total > 0 -%}
  <section class="k-section{% if section.settings.background != 'none' %} k-bg-{{ section.settings.background }}{% endif %}">
    <div class="k-container">
      {%- if section.settings.eyebrow != blank or heading != blank or section.settings.intro != blank -%}
        <div class="k-section-head{% if section.settings.flanked %} k-section-head--flanked{% endif %}">
          {%- if section.settings.eyebrow != blank -%}
            <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if heading != blank -%}
            <h2 class="{% if section.settings.heading_style == 'display' %}k-h2 k-display{% elsif section.settings.heading_style == 'caps' %}k-title-caps k-h3{% else %}k-h2{% endif %}">
              <span>{{ heading }}</span>
            </h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <p class="k-section-head__text">{{ section.settings.intro }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ul class="k-sciactifs">
        {%- if block_actifs > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'actif' and block.settings.name != blank -%}
              {% render 'actif-card',
                attributes: block.shopify_attributes,
                image: block.settings.image,
                name: block.settings.name,
                amount: block.settings.amount,
                unit: block.settings.unit,
                detail: block.settings.detail,
                text: block.settings.text,
                tag_icon: block.settings.tag_icon,
                tag_label: block.settings.tag_label
              %}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for actif in actifs -%}
            {% render 'actif-card',
              image: actif.image.value,
              name: actif.name.value,
              amount: actif.amount.value,
              unit: actif.unit.value,
              detail: actif.detail.value,
              text: actif.description.value,
              tag_icon: 'sparkle',
              tag_label: actif.short_benefit.value
            %}
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {%- if section.settings.note != blank -%}
        <p class="k-sciactifs__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </section>
{%- else -%}
  {% render 'section-empty', message: "Zoom sur les actifs : ajoutez un bloc Actif, ou sélectionnez un produit dont le champ méta kemia.ingredients est renseigné." %}
{%- endif -%}

{% schema %}
{
  "name": "Zoom sur les actifs",
  "class": "k-sciactifs-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Ajoutez un bloc « Actif » par ingrédient pour régler ici le nom, le dosage, la description et l'image. Sans aucun bloc de ce type, les actifs du champ méta du produit ci-dessous prennent le relais."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produit source",
      "info": "Utilisé seulement si vous n'ajoutez aucun bloc « Actif »."
    },
    { "type": "header", "content": "Titre" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Début du titre",
      "info": "Placé avant le nombre, sur la même ligne. Par exemple : Zoom sur nos.",
      "default": "Zoom sur nos"
    },
    { "type": "text", "id": "heading", "label": "Suite du titre", "default": "actifs clés" },
    { "type": "checkbox", "id": "show_count", "label": "Insérer le nombre d'actifs", "default": true },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Style du titre",
      "options": [
        { "value": "caps", "label": "Majuscules" },
        { "value": "sans", "label": "Titres" },
        { "value": "display", "label": "Éditorial" }
      ],
      "default": "caps"
    },
    { "type": "checkbox", "id": "flanked", "label": "Filets dorés de part et d'autre du titre", "default": true },
    { "type": "text", "id": "intro", "label": "Texte d'introduction" },
    { "type": "text", "id": "note", "label": "Note de bas de section", "default": "*VNR : Valeurs Nutritionnelles de Référence" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "soft", "label": "Beige clair" },
        { "value": "beige", "label": "Beige" },
        { "value": "blue-tint", "label": "Bleu très clair" }
      ],
      "default": "none"
    }
  ],
  "max_blocks": 16,
  "blocks": [
    {
      "type": "actif",
      "name": "Actif",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Nom", "default": "Zinc" },
        { "type": "text", "id": "amount", "label": "Dosage", "default": "10" },
        { "type": "text", "id": "unit", "label": "Unité", "default": "mg" },
        { "type": "text", "id": "detail", "label": "Précision", "info": "Affichée sous le dosage, par exemple : 100 % VNR." },
        { "type": "textarea", "id": "text", "label": "Description" },
        {
          "type": "select",
          "id": "tag_icon",
          "label": "Pictogramme de l'étiquette",
          "options": [
            { "value": "none", "label": "Aucun" },
            { "value": "bolt", "label": "Éclair" },
            { "value": "brain", "label": "Cerveau" },
            { "value": "muscle", "label": "Vitalité" },
            { "value": "shield-star", "label": "Bien-être" },
            { "value": "shield-check", "label": "Bouclier" },
            { "value": "leaf", "label": "Feuille" },
            { "value": "molecule", "label": "Molécule" },
            { "value": "droplet", "label": "Goutte" },
            { "value": "sparkle", "label": "Étincelle" },
            { "value": "target", "label": "Cible" }
          ],
          "default": "sparkle"
        },
        { "type": "text", "id": "tag_label", "label": "Étiquette", "default": "Énergie & endurance" }
      ]
    }
  ],
  "presets": [
    { "name": "Zoom sur les actifs" }
  ]
}
{% endschema %}
