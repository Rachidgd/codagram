{%- liquid
  assign source = section.settings.product
  if source == blank and product != blank
    assign source = product
  endif
  assign ingredients = source.metafields.kemia.ingredients.value
  assign total = ingredients.size | plus: 0
  assign left_count = total | plus: 1 | divided_by: 2
  assign modal_id = 'k-orbit-composition-' | append: section.id
  assign center_image = section.settings.image
  if center_image == blank
    assign center_image = source.featured_image
  endif
-%}

{%- if total > 0 -%}
  <section class="k-section{% if section.settings.background == 'soft' %} k-bg-soft{% elsif section.settings.background == 'beige' %} k-bg-beige{% elsif section.settings.background == 'blue-tint' %} k-bg-blue-tint{% endif %}">
    <div class="k-container">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="k-section-head">
          {%- if section.settings.eyebrow != blank -%}
            <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="k-h2">
              {%- if section.settings.show_count -%}{{ total }} {% endif -%}
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
          {%- if section.settings.show_rule -%}<hr class="k-rule">{%- endif -%}
          {%- if section.settings.intro != blank -%}
            <p class="k-section-head__text">{{ section.settings.intro }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="k-orbit">
        <ul class="k-orbit__col k-orbit__col--left">
          {%- for item in ingredients limit: left_count -%}
            <li class="k-orbit__item">
              <span class="k-orbit__media">
                {% render 'actif-media', position: forloop.index, fallback: item.image.value, settings: section.settings %}
              </span>
              <span class="k-orbit__body">
                <span class="k-orbit__name">{{ item.name.value }}</span>
                {%- if item.short_benefit.value != blank -%}
                  <span class="k-orbit__benefit">{{ item.short_benefit.value }}</span>
                {%- endif -%}
                {%- if section.settings.show_dosage -%}
                  <span class="k-orbit__dose">{{ item.amount.value }}{% if item.unit.value != blank %} {{ item.unit.value }}{% endif %}</span>
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>

        <div class="k-orbit__center">
          <div class="k-orbit__product">
            {% render 'image', image: center_image, ratio: '100%', fit: 'contain', sizes: '(min-width: 990px) 320px, 60vw', loading: 'eager', placeholder_icon: 'bottle' %}
          </div>
          {%- if section.settings.center_label != blank -%}
            <p class="k-orbit__label">{{ section.settings.center_label }}</p>
          {%- endif -%}
        </div>

        <ul class="k-orbit__col k-orbit__col--right">
          {%- for item in ingredients offset: left_count -%}
            {%- assign position = forloop.index | plus: left_count -%}
            <li class="k-orbit__item">
              <span class="k-orbit__media">
                {% render 'actif-media', position: position, fallback: item.image.value, settings: section.settings %}
              </span>
              <span class="k-orbit__body">
                <span class="k-orbit__name">{{ item.name.value }}</span>
                {%- if item.short_benefit.value != blank -%}
                  <span class="k-orbit__benefit">{{ item.short_benefit.value }}</span>
                {%- endif -%}
                {%- if section.settings.show_dosage -%}
                  <span class="k-orbit__dose">{{ item.amount.value }}{% if item.unit.value != blank %} {{ item.unit.value }}{% endif %}</span>
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- if section.settings.composition_link != blank -%}
        <div class="k-orbit__actions">
          <button class="k-link" type="button" data-k-open="{{ modal_id }}" data-k-track="ingredient_interaction">
            {{ section.settings.composition_link }}
            {% render 'icon', name: 'arrow-right', class: 'k-icon--sm' %}
          </button>
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- if section.settings.composition_link != blank -%}
    <div class="k-modal" id="{{ modal_id }}" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ section.settings.composition_link | escape }}">
      <div class="k-modal__overlay" data-k-close></div>
      <div class="k-modal__dialog">
        <div class="k-modal__head">
          <h2 class="k-h4">{{ section.settings.composition_title }}</h2>
          <button class="k-modal__close" type="button" data-k-close aria-label="{{ 'general.close' | t }}" data-k-autofocus>
            {% render 'icon', name: 'close' %}
          </button>
        </div>
        <div class="k-modal__body">
          <ul class="k-composition">
            {%- for item in ingredients -%}
              <li class="k-composition__item">
                <div class="k-composition__media">
                  {% render 'image', image: item.image.value, ratio: '100%', fit: 'contain', sizes: '72px', placeholder_icon: 'leaf' %}
                </div>
                <div class="k-composition__body">
                  <div class="k-composition__head">
                    <h3 class="k-composition__name">{{ item.name.value }}</h3>
                    <span class="k-composition__dose">{{ item.amount.value }}{% if item.unit.value != blank %} {{ item.unit.value }}{% endif %}</span>
                  </div>
                  {%- if item.detail.value != blank -%}
                    <p class="k-composition__detail">{{ item.detail.value }}</p>
                  {%- endif -%}
                  {%- if item.description.value != blank -%}
                    <p class="k-composition__text">{{ item.description.value }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  {%- endif -%}
{%- else -%}
  {% render 'section-empty', message: "Actifs autour du produit : sélectionnez un produit dont le champ méta kemia.ingredients est renseigné." %}
{%- endif -%}

{% schema %}
{
  "name": "Actifs autour du produit",
  "class": "k-orbit-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit source",
      "info": "Les actifs et leurs bénéfices proviennent du champ méta kemia.ingredients. Sur une fiche produit, laisser vide."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "La formule en détail"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "actifs autour d'une seule formule"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Préfixer le titre par le nombre d'actifs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Filet doré",
      "default": true
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "header",
      "content": "Visuel central"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image du produit",
      "info": "Vide : l'image principale du produit."
    },
    {
      "type": "text",
      "id": "center_label",
      "label": "Légende sous le visuel"
    },
    {
      "type": "header",
      "content": "Actifs"
    },
    {
      "type": "checkbox",
      "id": "show_dosage",
      "label": "Afficher le dosage",
      "default": true
    },
    {
      "type": "header",
      "content": "Composition complète"
    },
    {
      "type": "text",
      "id": "composition_link",
      "label": "Libellé du lien",
      "default": "Voir la composition complète"
    },
    {
      "type": "text",
      "id": "composition_title",
      "label": "Titre de la fenêtre",
      "default": "Composition complète"
    },
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "type": "header",
      "content": "Images des actifs",
      "info": "Une image par actif, dans l'ordre d'affichage. Vide, l'image de la fiche actif est utilisée."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Actif 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Actif 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Actif 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Actif 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Actif 5"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Actif 6"
    },
    {
      "type": "image_picker",
      "id": "image_7",
      "label": "Actif 7"
    },
    {
      "type": "image_picker",
      "id": "image_8",
      "label": "Actif 8"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "soft",
          "label": "Beige clair"
        },
        {
          "value": "beige",
          "label": "Beige"
        },
        {
          "value": "blue-tint",
          "label": "Bleu très clair"
        }
      ],
      "default": "soft"
    }
  ],
  "presets": [
    {
      "name": "Actifs autour du produit"
    }
  ]
}
{% endschema %}
