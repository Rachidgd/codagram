{%- liquid
  assign cat_list = ''
  for block in section.blocks
    assign c = block.settings.category
    unless c == blank
      assign existing = cat_list | split: '~~'
      unless existing contains c
        if cat_list == blank
          assign cat_list = c
        else
          assign cat_list = cat_list | append: '~~' | append: c
        endif
      endunless
    endunless
  endfor
  assign categories = cat_list | split: '~~'
  assign use_tabs = false
  if section.settings.show_tabs and categories.size > 1
    assign use_tabs = true
  endif
  if use_tabs and section.settings.show_all_tab
    assign default_category = '*'
  else
    assign default_category = categories.first
  endif
-%}

<section class="k-section{% if section.settings.background != 'none' %} k-bg-{{ section.settings.background }}{% endif %}">
  <div class="k-container{% unless use_tabs %} k-container--narrow{% endunless %}" data-k-filter>
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="k-section-head k-faq__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="k-title-caps k-h3">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.show_rule -%}<hr class="k-rule">{%- endif -%}
      </div>
    {%- endif -%}

    {%- if use_tabs -%}
      <div class="k-tabs k-faq__tabs" role="tablist">
        {%- if section.settings.show_all_tab -%}
          <button class="k-tab is-active" type="button" role="tab" data-k-filter-value="*" aria-pressed="true">
            {{ section.settings.all_tab_label }}
          </button>
        {%- endif -%}
        {%- for category in categories -%}
          {%- liquid
            assign cat_icon = ''
            for block in section.blocks
              if block.settings.category == category and block.settings.icon != 'none'
                assign cat_icon = block.settings.icon
                break
              endif
            endfor
          -%}
          <button
            class="k-tab{% if default_category == category %} is-active{% endif %}"
            type="button"
            role="tab"
            data-k-filter-value="{{ category | escape }}"
            aria-pressed="{% if default_category == category %}true{% else %}false{% endif %}"
          >
            {%- if cat_icon != blank -%}{% render 'icon', name: cat_icon, class: 'k-icon--sm' %}{%- endif -%}
            {{ category }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="k-accordion{% if section.settings.style == 'card' %} k-accordion--card{% endif %} k-faq__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign visible = true
          if use_tabs and default_category != '*' and block.settings.category != default_category
            assign visible = false
          endif
        -%}
        <details
          class="k-accordion__item"
          data-k-filter-item="{{ block.settings.category | escape }}"
          {% unless visible %}hidden{% endunless %}
          {{ block.shopify_attributes }}
        >
          <summary class="k-accordion__summary">
            <span>{{ block.settings.question }}</span>
            <span class="k-accordion__icon" aria-hidden="true"></span>
          </summary>
          <div class="k-accordion__panel k-text">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
      <p class="k-form-note" data-k-filter-empty hidden>Aucune question dans cette catégorie.</p>
    </div>

    {%- if section.settings.link_label != blank -%}
      <div class="k-faq__link">
        <a class="k-link" href="{{ section.settings.link_url }}">
          {{ section.settings.link_label }}
          {% render 'icon', name: 'arrow-right', class: 'k-icon--sm' %}
        </a>
      </div>
    {%- endif -%}

    {%- if section.settings.show_contact_card -%}
      <div class="k-faq__contact">
        <span class="k-faq__contact-icon">{% render 'icon', name: 'headset', class: 'k-icon--xl' %}</span>
        <div class="k-faq__contact-body">
          {%- if section.settings.contact_heading != blank -%}
            <h3 class="k-h4">{{ section.settings.contact_heading }}</h3>
          {%- endif -%}
          {%- if section.settings.contact_text != blank -%}
            <p class="k-text">{{ section.settings.contact_text }}</p>
          {%- endif -%}
          {%- if section.settings.contact_label != blank -%}
            <a class="k-btn k-btn--outline" href="{{ section.settings.contact_url }}">{{ section.settings.contact_label }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "class": "k-faq-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Vos questions, nos réponses" },
    { "type": "checkbox", "id": "show_rule", "label": "Filet doré sous le titre", "default": true },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "line", "label": "Filets" },
        { "value": "card", "label": "Cartes" }
      ],
      "default": "card"
    },
    { "type": "checkbox", "id": "show_tabs", "label": "Afficher les onglets de catégories", "default": false },
    { "type": "checkbox", "id": "show_all_tab", "label": "Ajouter un onglet Tous", "default": false },
    { "type": "text", "id": "all_tab_label", "label": "Libellé de l'onglet Tous", "default": "Toutes" },
    { "type": "text", "id": "link_label", "label": "Lien sous la liste" },
    { "type": "url", "id": "link_url", "label": "Cible du lien" },
    { "type": "header", "content": "Encart contact" },
    { "type": "checkbox", "id": "show_contact_card", "label": "Afficher l'encart", "default": false },
    { "type": "text", "id": "contact_heading", "label": "Titre", "default": "Vous ne trouvez pas la réponse à votre question ?" },
    { "type": "text", "id": "contact_text", "label": "Texte", "default": "Notre service client est là pour vous aider." },
    { "type": "text", "id": "contact_label", "label": "Bouton", "default": "Nous contacter" },
    { "type": "url", "id": "contact_url", "label": "Lien du bouton" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "soft", "label": "Beige clair" },
        { "value": "beige", "label": "Beige" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "category", "label": "Catégorie", "info": "Les questions partageant la même catégorie sont regroupées sous le même onglet." },
        {
          "type": "select",
          "id": "icon",
          "label": "Pictogramme de la catégorie",
          "options": [
            { "value": "none", "label": "Aucun" },
            { "value": "bag", "label": "Produits" },
            { "value": "user", "label": "Utilisation" },
            { "value": "truck", "label": "Livraison" },
            { "value": "lock", "label": "Paiement" },
            { "value": "package", "label": "Retours" },
            { "value": "capsule", "label": "Gélule" },
            { "value": "leaf", "label": "Feuille" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "question", "label": "Question", "default": "Votre question" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Votre réponse.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
