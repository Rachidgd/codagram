{%- if section.blocks.size > 0 -%}
  <section class="k-section{% if section.settings.background == 'soft' %} k-bg-soft{% elsif section.settings.background == 'beige' %} k-bg-beige{% elsif section.settings.background == 'blue-tint' %} k-bg-blue-tint{% endif %}">
    <div class="k-container">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="k-section-head">
          {%- if section.settings.eyebrow != blank -%}
            <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="k-title-caps k-h3">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.show_rule -%}<hr class="k-rule">{%- endif -%}
          {%- if section.settings.intro != blank -%}
            <p class="k-section-head__text">{{ section.settings.intro }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ol class="k-steps">
        {%- for block in section.blocks -%}
          <li class="k-step" {{ block.shopify_attributes }}>
            <span class="k-step__number" aria-hidden="true">{{ forloop.index }}</span>
            {%- if block.settings.title != blank -%}
              <h3 class="k-step__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="k-step__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>

      {%- if section.settings.note != blank -%}
        <p class="k-steps__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </section>
{%- else -%}
  {% render 'section-empty', message: "Mode d'emploi : ajoutez au moins une étape." %}
{%- endif -%}

{% schema %}
{
  "name": "Mode d'emploi",
  "class": "k-steps-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "En pratique" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Une routine qui tient en trois gestes" },
    { "type": "checkbox", "id": "show_rule", "label": "Filet doré", "default": true },
    { "type": "text", "id": "intro", "label": "Introduction" },
    { "type": "text", "id": "note", "label": "Mention sous les étapes" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "soft", "label": "Beige clair" },
        { "value": "beige", "label": "Beige" },
        { "value": "blue-tint", "label": "Bleu très clair" }
      ],
      "default": "none"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mode d'emploi",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}
