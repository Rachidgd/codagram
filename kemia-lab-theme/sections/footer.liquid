<footer class="k-footer" style="background: {{ section.settings.background }}">
  <div class="k-container">
    <div class="k-footer__grid">
      <div class="k-footer__brand">
        <a class="k-header__logo" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name | default: shop.name | escape }}">
          {% render 'logo', logo_width: 170, logo_height: 56, background: section.settings.background %}
        </a>
        {%- if section.settings.brand_text != blank -%}
          <p class="k-footer__brand-text">{{ section.settings.brand_text }}</p>
        {%- endif -%}
        {% render 'social-links', class: 'k-footer__social' %}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <nav class="k-footer__col" {{ block.shopify_attributes }} aria-label="{{ block.settings.heading | escape }}">
              {%- if block.settings.heading != blank -%}
                <h2 class="k-footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              <ul class="k-footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- when 'newsletter' -%}
            <div class="k-footer__col k-footer__newsletter" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="k-footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="k-footer__newsletter-text">{{ block.settings.text }}</p>
              {%- endif -%}
              {% form 'customer', class: 'k-footer__form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="k-visually-hidden" for="footer-email">{{ block.settings.placeholder }}</label>
                <input
                  class="k-input"
                  id="footer-email"
                  type="email"
                  name="contact[email]"
                  placeholder="{{ block.settings.placeholder | escape }}"
                  autocomplete="email"
                  required
                >
                <button class="k-btn" type="submit" data-k-track="email_submitted">{{ block.settings.button_label }}</button>
                {%- if form.posted_successfully? -%}
                  <p class="k-form-message k-form-message--success">{{ 'general.newsletter.success' | t }}</p>
                {%- elsif form.errors -%}
                  <p class="k-form-message k-form-message--error">{{ 'general.newsletter.error' | t }}</p>
                {%- endif -%}
              {% endform %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="k-footer__bottom">
      <p class="k-footer__copy">{{ section.settings.copyright }}</p>
      {%- if section.settings.legal_menu != blank -%}
        <ul class="k-footer__legal">
          {%- for link in section.settings.legal_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "class": "k-footer-section",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Fond",
      "default": "#F8F1E9"
    },
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Texte sous le logo",
      "default": "Des formules pensées avec la science et la nature pour révéler votre potentiel."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Liens légaux",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Mention de bas de page",
      "default": "© 2026 KEMIA LAB - Tous droits réservés"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonne de liens",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Produit"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Modifiable dans Boutique en ligne, Navigation."
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Newsletter"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Recevez nos conseils et nouveautés."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Champ email",
          "default": "Votre email"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Bouton",
          "default": "S'inscrire"
        }
      ]
    }
  ]
}
{% endschema %}
