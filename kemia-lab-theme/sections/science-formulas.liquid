<section class="k-section{% if section.settings.background != 'none' %} k-bg-{{ section.settings.background }}{% endif %}">
  <div class="k-container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="k-section-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="k-h2{% if section.settings.heading_style == 'display' %} k-display{% endif %}">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="k-formulas">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'formula' -%}
            {%- assign item = block.settings.product -%}
            {%- if item != blank -%}
              <article class="k-formula" {{ block.shopify_attributes }}>
                <div class="k-formula__media">
                  {% render 'image', image: block.settings.image, ratio: '100%', fit: 'contain', sizes: '(min-width: 750px) 240px, 60vw', placeholder_icon: 'bottle' %}
                </div>
                <div class="k-formula__body">
                  <h3 class="k-h3 k-formula__title">{{ item.title }}</h3>
                  {%- assign tagline = item.metafields.kemia.tagline.value -%}
                  {%- if tagline != blank -%}
                    <p class="k-formula__tagline">{{ tagline }}</p>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="k-formula__text">{{ block.settings.text }}</p>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank -%}
                    <a class="k-link k-link--caps" href="{{ item.url }}">
                      {{ block.settings.button_label }}
                      {% render 'icon', name: 'arrow-right', class: 'k-icon--sm' %}
                    </a>
                  {%- endif -%}
                </div>
              </article>
            {%- endif -%}

          {%- when 'upcoming' -%}
            <article class="k-formula k-formula--upcoming" {{ block.shopify_attributes }}>
              <div class="k-formula__placeholder">{% render 'icon', name: 'bottle', class: 'k-icon--xl' %}</div>
              {%- if block.settings.badge != blank -%}
                <span class="k-badge k-badge--blue">{{ block.settings.badge }}</span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="k-formula__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nos formules",
  "class": "k-formulas-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Découvrez la science derrière nos formules" },
    { "type": "text", "id": "heading", "label": "Titre" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Style du titre",
      "options": [
        { "value": "sans", "label": "Titres" },
        { "value": "display", "label": "Éditorial" }
      ],
      "default": "display"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "soft", "label": "Beige clair" },
        { "value": "beige", "label": "Beige" }
      ],
      "default": "soft"
    }
  ],
  "blocks": [
    {
      "type": "formula",
      "name": "Formule",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "image_picker", "id": "image", "label": "Visuel" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "7 actifs sélectionnés pour soutenir votre énergie, votre bien-être et vos performances au quotidien." },
        { "type": "text", "id": "button_label", "label": "Lien", "default": "Découvrir la formule" }
      ]
    },
    {
      "type": "upcoming",
      "name": "Formule à venir",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge", "default": "Bientôt" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "De nouvelles formules scientifiquement élaborées arrivent bientôt. Restez connectés." }
      ]
    }
  ],
  "presets": [{ "name": "Nos formules" }]
}
{% endschema %}
