{%- liquid
  assign formulas = 0
  for block in section.blocks
    if block.type == 'formula'
      assign formulas = formulas | plus: 1
    endif
  endfor
-%}

<section class="k-section{% if section.settings.background != 'none' %} k-bg-{{ section.settings.background }}{% endif %}">
  <div class="k-container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="k-section-head{% if section.settings.flanked %} k-section-head--flanked{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="k-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="{% if section.settings.heading_style == 'display' %}k-h2 k-display{% elsif section.settings.heading_style == 'caps' %}k-title-caps k-h3{% else %}k-h2{% endif %}">
            <span>{{ section.settings.heading }}</span>
          </h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="k-section-head__text">{{ section.settings.intro }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if formulas > 0 -%}
      <div class="k-formulas k-carousel" data-k-rail>
        {%- if formulas > 1 -%}
          <button class="k-carousel__nav k-formulas__nav k-formulas__nav--prev" type="button" data-k-rail-prev aria-label="{{ section.settings.prev_label }}">
            {% render 'icon', name: 'chevron-left', class: 'k-icon--sm' %}
          </button>
        {%- endif -%}

        <div class="k-formulas__track k-rail k-rail--1" data-k-rail-track>
          {%- for block in section.blocks -%}
            {%- if block.type == 'formula' -%}
              {%- liquid
                assign item = block.settings.product
                assign title = block.settings.heading
                if title == blank
                  assign title = item.title
                endif
                assign link = block.settings.button_link
                if link == blank
                  assign link = item.url
                endif
                assign pillars = item.metafields.kemia.benefits.value
                assign pillar_count = pillars.size | plus: 0
              -%}
              <article class="k-formula" {{ block.shopify_attributes }}>
                <div class="k-formula__media">
                  {% render 'image',
                    image: block.settings.image,
                    ratio: '100%',
                    fit: 'contain',
                    sizes: '(min-width: 990px) 260px, 60vw',
                    placeholder_icon: 'bottle'
                  %}
                </div>

                <div class="k-formula__body">
                  {%- if block.settings.badge != blank -%}
                    <span class="k-badge k-badge--gold k-formula__badge">{{ block.settings.badge }}</span>
                  {%- endif -%}

                  {%- if title != blank -%}
                    <h3 class="k-title-caps k-h3 k-formula__title">{{ title }}</h3>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <p class="k-formula__text">{{ block.settings.text | newline_to_br }}</p>
                  {%- endif -%}

                  {%- if pillar_count > 0 -%}
                    <ul class="k-formula__pillars">
                      {%- for pillar in pillars -%}
                        <li class="k-formula__pillar">
                          <span class="k-formula__pillar-icon">
                            {% render 'icon', name: pillar.icon.value, class: 'k-icon--lg' %}
                          </span>
                          <span class="k-formula__pillar-label">{{ pillar.label.value }}</span>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  {%- if block.settings.button_label != blank and link != blank -%}
                    <a class="k-btn k-btn--navy k-formula__cta" href="{{ link }}">
                      {{ block.settings.button_label }}
                      {% render 'icon', name: 'arrow-right', class: 'k-icon--sm' %}
                    </a>
                  {%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if formulas > 1 -%}
          <button class="k-carousel__nav k-formulas__nav k-formulas__nav--next" type="button" data-k-rail-next aria-label="{{ section.settings.next_label }}">
            {% render 'icon', name: 'chevron-right', class: 'k-icon--sm' %}
          </button>

          <div class="k-carousel__dots k-formulas__dots" data-k-rail-dots></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'upcoming' -%}
        {%- unless block.settings.heading == blank and block.settings.text == blank -%}
          <aside class="k-upcoming" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="k-upcoming__icon">{% render 'icon', name: block.settings.icon, class: 'k-icon--lg' %}</span>
            {%- endif -%}
            <div class="k-upcoming__body">
              {%- if block.settings.heading != blank -%}
                <p class="k-upcoming__title">{{ block.settings.heading }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="k-upcoming__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.button_label != blank -%}
              <a class="k-btn k-btn--outline k-upcoming__cta" href="{{ block.settings.button_link }}">
                {{ block.settings.button_label }}
                {% render 'icon', name: 'arrow-right', class: 'k-icon--sm' %}
              </a>
            {%- endif -%}
          </aside>
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Nos formules",
  "class": "k-formulas-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "La science derrière nos formules" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Style du titre",
      "options": [
        { "value": "caps", "label": "Majuscules" },
        { "value": "sans", "label": "Titres" },
        { "value": "display", "label": "Éditorial" }
      ],
      "default": "caps"
    },
    { "type": "checkbox", "id": "flanked", "label": "Filets dorés de part et d'autre du titre", "default": true },
    { "type": "text", "id": "intro", "label": "Texte d'introduction" },
    { "type": "text", "id": "prev_label", "label": "Bouton précédent", "default": "Formule précédente" },
    { "type": "text", "id": "next_label", "label": "Bouton suivant", "default": "Formule suivante" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "soft", "label": "Beige clair" },
        { "value": "beige", "label": "Beige" },
        { "value": "blue-tint", "label": "Bleu très clair" }
      ],
      "default": "none"
    }
  ],
  "max_blocks": 10,
  "blocks": [
    {
      "type": "formula",
      "name": "Formule",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produit",
          "info": "Les quatre piliers affichés proviennent du champ méta kemia.benefits du produit."
        },
        { "type": "image_picker", "id": "image", "label": "Visuel" },
        { "type": "text", "id": "badge", "label": "Étiquette", "default": "Notre formule phare" },
        { "type": "text", "id": "heading", "label": "Titre", "info": "Vide : le nom du produit." },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir la science de cette formule" },
        { "type": "url", "id": "button_link", "label": "Lien du bouton", "info": "Vide : la fiche du produit." }
      ]
    },
    {
      "type": "upcoming",
      "name": "Bandeau formules à venir",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Pictogramme",
          "options": [
            { "value": "none", "label": "Aucun" },
            { "value": "leaf", "label": "Feuille" },
            { "value": "sparkle", "label": "Étincelle" },
            { "value": "flask", "label": "Fiole" },
            { "value": "molecule", "label": "Molécule" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "heading", "label": "Titre", "default": "D'autres formules arrivent bientôt" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Restez connectés, de nouvelles solutions naturelles et scientifiques sont en préparation pour vous accompagner encore plus loin." },
        { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir nos produits" },
        { "type": "url", "id": "button_link", "label": "Lien du bouton" }
      ]
    }
  ],
  "presets": [{ "name": "Nos formules" }]
}
{% endschema %}
