{%- liquid
  assign surface = section.settings.surface | default: 'paper'
  assign surface_class = 'surface-paper'
  assign surface_attr = 'paper'
  if surface == 'dark'
    assign surface_class = 'surface-dark'
    assign surface_attr = 'dark'
  elsif surface == 'deep'
    assign surface_class = 'surface-deep'
    assign surface_attr = 'dark'
  endif
-%}

<section class="cc-split {{ surface_class }} section-y" data-surface="{{ surface_attr }}">
  <div class="shell cc-split__grid{% if section.settings.reverse %} cc-split__grid--rev{% endif %}">

    <div class="cc-split__copy" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="cc-split__title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="cc-split__text prose-cc">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="btn btn--solid cc-split__cta" href="{{ section.settings.cta_url | default: routes.root_url }}">
          {{ section.settings.cta_label }}{%- render 'icon', name: 'arrow', size: 15 -%}
        </a>
      {%- endif -%}
    </div>

    <div class="cc-split__side" data-reveal>
      {%- if section.settings.image != blank -%}
        <div class="cc-split__media">
          {{ section.settings.image
            | image_url: width: 1200
            | image_tag:
              widths: '400,600,800,1000,1200',
              sizes: '(max-width: 899px) 92vw, 46vw',
              loading: 'lazy',
              alt: section.settings.image_alt | default: section.settings.title
          }}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="cc-split__list" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="cc-split__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span>
                <strong>{{ block.settings.title }}</strong>
                {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contenu — Deux colonnes",
  "settings": [
    {
      "type": "select", "id": "surface", "label": "Fond", "default": "paper",
      "options": [
        { "value": "paper", "label": "Clair" },
        { "value": "dark", "label": "Graphite" },
        { "value": "deep", "label": "Graphite profond" }
      ]
    },
    { "type": "checkbox", "id": "reverse", "label": "Inverser les colonnes", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "title", "label": "Titre" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "cta_label", "label": "Libellé du bouton" },
    { "type": "url", "id": "cta_url", "label": "Lien du bouton" },
    { "type": "image_picker", "id": "image", "label": "Visuel (optionnel)" },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif du visuel" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [{ "name": "Contenu — Deux colonnes" }]
}
{% endschema %}
