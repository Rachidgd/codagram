<article class="cc-article">
  <header class="cc-pagehead surface-dark" data-surface="dark">
    <span class="grid-field" aria-hidden="true"></span>
    <div class="shell">
      <nav aria-label="Fil d'Ariane">
        <ol class="cc-crumb" role="list">
          <li><a href="{{ routes.root_url }}">Accueil</a></li>
          <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
          <li aria-current="page">{{ article.title }}</li>
        </ol>
      </nav>

      <h1 class="cc-pagehead__title" data-reveal>{{ article.title }}</h1>

      <p class="cc-article__meta" data-reveal>
        {%- assign maj = article.metafields.editorial.updated_at.value -%}
        {%- assign jour_maj = maj | date: '%Y-%m-%d' -%}
        {%- assign jour_pub = article.published_at | date: '%Y-%m-%d' -%}
        {%- if maj != blank and jour_maj != jour_pub -%}
          <time datetime="{{ jour_maj }}">Mis à jour le {{ maj | date: '%d.%m.%Y' }}</time>
        {%- else -%}
          <time datetime="{{ jour_pub }}">Publié le {{ article.published_at | date: '%d.%m.%Y' }}</time>
        {%- endif -%}
        {%- if article.author != blank -%}<span>·</span><span>{{ article.author }}</span>{%- endif -%}
        {%- if article.content != blank -%}
          {%- assign words = article.content | strip_html | split: ' ' | size | divided_by: 220 | plus: 1 -%}
          <span>·</span><span>{{ words }} min de lecture</span>
        {%- endif -%}
      </p>
    </div>
  </header>

  <div class="surface-paper section-y" data-surface="paper">
    <div class="shell cc-article__grid">
      <div class="cc-article__body prose-cc" data-reveal>
        {{ article.content }}
      </div>
    </div>
  </div>

  {%- liquid
    assign presta_url = ''
    if article.tags contains 'SEO local'
      assign presta_url = '/pages/seo-local'
      assign presta_titre = 'Être trouvé par les clients qui sont déjà à côté de vous.'
      assign presta_texte = "Nous travaillons la proximité, la cohérence de vos informations et votre réputation, dans cet ordre."
    elsif article.tags contains 'SEO e-commerce'
      assign presta_url = '/pages/seo-ecommerce'
      assign presta_titre = 'Vos acheteurs arrivent par les catégories.'
      assign presta_texte = "Nous construisons cette architecture avant d'écrire quoi que ce soit : c'est elle qui capte le trafic qui achète."
    elsif article.tags contains 'Audit SEO'
      assign presta_url = '/pages/audit-seo'
      assign presta_titre = 'Repartez avec trois priorités chiffrées.'
      assign presta_texte = "Technique, structure sémantique et concurrence, puis un ordre d'exécution. Pas une liste de deux cents points."
    elsif article.tags contains 'Site vitrine' or article.tags contains 'Création de site'
      assign presta_url = '/pages/creation-site-vitrine'
      assign presta_titre = 'Un site vitrine qui vous amène des demandes chaque semaine.'
      assign presta_texte = "Écrit et développé pour votre activité. Il charge vite, il explique votre offre, et vous le modifiez sans nous."
    elsif article.tags contains 'Shopify' or article.tags contains 'E-commerce'
      assign presta_url = '/pages/agence-shopify'
      assign presta_titre = 'Une boutique qui charge vite et qui vend mieux sur mobile.'
      assign presta_texte = "Fiche produit, panier et paiement repris un par un, sans empiler des applications qui ralentissent tout."
    elsif article.tags contains 'Meta Ads' or article.tags contains 'Publicité' or article.tags contains 'Créatives' or article.tags contains 'Analyse concurrentielle'
      assign presta_url = '/pages/expert-meta-ads'
      assign presta_titre = 'Des campagnes pilotées sur ce qu&#39;elles vous rapportent.'
      assign presta_texte = "Offre, page d'arrivée et suivi vérifiés avant la première dépense, puis pilotage sur la marge."
    elsif article.tags contains 'CRO' or article.tags contains 'Conversion'
      assign presta_url = '/pages/optimisation-cro'
      assign presta_titre = 'Le même trafic, plus de demandes.'
      assign presta_texte = "Nous trouvons où vos visiteurs abandonnent, puis nous retirons une à une les raisons d'hésiter."
    else
      assign presta_url = '/pages/agence-seo'
      assign presta_titre = 'Recevez chaque mois des demandes venues de Google.'
      assign presta_texte = "Nous repérons les recherches qui précèdent un achat, nous plaçons vos pages dessus, et nous les rendons capables de déclencher un appel."
    endif
  -%}

  {%- if presta_url != blank -%}
    <section class="cc-artcta surface-paper section-y" data-surface="paper">
      <div class="shell cc-artcta__inner" data-reveal>
        <div>
          <p class="eyebrow">La prestation liée</p>
          <h2 class="cc-artcta__title">{{ presta_titre }}</h2>
          <p class="cc-artcta__text">{{ presta_texte }}</p>
        </div>
        <a class="btn btn--primary btn--lg" href="{{ presta_url }}">
          Voir la prestation{%- render 'icon', name: 'arrow', size: 15 -%}
        </a>
      </div>
    </section>
  {%- endif -%}

  {%- if blog.articles.size > 1 -%}
    <section class="surface-dark section-y" data-surface="dark">
      <div class="shell">
        <div class="cc-head-block" data-reveal>
          <p class="eyebrow">Poursuivre</p>
          <h2>Autres guides</h2>
        </div>
        <div class="cc-posts">
          {%- assign shown = 0 -%}
          {%- for other in blog.articles -%}
            {%- if other.id != article.id and shown < 3 -%}
              {%- assign shown = shown | plus: 1 -%}
              <a class="cc-post card card--hover" href="{{ other.url }}" data-reveal>
                <p class="cc-post__meta">
                  <time datetime="{{ other.published_at | date: '%Y-%m-%d' }}">{{ other.published_at | date: '%d.%m.%Y' }}</time>
                </p>
                <h3 class="cc-post__title">{{ other.title }}</h3>
                <span class="cc-post__go">Lire{%- render 'icon', name: 'arrow', size: 14 -%}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</article>

{% schema %}
{ "name": "Guide — Contenu", "settings": [] }
{% endschema %}
