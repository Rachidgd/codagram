<section class="cc-method surface-dark section-y" data-surface="dark">
  <div class="shell cc-method__grid" data-timeline>

    <div class="cc-method__aside">
      <div class="cc-method__sticky" data-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="cc-method__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="tlink" href="{{ section.settings.link | default: routes.root_url }}">
            {{ section.settings.link_label }}{%- render 'icon', name: 'arrow', size: 14 -%}
          </a>
        {%- endif -%}
      </div>
    </div>

    <ol class="cc-method__steps" role="list">
      <span class="cc-method__rail" aria-hidden="true"><i data-timeline-line></i></span>

      {%- for block in section.blocks -%}
        <li class="cc-step" data-timeline-step data-reveal {{ block.shopify_attributes }}>
          <span class="cc-step__node" aria-hidden="true"></span>
          <div class="cc-step__body">
            <p class="cc-step__index">Étape {{ forloop.index }}</p>
            <h3 class="cc-step__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="cc-step__text">{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.tags != blank -%}
              <ul class="cc-step__tags" role="list">
                {%- assign tags = block.settings.tags | split: '|' -%}
                {%- for tag in tags -%}<li>{{ tag | strip }}</li>{%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if block.settings.deliverable != blank -%}
              <p class="cc-step__out"><span>Vous recevez —</span> {{ block.settings.deliverable }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Accueil — Méthode",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Comment nous travaillons" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Une équipe unique, du diagnostic à la mesure." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Pas de sous-traitance en cascade, pas de livrable qui change de mains à chaque étape. Stratégie, rédaction, design, développement et mesure avancent ensemble." },
    { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Notre façon de travailler" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Identifier la vraie contrainte" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "tags", "label": "Étiquettes (séparées par |)", "default": "Audit|Données|Priorisation" },
        { "type": "text", "id": "deliverable", "label": "Livrable" }
      ]
    }
  ],
  "presets": [{ "name": "Accueil — Méthode" }]
}
{% endschema %}
