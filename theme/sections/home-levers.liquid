<section class="cc-levers surface-dark section-y" data-surface="dark">
  <div class="shell">

    <div class="cc-head-block cc-head-block--split" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.title }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <p class="cc-head-block__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <ol class="cc-levers__list" role="list">
      {%- for block in section.blocks -%}
        <li class="cc-lever" data-reveal {{ block.shopify_attributes }}>
          <a class="cc-lever__link" href="{{ block.settings.link | default: routes.root_url }}">
            <span class="cc-lever__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>

            <span class="cc-lever__ico">{%- render 'icon', name: block.settings.icon, size: 18 -%}</span>

            <span class="cc-lever__main">
              <span class="cc-lever__eyebrow">{{ block.settings.eyebrow }}</span>
              <span class="cc-lever__title">{{ block.settings.title }}</span>
            </span>

            <span class="cc-lever__text">{{ block.settings.text }}</span>

            <span class="cc-lever__go">
              <span>{{ block.settings.link_label | default: 'Découvrir' }}</span>
              {%- render 'icon', name: 'arrow', size: 15 -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Accueil — Leviers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Cinq leviers, un ordre" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nous n'activons que ce qui déplace votre chiffre." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Un levier mal séquencé coûte du budget sans rien produire. Nous commençons toujours par celui qui lève la contrainte la plus haute." }
  ],
  "blocks": [
    {
      "type": "lever",
      "name": "Levier",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Catégorie", "default": "Trafic organique" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Référencement naturel" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        {
          "type": "select", "id": "icon", "label": "Pictogramme", "default": "signal",
          "options": [
            { "value": "signal", "label": "Signal / SEO" },
            { "value": "layers", "label": "Site sur mesure" },
            { "value": "cart", "label": "E-commerce" },
            { "value": "gauge", "label": "Conversion" },
            { "value": "megaphone", "label": "Publicité" },
            { "value": "target", "label": "Audit" }
          ]
        },
        { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Découvrir" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [{ "name": "Accueil — Leviers" }]
}
{% endschema %}
