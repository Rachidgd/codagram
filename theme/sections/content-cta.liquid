<section class="cc-cta surface-deep section-y" data-surface="dark">
  <span class="grid-field" aria-hidden="true"></span>

  <div class="shell cc-cta__inner" data-reveal>
    <div class="cc-cta__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="cc-cta__title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="cc-cta__text">{{ section.settings.text }}</p>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="cc-cta__points" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- render 'icon', name: 'check', size: 13 -%}
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="cc-cta__side">
      <button type="button" class="btn btn--primary btn--lg" data-diagnostic-open data-diagnostic-entry="cta-{{ section.id }}">
        {{ section.settings.cta_label | default: 'Demander un diagnostic' }}
      </button>
      {%- if section.settings.note != blank -%}
        <p class="cc-cta__note">{{ section.settings.note }}</p>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="tlink" href="{{ section.settings.link_url | default: routes.root_url }}">
          {{ section.settings.link_label }}{%- render 'icon', name: 'arrow', size: 14 -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contenu — Conversion",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Étape suivante" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Un avis argumenté avant tout engagement." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Décrivez votre situation en quatre questions. Nous revenons vers vous avec les priorités que nous identifions — et si le levier n'est pas le nôtre, nous vous le disons." },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Demander un diagnostic" },
    { "type": "text", "id": "note", "label": "Note sous le bouton", "default": "Réponse sous 48 h" },
    { "type": "text", "id": "link_label", "label": "Lien secondaire" },
    { "type": "url", "id": "link_url", "label": "URL du lien secondaire" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Réassurance",
      "limit": 4,
      "settings": [{ "type": "text", "id": "text", "label": "Texte" }]
    }
  ],
  "presets": [{ "name": "Contenu — Conversion" }]
}
{% endschema %}
