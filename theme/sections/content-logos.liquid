{%- assign surface = section.settings.surface | default: 'dark' -%}

{%- if section.blocks.size > 0 -%}
  <section class="cc-logos surface-{{ surface }}" data-surface="{{ surface }}">
    <div class="shell">
      {%- if section.settings.title != blank -%}
        <p class="cc-logos__title">{{ section.settings.title }}</p>
      {%- endif -%}
    </div>

    <div class="cc-logos__viewport" data-logos>
      <ul class="cc-logos__track" role="list">
        {%- for block in section.blocks -%}
          <li>
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo
                | image_url: width: 400
                | image_tag:
                  widths: '200,300,400',
                  sizes: '160px',
                  loading: 'lazy',
                  alt: block.settings.name,
                  class: 'cc-logos__img'
              }}
            {%- else -%}
              <span class="cc-logos__word">{{ block.settings.name }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <ul class="cc-logos__track" role="list" aria-hidden="true">
        {%- for block in section.blocks -%}
          <li>
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo
                | image_url: width: 400
                | image_tag:
                  widths: '200,300,400',
                  sizes: '160px',
                  loading: 'lazy',
                  alt: '',
                  class: 'cc-logos__img'
              }}
            {%- else -%}
              <span class="cc-logos__word">{{ block.settings.name }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- if section.settings.note != blank -%}
      <div class="shell">
        <p class="cc-logos__note">{{ section.settings.note }}</p>
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Contenu — Logos",
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "options": [
        { "value": "dark", "label": "Sombre (logos clairs)" },
        { "value": "paper", "label": "Clair (logos sombres)" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "title", "label": "Ligne d'introduction", "default": "Ils nous ont confié leur site" },
    { "type": "text", "id": "note", "label": "Note sous les logos" },
    { "type": "range", "id": "speed", "label": "Durée d'un tour (secondes)", "min": 20, "max": 90, "step": 5, "default": 45, "unit": "s" }
  ],
  "blocks": [
    {
      "type": "client",
      "name": "Client",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Nom du client" }
      ]
    }
  ],
  "presets": [{ "name": "Contenu — Logos" }]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} .cc-logos__track { animation-duration: {{ section.settings.speed | default: 45 }}s; }
</style>
