{%- comment -%}
  LOGOS CLIENTS

  Placée juste après l'accroche : c'est le moment où le visiteur se demande
  « à qui je parle ». Un nom qu'il peut vérifier vaut plus qu'un adjectif.

  Les logos sont posés en niveaux de gris et reprennent leur couleur au survol :
  la bande sert de preuve, pas de décoration, et ne doit pas voler l'attention
  au bouton principal.

  Le fond est réglable parce que la lisibilité dépend de la couleur des logos
  fournis : des logos sombres exigent un fond clair, et inversement.
{%- endcomment -%}

{%- assign surface = section.settings.surface | default: 'paper' -%}

{%- if section.blocks.size > 0 -%}
  <section class="cc-logos surface-{{ surface }}" data-surface="{{ surface }}">
    <div class="shell cc-logos__inner">

      {%- if section.settings.title != blank -%}
        <p class="cc-logos__title" data-reveal>{{ section.settings.title }}</p>
      {%- endif -%}

      <ul class="cc-logos__list" role="list" data-reveal>
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo
                | image_url: width: 320
                | image_tag:
                  widths: '160,240,320',
                  sizes: '(max-width: 767px) 34vw, 150px',
                  loading: 'lazy',
                  alt: block.settings.name,
                  class: 'cc-logos__img'
              }}
            {%- else -%}
              <span class="cc-logos__word">{{ block.settings.name }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.note != blank -%}
        <p class="cc-logos__note">{{ section.settings.note }}</p>
      {%- endif -%}

    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Contenu — Logos",
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Fond",
      "options": [
        { "value": "paper", "label": "Clair (logos sombres)" },
        { "value": "dark", "label": "Sombre (logos clairs)" }
      ],
      "default": "paper"
    },
    { "type": "text", "id": "title", "label": "Ligne d'introduction", "default": "Ils nous ont confié leur site" },
    { "type": "text", "id": "note", "label": "Note sous les logos" }
  ],
  "blocks": [
    {
      "type": "client",
      "name": "Client",
      "limit": 10,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Nom du client" }
      ]
    }
  ],
  "presets": [{ "name": "Contenu — Logos" }]
}
{% endschema %}
