{%- liquid
  assign surface = section.settings.surface | default: 'paper'
  assign surface_class = 'surface-paper'
  assign surface_attr = 'paper'
  if surface == 'dark'
    assign surface_class = 'surface-dark'
    assign surface_attr = 'dark'
  endif
-%}

<section class="cc-cmp {{ surface_class }} section-y" data-surface="{{ surface_attr }}">
  <div class="shell">
    <div class="cc-head-block" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="cc-head-block__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="cc-cmp__scroll" data-reveal>
      <table class="cc-cmp__table">
        <caption class="visually-hidden">{{ section.settings.title }}</caption>
        <thead>
          <tr>
            <th scope="col">{{ section.settings.col_criteria | default: 'Critère' }}</th>
            <th scope="col" class="cc-cmp__hl">{{ section.settings.col_a }}</th>
            <th scope="col">{{ section.settings.col_b }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.criteria }}</th>
              <td class="cc-cmp__hl">{{ block.settings.value_a }}</td>
              <td>{{ block.settings.value_b }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.verdict != blank -%}
      <p class="cc-cmp__verdict" data-reveal><span>Notre lecture —</span> {{ section.settings.verdict }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Contenu — Comparatif",
  "settings": [
    {
      "type": "select", "id": "surface", "label": "Fond", "default": "paper",
      "options": [
        { "value": "paper", "label": "Clair" },
        { "value": "dark", "label": "Graphite" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "title", "label": "Titre" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "text", "id": "col_criteria", "label": "Colonne 1", "default": "Critère" },
    { "type": "text", "id": "col_a", "label": "Colonne 2 (mise en avant)" },
    { "type": "text", "id": "col_b", "label": "Colonne 3" },
    { "type": "textarea", "id": "verdict", "label": "Conclusion" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        { "type": "text", "id": "criteria", "label": "Critère" },
        { "type": "text", "id": "value_a", "label": "Valeur colonne 2" },
        { "type": "text", "id": "value_b", "label": "Valeur colonne 3" }
      ]
    }
  ],
  "presets": [{ "name": "Contenu — Comparatif" }]
}
{% endschema %}
