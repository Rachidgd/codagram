{%- comment -%}
  SÉLECTEUR DE FREIN

  Décision UX/CRO : le visiteur d'une agence ne cherche pas « nos services »,
  il cherche son problème. On inverse donc l'entrée : il choisit le symptôme
  qu'il reconnaît, l'interface lui répond avec le levier, la preuve et l'action.
  Motif ARIA tablist complet, navigation au clavier, aucun rechargement.
{%- endcomment -%}

<section class="cc-diag-sel surface-paper section-y" data-surface="paper">
  <div class="shell">

    <div class="cc-head-block" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="cc-head-block__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="cc-sel" data-selector data-reveal>

        <div class="cc-sel__tabs" role="tablist" aria-label="Choisissez votre situation">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="cc-sel__tab"
              role="tab"
              id="SelTab-{{ block.id }}"
              aria-controls="SelPanel-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              data-selector-tab="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              <span class="cc-sel__tab-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="cc-sel__tab-label">{{ block.settings.symptom }}</span>
              {%- render 'icon', name: 'arrow', size: 15, class: 'cc-sel__tab-go' -%}
            </button>
          {%- endfor -%}

          {%- comment -%}
            La colonne d'onglets est plus courte que le panneau de réponse.
            Plutôt que de laisser un vide, on y place la sortie utile pour le
            visiteur qui ne se reconnaît dans aucun symptôme.
          {%- endcomment -%}
          {%- if section.settings.aside_text != blank -%}
            <div class="cc-sel__aside">
              <p class="cc-sel__aside-text">{{ section.settings.aside_text }}</p>
              <button type="button" class="tlink" data-diagnostic-open data-diagnostic-entry="selecteur-aucun">
                {{ section.settings.aside_cta | default: 'Lancer le diagnostic' }}{%- render 'icon', name: 'arrow', size: 14 -%}
              </button>
            </div>
          {%- endif -%}
        </div>

        <div class="cc-sel__panels">
          {%- for block in section.blocks -%}
            <div
              class="cc-sel__panel"
              role="tabpanel"
              id="SelPanel-{{ block.id }}"
              aria-labelledby="SelTab-{{ block.id }}"
              data-selector-panel="{{ block.id }}"
              tabindex="0"
              {% unless forloop.first %}hidden{% endunless %}
            >
              <p class="cc-sel__lever">
                {%- render 'icon', name: block.settings.icon, size: 15 -%}
                <span>{{ block.settings.lever }}</span>
              </p>

              <h3 class="cc-sel__title">{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}<p class="cc-sel__text">{{ block.settings.text }}</p>{%- endif -%}

              {%- if block.settings.point_1 != blank -%}
                <ul class="cc-sel__points" role="list">
                  {%- if block.settings.point_1 != blank -%}<li>{%- render 'icon', name: 'check', size: 13 -%}<span>{{ block.settings.point_1 }}</span></li>{%- endif -%}
                  {%- if block.settings.point_2 != blank -%}<li>{%- render 'icon', name: 'check', size: 13 -%}<span>{{ block.settings.point_2 }}</span></li>{%- endif -%}
                  {%- if block.settings.point_3 != blank -%}<li>{%- render 'icon', name: 'check', size: 13 -%}<span>{{ block.settings.point_3 }}</span></li>{%- endif -%}
                </ul>
              {%- endif -%}

              <div class="cc-sel__foot">
                {%- if block.settings.link_label != blank -%}
                  <a class="btn btn--solid" href="{{ block.settings.link | default: routes.root_url }}">
                    {{ block.settings.link_label }}{%- render 'icon', name: 'arrow', size: 15 -%}
                  </a>
                {%- endif -%}
                <button type="button" class="tlink" data-diagnostic-open data-diagnostic-entry="selecteur-{{ block.settings.lever | handle }}">
                  Diagnostiquer mon cas{%- render 'icon', name: 'arrow', size: 14 -%}
                </button>
              </div>

              {%- if block.settings.proof_metric != blank -%}
                <aside class="cc-sel__proof">
                  <span class="metric" data-metric>{{ block.settings.proof_metric }}</span>
                  <span>{{ block.settings.proof_label }}</span>
                </aside>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Accueil — Sélecteur",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Partons du problème" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Reconnaissez-vous votre situation ?" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Sélectionnez le symptôme le plus proche de votre réalité. Nous affichons le levier concerné, ce qu'il implique concrètement et un résultat déjà obtenu." },
    { "type": "textarea", "id": "aside_text", "label": "Encart sous les onglets", "default": "Aucune situation ne correspond exactement à la vôtre ? Décrivez-la en quatre questions, nous identifions le levier prioritaire." },
    { "type": "text", "id": "aside_cta", "label": "Lien de l'encart", "default": "Lancer le diagnostic" }
  ],
  "blocks": [
    {
      "type": "case",
      "name": "Situation",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "symptom", "label": "Symptôme (onglet)", "default": "Personne ne me trouve sur Google" },
        { "type": "text", "id": "lever", "label": "Levier", "default": "Référencement naturel" },
        {
          "type": "select", "id": "icon", "label": "Pictogramme", "default": "signal",
          "options": [
            { "value": "signal", "label": "Signal / SEO" },
            { "value": "layers", "label": "Site sur mesure" },
            { "value": "cart", "label": "E-commerce" },
            { "value": "gauge", "label": "Conversion" },
            { "value": "megaphone", "label": "Publicité" },
            { "value": "target", "label": "Audit" }
          ]
        },
        { "type": "text", "id": "title", "label": "Titre de réponse" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "point_1", "label": "Point 1" },
        { "type": "text", "id": "point_2", "label": "Point 2" },
        { "type": "text", "id": "point_3", "label": "Point 3" },
        { "type": "text", "id": "proof_metric", "label": "Chiffre de preuve" },
        { "type": "text", "id": "proof_label", "label": "Libellé du chiffre" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Voir la prestation" },
        { "type": "url", "id": "link", "label": "Page concernée" }
      ]
    }
  ],
  "presets": [{ "name": "Accueil — Sélecteur" }]
}
{% endschema %}
