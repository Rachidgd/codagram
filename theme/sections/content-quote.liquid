<section class="cc-quote surface-deep section-y" data-surface="dark">
  <span class="grid-field" aria-hidden="true"></span>
  <div class="shell cc-quote__inner" data-reveal>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <blockquote class="cc-quote__text">{{ section.settings.quote }}</blockquote>
    {%- if section.settings.attribution != blank -%}
      <p class="cc-quote__by">{{ section.settings.attribution }}</p>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="tlink" href="{{ section.settings.link_url | default: routes.root_url }}">
        {{ section.settings.link_label }}{%- render 'icon', name: 'arrow', size: 14 -%}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Contenu — Position",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "textarea", "id": "quote", "label": "Affirmation" },
    { "type": "text", "id": "attribution", "label": "Attribution" },
    { "type": "text", "id": "link_label", "label": "Lien" },
    { "type": "url", "id": "link_url", "label": "URL du lien" }
  ],
  "presets": [{ "name": "Contenu — Position" }]
}
{% endschema %}
