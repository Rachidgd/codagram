{%- liquid
  # ---------------------------------------------------------------------------
  # Résolution SEO.
  #
  # Le champ SEO natif de Shopify fait foi, et lui seul : page_title et
  # page_description renvoient ce qui est saisi dans « Référencement » côté
  # admin, sinon le titre de l'objet. Un seul endroit à modifier, pas de
  # métachamp parallèle qui écrase silencieusement la saisie.
  #
  # Les replis ci-dessous ne comblent qu'un champ laissé vide.
  # ---------------------------------------------------------------------------
  assign seo_title = page_title
  assign seo_description = page_description
  assign seo_title_is_custom = false
  assign seo_noindex = false

  case request.page_type
    when 'index'
      assign seo_title = settings.home_meta_title | default: page_title
      assign seo_description = settings.home_meta_description | default: page_description
      assign seo_title_is_custom = true

    when 'page'
      if page.metafields.editorial.noindex.value == true
        assign seo_noindex = true
      endif

    when 'article'
      if seo_description == blank
        assign seo_description = article.excerpt | strip_html
      endif
      if article.metafields.editorial.noindex.value == true
        assign seo_noindex = true
      endif

    when 'blog'
      # Le réglage blog_meta_title n'est jamais vide, donc seo_title_is_custom
      # était toujours vrai et le suffixe d'étiquette ci-dessous ne s'ajoutait
      # jamais : l'index, ses 3 pages de pagination et les 37 archives
      # d'étiquettes partageaient un seul titre et une seule description.
      # Les archives et les pages 2+ passent en noindex : 17 d'entre elles ne
      # portent qu'un article et concurrencent donc cet article.
      assign seo_title = settings.blog_meta_title | default: page_title
      assign seo_description = settings.blog_meta_description | default: page_description
      assign seo_title_is_custom = true
      if current_tags
        assign tag_courant = current_tags | join: ', '
        assign seo_title = tag_courant | append: ' | Guides Clickscreation'
        assign seo_description = 'Nos guides sur ' | append: tag_courant | append: ' : méthode, exemples et corrections à appliquer sur votre site.'
        assign seo_noindex = true
      endif
      if current_page != 1
        assign seo_title = seo_title | append: ' — Page ' | append: current_page
        assign seo_noindex = true
      endif

    # Aucune de ces trois pages n'a de valeur dans un index de recherche, et
    # le robots.txt de Shopify ne bloque pas /search.
    when 'search'
      assign seo_noindex = true
    when 'cart'
      assign seo_noindex = true
    when '404'
      assign seo_noindex = true
  endcase

  assign og_title = seo_title
  assign og_description = seo_description
-%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0b0e0d">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if seo_noindex %}<meta name="robots" content="noindex, follow">{% endif -%}

    <title>{{ seo_title | escape }}{% unless seo_title_is_custom %}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}{% endunless %}</title>
    {%- if seo_description != blank %}
      <meta name="description" content="{{ seo_description | strip_html | truncate: 300 | escape }}">
    {%- endif %}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{ 'cc-jost.woff2' | asset_url }}" crossorigin>

    <style>
      @font-face {
        font-family: "Jost";
        src: url("{{ 'cc-jost.woff2' | asset_url }}") format("woff2-variations"),
             url("{{ 'cc-jost.woff2' | asset_url }}") format("woff2");
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "CC Mono";
        src: url("{{ 'cc-jbmono.woff2' | asset_url }}") format("woff2-variations"),
             url("{{ 'cc-jbmono.woff2' | asset_url }}") format("woff2");
        font-weight: 400 700;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+2000-206F, U+20AC, U+2122, U+2212;
      }
      html { background: #0b0e0d; }
    </style>

    {{ 'signal.css' | asset_url | stylesheet_tag: preload: true }}

    {%- render 'meta-social', title: og_title, description: og_description -%}
    {%- render 'structured-data', title: seo_title, description: seo_description -%}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
    <script src="{{ 'signal.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body
    class="surface-dark antialiased template-{{ template.name | handle }}{% if template.suffix != blank %} template-{{ template.suffix | handle }}{% endif %}"
    data-motion="{{ settings.enable_motion | default: true }}"
  >
    <a class="btn btn--primary sr-skip" href="#main">Aller au contenu</a>

    {%- section 'header' -%}

    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- section 'footer' -%}

    {%- render 'diagnostic-drawer' -%}
    {%- render 'command-palette' -%}
  </body>
</html>
