{%- liquid
  assign org_id = shop.url | append: '/#organisation'
  assign site_id = shop.url | append: '/#site'
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": {{ org_id | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      {% if settings.share_image != blank %}"image": {{ settings.share_image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
      {% if settings.org_description != blank %}"description": {{ settings.org_description | json }},{% endif %}
      "email": {{ settings.contact_email | default: shop.email | json }},
      {% if settings.contact_phone != blank %}"telephone": {{ settings.contact_phone | json }},{% endif %}
      "priceRange": {{ settings.price_range | default: '€€€' | json }},
      "address": {
        "@type": "PostalAddress",
        "addressLocality": {{ settings.org_city | default: 'Paris' | json }},
        "addressCountry": "FR"
      },
      "areaServed": [
        { "@type": "Country", "name": "France" },
        { "@type": "Country", "name": "Belgique" },
        { "@type": "Country", "name": "Suisse" },
        { "@type": "Country", "name": "Luxembourg" }
      ],
      "knowsAbout": [
        "Référencement naturel",
        "Shopify",
        "Optimisation du taux de conversion",
        "Publicité Meta",
        "Création de site web"
      ]
      {%- if settings.social_linkedin != blank or settings.social_instagram != blank -%}
      ,"sameAs": [
        {%- assign social_sep = '' -%}
        {%- if settings.social_linkedin != blank -%}{{ social_sep }}{{ settings.social_linkedin | json }}{%- assign social_sep = ',' -%}{%- endif -%}
        {%- if settings.social_instagram != blank -%}{{ social_sep }}{{ settings.social_instagram | json }}{%- endif -%}
      ]
      {%- endif -%}
    },
    {
      "@type": "WebSite",
      "@id": {{ site_id | json }},
      "url": {{ shop.url | json }},
      "name": {{ shop.name | json }},
      "inLanguage": "fr-FR",
      "publisher": { "@id": {{ org_id | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }

    {%- if request.page_type == 'page' -%}
    ,{
      "@type": "WebPage",
      "@id": {{ canonical_url | append: '#page' | json }},
      "url": {{ canonical_url | json }},
      "name": {{ title | json }},
      {% if description != blank %}"description": {{ description | strip_html | json }},{% endif %}
      "isPartOf": { "@id": {{ site_id | json }} },
      "about": { "@id": {{ org_id | json }} },
      "inLanguage": "fr-FR"
    },
    {
      "@type": "BreadcrumbList",
      "@id": {{ canonical_url | append: '#fil' | json }},
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ canonical_url | json }} }
      ]
    }
    {%- assign service_name = page.metafields.seo_service.name.value -%}
    {%- if service_name != blank -%}
      {%- assign service_area = page.metafields.seo_service.area.value | default: 'France' -%}
      {%- assign service_type = page.metafields.seo_service.type.value | default: service_name -%}
      ,{
        "@type": "Service",
        "@id": {{ canonical_url | append: '#service' | json }},
        "name": {{ service_name | json }},
        "serviceType": {{ service_type | json }},
        "url": {{ canonical_url | json }},
        {% if description != blank %}"description": {{ description | strip_html | json }},{% endif %}
        "provider": { "@id": {{ org_id | json }} },
        "areaServed": { "@type": "Place", "name": {{ service_area | json }} },
        "isPartOf": { "@id": {{ site_id | json }} }
      }
    {%- endif -%}
    {%- endif -%}

    {%- if request.page_type == 'article' -%}
    ,{
      "@type": "Article",
      "@id": {{ canonical_url | append: '#article' | json }},
      "headline": {{ article.title | json }},
      "url": {{ canonical_url | json }},
      {% if description != blank %}"description": {{ description | strip_html | json }},{% endif %}
      {% if article.image != blank %}"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      {%- assign maj = article.metafields.editorial.updated_at.value | default: article.published_at -%}
      "dateModified": {{ maj | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "author": {
        "@type": "Person",
        "name": {{ article.author | default: shop.name | json }}
      },
      "publisher": { "@id": {{ org_id | json }} },
      "isPartOf": { "@id": {{ site_id | json }} },
      "mainEntityOfPage": { "@id": {{ canonical_url | append: '#article' | json }} },
      "inLanguage": "fr-FR"
    },
    {
      "@type": "BreadcrumbList",
      "@id": {{ canonical_url | append: '#fil' | json }},
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ canonical_url | json }} }
      ]
    }
    {%- endif -%}
  ]
}
</script>
