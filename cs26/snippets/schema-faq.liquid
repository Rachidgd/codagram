{%- comment -%}
  schema-faq.liquid · FAQPage (§10.2), une seule fois par page.
  Params : faq_blocks (blocks de cs-faq) OU faq_items (liste {question, reponse}
  issue du métachamp JSON seo_ville.faq, rendu par cs-ville-seo).
{%- endcomment -%}
{%- if faq_blocks.size > 0 -%}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {%- for b in faq_blocks -%}
  { "@type": "Question", "name": {{ b.settings.question | strip_html | json }},
    "acceptedAnswer": { "@type": "Answer", "text": {{ b.settings.reponse | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
  {%- endfor -%} ] }
</script>
{%- elsif faq_items.size > 0 -%}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {%- for item in faq_items -%}
  { "@type": "Question", "name": {{ item.question | strip_html | json }},
    "acceptedAnswer": { "@type": "Answer", "text": {{ item.reponse | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
  {%- endfor -%} ] }
</script>
{%- endif -%}
