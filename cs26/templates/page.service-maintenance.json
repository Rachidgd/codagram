    "faq": {
      "type": "cs-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Que couvre exactement la maintenance ?",
            "reponse": "<p>Les mises à jour techniques, les sauvegardes, la surveillance de disponibilité et de sécurité, et un volume mensuel d'améliorations défini au contrat. Le périmètre exact est écrit, sans zone grise.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Quel est votre délai d'intervention ?",
            "reponse": "<p>Il dépend du niveau de contrat choisi et il est contractuel. En cas d'incident bloquant, l'intervention est prioritaire sur tout le reste.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Les sauvegardes sont-elles vérifiées ?",
            "reponse": "<p>Oui : une sauvegarde qui n'a jamais été restaurée n'est pas une sauvegarde. Des restaurations de test sont réalisées régulièrement.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Suis-je engagé sur la durée ?",
            "reponse": "<p>Le contrat est résiliable selon un préavis simple, écrit dès la signature. Si vous partez, vous récupérez tous les accès et l'historique des interventions.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Mon site n'a pas été fait par vous : possible ?",
            "reponse": "<p>Oui, après un audit technique qui vérifie l'état du site et chiffre une éventuelle remise à niveau avant de démarrer la maintenance.</p>"
          }
        }
      },
      "block_order": [
        "q1",
