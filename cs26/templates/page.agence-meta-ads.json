      "type": "cs-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Reprenez-vous un compte déjà actif ?",
            "reponse": "<p>Oui, sans repartir de zéro : l'historique a de la valeur. L'audit identifie ce qui doit être conservé, corrigé ou arrêté, puis le plan de tests s'appuie dessus.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Comment sont facturés vos honoraires ?",
            "reponse": "<p>Un forfait de pilotage clair, séparé du budget publicitaire qui reste dans votre compte. Le détail est posé dans la proposition, après l'audit.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Que se passe-t-il si les résultats ne suivent pas ?",
            "reponse": "<p>Des règles d'arrêt sont posées avant le lancement : si les seuils ne sont pas atteints après la phase de test, on arrête ou on réoriente, sur données partagées.</p>"
          }
        }
      },
