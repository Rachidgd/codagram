        "bg_style": "alt",
        "padding_haut": 96,
        "padding_bas": 96
      }
    },
    "faq": {
      "type": "cs-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Pourquoi l'audit est-il gratuit ?",
            "reponse": "<p>Parce qu'il nous qualifie autant qu'il vous éclaire : si votre situation ne relève pas de nos métiers, on vous le dit et on vous oriente. S'il y a un vrai potentiel, l'audit devient la base d'une proposition précise.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Que dois-je préparer ?",
            "reponse": "<p>Rien d'obligatoire. L'URL de votre site suffit pour démarrer. Un accès en lecture à vos statistiques rend l'audit plus précis, mais il peut attendre un second échange.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Vais-je être relancé sans fin ?",
            "reponse": "<p>Non. Vous recevez l'audit, puis une seule proposition d'échange pour le commenter. Sans réponse de votre part, on en reste là. C'est écrit noir sur blanc dans nos engagements.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3"
      ],
      "settings": {
        "titre": "Avant de vous lancer",
        "bg_style": "base",
        "padding_haut": 96,
        "padding_bas": 96
      }
    }
