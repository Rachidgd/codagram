          }
        },
        "g3": {
          "type": "engagement",
          "settings": {
            "icone": "document",
            "titre": "Un plan actionnable",
            "texte": "Des recommandations classées par impact, exploitables avec ou sans nous."
          }
        }
      },
      "block_order": [
        "g1",
        "g2",
        "g3"
