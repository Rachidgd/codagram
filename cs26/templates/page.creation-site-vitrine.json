    "faq": {
      "type": "cs-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Le site m'appartient-il vraiment ?",
            "reponse": "<p>Oui, entièrement : contenus, design, nom de domaine et accès sont à votre nom. En cas de séparation, vous partez avec tout et un document de passation.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Puis-je modifier le site moi-même ?",
            "reponse": "<p>Oui. Textes, images et sections s'éditent depuis une interface simple, sans toucher au code. Une session de prise en main est incluse.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Un site vitrine peut-il vraiment m'apporter des clients ?",
            "reponse": "<p>S'il est construit autour des recherches locales et d'un parcours de contact sans friction, oui. C'est exactement ce que mesure l'audit avant de commencer.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3"
      ],
      "settings": {
        "titre": "Vos questions sur le site vitrine",
        "premier_ouvert": true,
        "bg_style": "base",
        "padding_haut": 96,
