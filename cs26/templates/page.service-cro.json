        "q1": {
          "type": "question",
          "settings": {
            "question": "Faut-il beaucoup de trafic pour faire du CRO ?",
            "reponse": "<p>Pour des tests statistiquement fiables, oui, un minimum est nécessaire. En dessous, on commence par les corrections d'évidence : vitesse, clarté du message, parcours mobile. L'audit vous dit dans quel cas vous êtes.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Allez-vous casser mon site ?",
            "reponse": "<p>Non. Chaque modification est testée sur une part du trafic ou sur un environnement de préproduction, avec retour arrière immédiat possible. Votre site reste stable pendant toute la mission.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Sur quoi portent les tests ?",
            "reponse": "<p>Messages, ordre des sections, formulaires, preuves, parcours d'achat. Jamais de gadget : on teste ce que les données désignent comme point de fuite.</p>"
          }
        }
