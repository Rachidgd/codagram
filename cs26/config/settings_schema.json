[
  {
    "name": "theme_info",
    "theme_name": "CS-26",
    "theme_version": "1.3.8",
    "theme_author": "Clickscreation · LE STUDIO",
    "theme_documentation_url": "https://clickscreation.fr",
    "theme_support_url": "https://clickscreation.fr/pages/contact"
  },
  {
    "name": "Identité",
    "settings": [
      { "type": "image_picker", "id": "logo_theme", "label": "Logo (SVG accepté)" },
      { "type": "range", "id": "logo_largeur", "label": "Largeur du logo", "min": 80, "max": 240, "step": 10, "default": 140, "unit": "px" },
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Carré, 96 × 96 px minimum. À défaut, le favicon du thème est utilisé." },
      { "type": "image_picker", "id": "og_image_defaut", "label": "Image de partage par défaut", "info": "1200 × 630 px, utilisée quand la page n'a pas d'image propre." },
      { "type": "text", "id": "nom_legal", "label": "Nom légal de l'entreprise" },
      { "type": "textarea", "id": "promesse_footer", "label": "Promesse de marque", "info": "120 caractères max. Affichée dans le footer et en description de partage par défaut." },
      { "type": "header", "content": "NAP (nom, adresse, téléphone)" },
      { "type": "text", "id": "nap_adresse", "label": "Adresse (rue)" },
      { "type": "text", "id": "nap_code_postal", "label": "Code postal" },
      { "type": "text", "id": "nap_ville", "label": "Ville" },
      { "type": "text", "id": "nap_telephone", "label": "Téléphone", "info": "Format international recommandé : +33…" },
      { "type": "text", "id": "nap_email", "label": "Email de contact" },
      { "type": "text", "id": "nap_horaires", "label": "Horaires", "info": "Ex. : Mo-Fr 09:00-18:00 (format schema.org)" },
      { "type": "text", "id": "zones_servies", "label": "Zones servies", "info": "Villes séparées par des virgules. Nourrit le JSON-LD areaServed." },
      { "type": "header", "content": "Liens externes" },
      { "type": "url", "id": "gbp_url", "label": "Fiche Google Business Profile" },
      { "type": "url", "id": "lien_instagram", "label": "Instagram" },
      { "type": "url", "id": "lien_facebook", "label": "Facebook" },
      { "type": "url", "id": "lien_linkedin", "label": "LinkedIn" },
      { "type": "url", "id": "lien_tiktok", "label": "TikTok" },
      { "type": "url", "id": "lien_youtube", "label": "YouTube" }
    ]
  },
  {
    "name": "Palette sombre",
