      { "type": "color", "id": "sombre_bg", "label": "Fond de page", "default": "#0B0E14" },
      { "type": "color", "id": "sombre_bg_2", "label": "Fond alterné de section", "default": "#0F131B" },
      { "type": "color", "id": "sombre_surface", "label": "Cartes, panneaux", "default": "#151A24" },
      { "type": "color", "id": "sombre_surface_2", "label": "Cartes surélevées, hover", "default": "#1B2130" },
      { "type": "color", "id": "sombre_text", "label": "Titres, texte fort", "default": "#F4F6FB" },
      { "type": "color", "id": "sombre_text_2", "label": "Texte courant", "default": "#A8B1C2" },
      { "type": "color", "id": "sombre_text_3", "label": "Légendes, metas", "default": "#6E7889" },
      { "type": "color", "id": "sombre_accent", "label": "Accent ambre", "default": "#FFB454" },
      { "type": "color", "id": "sombre_accent_2", "label": "Accent corail", "default": "#FF6B4A" },
      { "type": "color", "id": "sombre_accent_ink", "label": "Texte sur accent", "default": "#14161C" },
