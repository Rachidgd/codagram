{%- comment -%}
  cs-bulles.liquid · Pastilles et icônes flottantes (§8.9, positions §4.9).
  Anti-collision garanti par le layout : positions prédéfinies en %,
  amplitudes incluses dans les marges de sécurité. 4 bulles max sur mobile.
{%- endcomment -%}
{{ 'section-bulles.css' | asset_url | stylesheet_tag }}

<section id="{{ section.id }}"
  class="cs-section cs-bulles-section{% if section.settings.bg_style == 'alt' %} cs-section--alt{% elsif section.settings.bg_style == 'halo' %} cs-section--halo{% endif %}"
  style="--pt: {{ section.settings.padding_haut }}px; --pb: {{ section.settings.padding_bas }}px;">
  <div class="cs-container">
    <div class="cs-bulles" data-reveal-group>
      <div class="cs-bulles__centre" data-reveal="fade">
        {% render 'eyebrow', texte: section.settings.eyebrow %}
        {%- if section.settings.titre != blank -%}
          <h2 class="cs-h2">{{ section.settings.titre | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.texte != blank -%}
          <p>{{ section.settings.texte | escape }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          {% render 'bouton', label: section.settings.cta_label, popup: true, style: 'primaire' %}
        {%- endif -%}
      </div>
      {%- for block in section.blocks limit: 6 -%}
        {%- assign pos = forloop.index -%}
        {%- if block.type == 'pastille' and block.settings.texte != blank -%}
          <div class="cs-bulles__item cs-bulles__item--{{ pos }} cs-glass cs-bulles__pastille"
            data-reveal="scale" {{ block.shopify_attributes }}>
            {{ block.settings.texte | escape }}
          </div>
        {%- elsif block.type == 'icone' and block.settings.label != blank -%}
          <div class="cs-bulles__item cs-bulles__item--{{ pos }} cs-bulles__icone"
            data-reveal="scale" {{ block.shopify_attributes }}>
            <span class="cs-pastille-icone">{% render 'icone', nom: block.settings.icone %}</span>
            <span class="cs-bulles__icone-label">{{ block.settings.label | escape }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CS · Bulles flottantes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "info": "28 caractères max" },
    { "type": "text", "id": "titre", "label": "Titre (H2)", "info": "60 caractères max" },
    { "type": "textarea", "id": "texte", "label": "Texte", "info": "160 caractères max" },
    { "type": "text", "id": "cta_label", "label": "Bouton (optionnel, popup)", "info": "24 caractères max" },
    { "type": "select", "id": "bg_style", "label": "Fond",
      "options": [ { "value": "base", "label": "Base" }, { "value": "alt", "label": "Alterné" }, { "value": "halo", "label": "Halo braise" } ], "default": "base" },
    { "type": "select", "id": "animation", "label": "Animation d'apparition",
      "options": [ { "value": "auto", "label": "Automatique (flottement)" }, { "value": "none", "label": "Aucune" } ], "default": "auto" },
    { "type": "range", "id": "padding_haut", "label": "Espace haut", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" },
    { "type": "range", "id": "padding_bas", "label": "Espace bas", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "pastille",
      "name": "Pastille texte",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "texte", "label": "Texte", "info": "40 caractères max" }
      ]
    },
    {
      "type": "icone",
      "name": "Bulle icône",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icone", "label": "Icône",
          "options": [
            { "value": "etincelle", "label": "Étincelle" },
            { "value": "eclair", "label": "Éclair" },
            { "value": "seo", "label": "SEO" },
            { "value": "conversion", "label": "Conversion" },
            { "value": "horloge", "label": "Horloge" },
            { "value": "bouclier", "label": "Bouclier" },
            { "value": "coeur", "label": "Cœur" },
            { "value": "message", "label": "Message" }
          ],
          "default": "etincelle" },
        { "type": "text", "id": "label", "label": "Label", "info": "24 caractères max" }
      ]
    }
  ],
  "presets": [ { "name": "CS · Bulles flottantes" } ]
}
{% endschema %}
