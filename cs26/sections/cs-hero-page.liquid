{%- comment -%}
  cs-hero-page.liquid · Héros des pages internes (§8.2), 4 variantes :
  service (colonne droite : 3 chiffres OU visuel) · ville (chips zones +
  note locale) · hub (pleine largeur) · simple (légal/contact).
  Sur le template metaobject « projet », lit la fiche (client, secteur,
  ville, services, cover). Mobile : visuel APRÈS le texte.
{%- endcomment -%}
{{ 'section-hero-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign variante = section.settings.variante
  assign est_projet = false
  if template.name == 'metaobject'
    assign est_projet = true
    assign projet = metaobject
  endif

  assign titre = section.settings.titre
  if titre == blank
    if est_projet
      assign titre = projet.titre.value
    elsif template.name == 'page'
      assign titre = page.title
    elsif template.name == 'blog'
      assign titre = blog.title
    else
      assign titre = page_title
    endif
  endif

  assign ville_meta = page.metafields.cs.ville.value
-%}

<section id="{{ section.id }}" class="cs-hero-page cs-hero-page--{{ variante }}{% if section.settings.bg_style == 'halo' %} cs-section--halo{% endif %}">
  <div class="cs-container cs-hero-page__interieur">
    {% render 'breadcrumb' %}

    <div class="cs-hero-page__grille">
      <div class="cs-hero-page__contenu" data-reveal-group>
        {%- if est_projet and projet.secteur.value != blank -%}
          <p class="cs-eyebrow" data-reveal="up">{{ projet.secteur.value | escape }}</p>
        {%- elsif section.settings.eyebrow != blank -%}
          <p class="cs-eyebrow" data-reveal="up">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h1 class="cs-h1" data-reveal="up">{{ titre | escape }}</h1>

        {%- if est_projet -%}
          {%- if projet.extrait.value != blank -%}
            <p class="cs-hero-page__intro" data-reveal="up">{{ projet.extrait.value | escape }}</p>
          {%- endif -%}
          <div class="cs-hero-page__chips" data-reveal="up">
            {%- if projet.ville.value != blank -%}
              <span class="cs-chip">{% render 'icone', nom: 'pin', taille: 16 %} {{ projet.ville.value | escape }}</span>
            {%- endif -%}
            {%- for service in projet.services.value -%}
              <span class="cs-chip">{{ service | escape }}</span>
            {%- endfor -%}
            {%- if projet.url_live.value != blank -%}
              <a class="cs-chip" href="{{ projet.url_live.value }}" rel="noopener" target="_blank">Voir le site {% render 'icone', nom: 'fleche-45', taille: 14 %}</a>
            {%- endif -%}
          </div>
        {%- else -%}
          {%- if section.settings.intro != blank -%}
            <p class="cs-hero-page__intro" data-reveal="up">{{ section.settings.intro | escape }}</p>
          {%- endif -%}
        {%- endif -%}

        {%- if variante == 'ville' -%}
          <div class="cs-hero-page__chips" data-reveal="up">
            {%- if ville_meta and ville_meta.zones.value -%}
              {%- for zone in ville_meta.zones.value limit: 6 -%}
                <span class="cs-chip">{{ zone | escape }}</span>
              {%- endfor -%}
            {%- endif -%}
          </div>
          {%- if section.settings.note_locale != blank and section.settings.nb_avis_locale != blank -%}
            <p class="cs-hero-page__note" data-reveal="up">
              <span class="cs-etoiles" aria-hidden="true">
                {%- for i in (1..5) -%}
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.8-4.5 4.3 1.1 6-5.4-2.9-5.4 2.9 1.1-6L3.2 9.4l6.1-.8z"/></svg>
                {%- endfor -%}
              </span>
              <strong>{{ section.settings.note_locale | escape }}/5</strong> · {{ section.settings.nb_avis_locale | escape }} avis Google locaux
            </p>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.cta_active -%}
          <div data-reveal="up">
            {% render 'bouton', label: section.settings.cta_label, popup: true, style: 'primaire', reassurance: section.settings.reassurance %}
          </div>
        {%- endif -%}
      </div>

      {%- if variante == 'service' or est_projet -%}
        <div class="cs-hero-page__droite">
          {%- if est_projet and projet.cover.value -%}
            <div data-reveal="clip">
              {% render 'forme', img: projet.cover.value, shape: section.settings.shape, halo: section.settings.halo, ratio: '3/2', sizes: '(min-width: 900px) 46vw, 92vw', priorite: true %}
            </div>
          {%- elsif section.settings.image != blank -%}
            <div data-reveal="clip">
              {% render 'forme', img: section.settings.image, shape: section.settings.shape, halo: section.settings.halo, ratio: '3/2', sizes: '(min-width: 900px) 46vw, 92vw', priorite: true, alt: section.settings.image_alt %}
            </div>
          {%- else -%}
            {%- liquid
              assign a_chiffres = false
              if section.settings.chiffre_1_valeur != blank
                assign a_chiffres = true
              endif
            -%}
            {%- if a_chiffres -%}
              <div class="cs-hero-page__chiffres" data-reveal-group>
                {%- for i in (1..3) -%}
                  {%- assign cle_v = 'chiffre_' | append: i | append: '_valeur' -%}
                  {%- assign cle_l = 'chiffre_' | append: i | append: '_label' -%}
                  {%- if section.settings[cle_v] != blank and section.settings[cle_l] != blank -%}
                    <div class="cs-stat" data-reveal="up">
                      <span class="cs-stat__value cs-stat__value--h2">{{ section.settings[cle_v] | escape }}</span>
                      <span class="cs-stat__label">{{ section.settings[cle_l] | escape }}</span>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if variante == 'service' -%}
  {% render 'schema-service', nom: titre, description: section.settings.intro %}
{%- endif -%}

{% schema %}
{
  "name": "CS · Hero de page",
  "settings": [
    { "type": "select", "id": "variante", "label": "Variante",
      "options": [
        { "value": "service", "label": "Service (chiffres ou visuel à droite)" },
        { "value": "ville", "label": "Ville (zones + note locale)" },
        { "value": "hub", "label": "Hub (pleine largeur)" },
        { "value": "simple", "label": "Simple (légal, contact)" }
      ],
      "default": "simple" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "info": "28 caractères max" },
    { "type": "text", "id": "titre", "label": "Titre (H1)", "info": "60 caractères max. Vide = titre de la page. Aligné sur l'intention SEO (§8.2)." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "info": "180 caractères max" },
    { "type": "header", "content": "Conversion" },
    { "type": "checkbox", "id": "cta_active", "label": "Afficher le CTA (popup)", "default": true },
    { "type": "text", "id": "cta_label", "label": "Bouton", "info": "24 caractères max", "default": "Mon audit gratuit" },
    { "type": "text", "id": "reassurance", "label": "Réassurance", "info": "70 caractères max", "default": "Réponse sous 48 h ouvrées. Sans engagement." },
    { "type": "header", "content": "Colonne droite (variante service)" },
    { "type": "image_picker", "id": "image", "label": "Visuel" },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif" },
    { "type": "select", "id": "shape", "label": "Forme du visuel",
      "options": [
        { "value": "soft", "label": "Douce" },
        { "value": "diag-1", "label": "Diagonale 1" },
        { "value": "diag-2", "label": "Diagonale 2" },
        { "value": "arche", "label": "Arche" },
        { "value": "organique", "label": "Organique" }
      ],
      "default": "diag-2" },
    { "type": "checkbox", "id": "halo", "label": "Halo braise", "default": false },
    { "type": "text", "id": "chiffre_1_valeur", "label": "Chiffre 1 · valeur", "info": "Réel et daté (§2.3), sinon vide." },
    { "type": "text", "id": "chiffre_1_label", "label": "Chiffre 1 · label" },
    { "type": "text", "id": "chiffre_2_valeur", "label": "Chiffre 2 · valeur" },
    { "type": "text", "id": "chiffre_2_label", "label": "Chiffre 2 · label" },
    { "type": "text", "id": "chiffre_3_valeur", "label": "Chiffre 3 · valeur" },
    { "type": "text", "id": "chiffre_3_label", "label": "Chiffre 3 · label" },
    { "type": "header", "content": "Variante ville" },
    { "type": "text", "id": "note_locale", "label": "Note Google locale", "info": "Réelle (§2.3), sinon vide." },
    { "type": "text", "id": "nb_avis_locale", "label": "Nombre d'avis locaux" },
    { "type": "select", "id": "bg_style", "label": "Fond",
      "options": [ { "value": "base", "label": "Base" }, { "value": "halo", "label": "Halo braise" } ], "default": "base" }
  ],
  "presets": [ { "name": "CS · Hero de page" } ]
}
{% endschema %}
