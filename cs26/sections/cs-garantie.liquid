{%- comment -%}
  cs-garantie.liquid · Réassurance d'engagements (§8.16).
  Fade simple : la réassurance ne gesticule pas. Chaque engagement doit
  être tenable contractuellement (validation CEO).
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
{{ 'section-garantie.css' | asset_url | stylesheet_tag }}

<section id="{{ section.id }}"
  class="cs-section cs-garantie{% if section.settings.bg_style == 'alt' %} cs-section--alt{% elsif section.settings.bg_style == 'halo' %} cs-section--halo{% endif %}"
  style="--pt: {{ section.settings.padding_haut }}px; --pb: {{ section.settings.padding_bas }}px;">
  <div class="cs-container">
    {%- if section.settings.titre != blank -%}
      <header class="cs-section__tete" data-reveal="fade">
        {% render 'eyebrow', texte: section.settings.eyebrow %}
        <h2 class="cs-h2">{{ section.settings.titre | escape }}</h2>
      </header>
    {%- endif -%}
    <div class="cs-garantie__rangee" data-reveal-group>
      {%- for block in section.blocks -%}
        {%- if block.settings.titre != blank -%}
          <div class="cs-garantie__carte" data-reveal="fade" {{ block.shopify_attributes }}>
            <span class="cs-pastille-icone">{% render 'icone', nom: block.settings.icone %}</span>
            <div class="cs-garantie__textes">
              <h3 class="cs-h3">{{ block.settings.titre | escape }}</h3>
              {%- if block.settings.texte != blank -%}
                <p>{{ block.settings.texte | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "CS · Garanties",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "info": "28 caractères max" },
    { "type": "text", "id": "titre", "label": "Titre (H2)", "info": "60 caractères max" },
    { "type": "select", "id": "bg_style", "label": "Fond",
      "options": [ { "value": "base", "label": "Base" }, { "value": "alt", "label": "Alterné" }, { "value": "halo", "label": "Halo braise" } ], "default": "base" },
    { "type": "select", "id": "animation", "label": "Animation d'apparition",
      "options": [ { "value": "auto", "label": "Automatique (fondu)" }, { "value": "none", "label": "Aucune" } ], "default": "auto" },
    { "type": "range", "id": "padding_haut", "label": "Espace haut", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" },
    { "type": "range", "id": "padding_bas", "label": "Espace bas", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "engagement",
      "name": "Engagement",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icone", "label": "Icône",
          "options": [
            { "value": "horloge", "label": "Horloge" },
            { "value": "bouclier", "label": "Bouclier" },
            { "value": "check", "label": "Coche" },
            { "value": "coeur", "label": "Cœur" },
            { "value": "document", "label": "Document" },
            { "value": "message", "label": "Message" }
          ],
          "default": "bouclier" },
        { "type": "text", "id": "titre", "label": "Titre", "info": "32 caractères max" },
        { "type": "textarea", "id": "texte", "label": "Texte", "info": "110 caractères max" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CS · Garanties",
      "blocks": [
        { "type": "engagement", "settings": { "icone": "horloge", "titre": "Réponse sous 48 h", "texte": "Chaque demande reçoit une réponse d'un humain sous 48 h ouvrées." } },
        { "type": "engagement", "settings": { "icone": "bouclier", "titre": "Sans engagement", "texte": "L'audit est gratuit et ne vous engage à rien. Pas de relance agressive." } },
        { "type": "engagement", "settings": { "icone": "document", "titre": "Vos accès restent les vôtres", "texte": "Site, comptes publicitaires, données : tout vous appartient, contractuellement." } }
      ]
    }
  ]
}
{% endschema %}
