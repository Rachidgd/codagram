{%- comment -%}
  cs-process.liquid · La méthode en étapes (§8.10) : timeline verticale mobile,
  horizontale desktop. La ligne se dessine (clip), chaque étape monte quand
  la ligne l'atteint (stagger).
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
{{ 'section-process.css' | asset_url | stylesheet_tag }}

<section id="{{ section.id }}"
  class="cs-section cs-process{% if section.settings.bg_style == 'alt' %} cs-section--alt{% elsif section.settings.bg_style == 'halo' %} cs-section--halo{% endif %}"
  style="--pt: {{ section.settings.padding_haut }}px; --pb: {{ section.settings.padding_bas }}px;">
  <div class="cs-container">
    {%- if section.settings.titre != blank -%}
      <header class="cs-section__tete" data-reveal="up">
        {% render 'eyebrow', texte: section.settings.eyebrow %}
        <h2 class="cs-h2">{{ section.settings.titre | escape }}</h2>
        {%- if section.settings.intro != blank -%}
          <p>{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ol class="cs-process__liste" data-reveal-group role="list">
      <span class="cs-process__ligne" data-reveal="clip" aria-hidden="true"></span>
      {%- for block in section.blocks -%}
        {%- if block.settings.titre != blank -%}
          <li class="cs-process__etape" data-reveal="up" {{ block.shopify_attributes }}>
            <span class="cs-process__point" aria-hidden="true">{{ forloop.index }}</span>
            <div class="cs-process__contenu">
              <h3 class="cs-h3">{{ block.settings.titre | escape }}</h3>
              {%- if block.settings.texte != blank -%}
                <p>{{ block.settings.texte | escape }}</p>
              {%- endif -%}
              {%- if block.settings.duree != blank -%}
                <span class="cs-chip">{% render 'icone', nom: 'horloge', taille: 16 %} {{ block.settings.duree | escape }}</span>
              {%- endif -%}
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "CS · Méthode en étapes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "info": "28 caractères max" },
    { "type": "text", "id": "titre", "label": "Titre (H2)", "info": "60 caractères max" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "info": "180 caractères max" },
    { "type": "select", "id": "bg_style", "label": "Fond",
      "options": [ { "value": "base", "label": "Base" }, { "value": "alt", "label": "Alterné" }, { "value": "halo", "label": "Halo braise" } ], "default": "base" },
    { "type": "select", "id": "animation", "label": "Animation d'apparition",
      "options": [ { "value": "auto", "label": "Automatique (ligne + étapes)" }, { "value": "none", "label": "Aucune" } ], "default": "auto" },
    { "type": "range", "id": "padding_haut", "label": "Espace haut", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" },
    { "type": "range", "id": "padding_bas", "label": "Espace bas", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "etape",
      "name": "Étape",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "titre", "label": "Titre", "info": "32 caractères max" },
        { "type": "textarea", "id": "texte", "label": "Texte", "info": "160 caractères max" },
        { "type": "text", "id": "duree", "label": "Durée (chip)", "info": "Ex. Semaine 1. Cohérente avec la réalité opérationnelle (§8.10)." }
      ]
    }
  ],
  "presets": [ { "name": "CS · Méthode en étapes" } ]
}
{% endschema %}
