{%- comment -%}
  cs-hero-particles.liquid · Hero home (§8.1).
  LCP = le H1 texte (aucune image LCP). Séquence orchestrée ≤ 900 ms :
  eyebrow 0 ms → H1 100 ms → souligné braise 350 ms → sous-titre 250 ms →
  CTA 350 ms → mini-chiffres 500 ms. Particules preset hero en fond.
{%- endcomment -%}
{{ 'section-hero-particles.css' | asset_url | stylesheet_tag }}

<section id="{{ section.id }}" class="cs-hero" data-reveal-underline data-cs="hero">
  {%- if section.settings.particules and settings.motion_level != 'off' -%}
    <canvas class="cs-hero__particules" data-particles="hero"
      data-souris="{{ section.settings.souris }}" aria-hidden="true"></canvas>
  {%- endif -%}

  <div class="cs-container cs-hero__interieur">
    {%- if section.settings.eyebrow != blank -%}
      <p class="cs-eyebrow cs-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="cs-display cs-hero__titre">
      {%- liquid
        assign titre = section.settings.titre | escape
        assign mot = section.settings.mot_souligne | escape
        if mot != blank and titre contains mot
          assign remplacement = '<span class="cs-souligne">' | append: mot | append: '</span>'
          assign titre = titre | replace_first: mot, remplacement
        endif
      -%}
      {{ titre }}
    </h1>

    {%- if section.settings.sous_titre != blank -%}
      <p class="cs-hero__sous-titre">{{ section.settings.sous_titre | escape }}</p>
    {%- endif -%}

    <div class="cs-hero__cta">
      {% render 'bouton', label: section.settings.cta_primaire, popup: true, style: 'primaire', reassurance: section.settings.reassurance %}
      {% render 'bouton', label: section.settings.cta_secondaire, url: section.settings.cta_secondaire_url, style: 'secondaire' %}
    </div>

    {%- liquid
      assign a_chiffres = false
      if section.settings.chiffre_1_valeur != blank or section.settings.chiffre_2_valeur != blank or section.settings.chiffre_3_valeur != blank
        assign a_chiffres = true
      endif
    -%}
    {%- if a_chiffres -%}
      <ul class="cs-hero__preuves" role="list">
        {%- for i in (1..3) -%}
          {%- assign cle_valeur = 'chiffre_' | append: i | append: '_valeur' -%}
          {%- assign cle_label = 'chiffre_' | append: i | append: '_label' -%}
          {%- if section.settings[cle_valeur] != blank and section.settings[cle_label] != blank -%}
            <li class="cs-hero__preuve">
              <strong>{{ section.settings[cle_valeur] | escape }}</strong>
              <span>{{ section.settings[cle_label] | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="cs-hero__scroll" aria-hidden="true"><span></span></div>
</section>

{% schema %}
{
  "name": "CS · Hero particules",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "info": "28 caractères max" },
    { "type": "text", "id": "titre", "label": "Titre (H1)", "info": "50 caractères max", "default": "Des sites qui transforment les clics en clients." },
    { "type": "text", "id": "mot_souligne", "label": "Mot du titre à souligner", "info": "Doit apparaître tel quel dans le titre.", "default": "clients" },
    { "type": "textarea", "id": "sous_titre", "label": "Sous-titre", "info": "150 caractères max", "default": "Création, SEO et conversion pour PME et e-commerçants : des résultats mesurés, pas des promesses." },
    { "type": "header", "content": "Boutons" },
    { "type": "text", "id": "cta_primaire", "label": "Bouton primaire (popup)", "info": "24 caractères max", "default": "Mon audit gratuit" },
    { "type": "text", "id": "reassurance", "label": "Réassurance", "info": "70 caractères max", "default": "Réponse sous 48 h ouvrées. Sans engagement." },
    { "type": "text", "id": "cta_secondaire", "label": "Bouton secondaire", "info": "24 caractères max", "default": "Nos réalisations" },
    { "type": "url", "id": "cta_secondaire_url", "label": "Lien du bouton secondaire" },
    { "type": "header", "content": "Preuve compacte (chiffres réels, sinon vide)" },
    { "type": "text", "id": "chiffre_1_valeur", "label": "Chiffre 1 · valeur", "info": "8 caractères max" },
    { "type": "text", "id": "chiffre_1_label", "label": "Chiffre 1 · label", "info": "30 caractères max" },
    { "type": "text", "id": "chiffre_2_valeur", "label": "Chiffre 2 · valeur" },
    { "type": "text", "id": "chiffre_2_label", "label": "Chiffre 2 · label" },
    { "type": "text", "id": "chiffre_3_valeur", "label": "Chiffre 3 · valeur" },
    { "type": "text", "id": "chiffre_3_label", "label": "Chiffre 3 · label" },
    { "type": "header", "content": "Particules" },
    { "type": "checkbox", "id": "particules", "label": "Particules actives", "default": true },
    { "type": "checkbox", "id": "souris", "label": "Répulsion à la souris (desktop)", "default": true }
  ],
  "presets": [ { "name": "CS · Hero particules" } ],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}
