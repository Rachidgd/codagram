{%- comment -%}
  cs-stack.liquid · Sticky stacking cards (§8.6, mécanique §4.8).
  Sticky natif mobile (svh). JS scale/brightness en motion full uniquement.
  Maximum 5 cartes (limit bloqué).
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
{{ 'section-stack.css' | asset_url | stylesheet_tag }}

<section id="{{ section.id }}"
  class="cs-section cs-stack{% if section.settings.bg_style == 'alt' %} cs-section--alt{% elsif section.settings.bg_style == 'halo' %} cs-section--halo{% endif %}"
  style="--pt: {{ section.settings.padding_haut }}px; --pb: {{ section.settings.padding_bas }}px;"
  data-cs="stack">
  <div class="cs-container">
    {%- if section.settings.titre != blank -%}
      <header class="cs-section__tete" data-reveal="up">
        {% render 'eyebrow', texte: section.settings.eyebrow %}
        <h2 class="cs-h2">{{ section.settings.titre | escape }}</h2>
        {%- if section.settings.intro != blank -%}
          <p>{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="cs-stack__list">
      {%- for block in section.blocks -%}
        <article class="cs-stack__card cs-stack__card--{{ block.settings.fond }}"
          style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <div class="cs-stack__contenu">
            {%- if section.settings.numerotation -%}
              <span class="cs-stack__numero" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- endif -%}
            {%- if block.settings.titre != blank -%}
              <h3 class="cs-h2">{{ block.settings.titre | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.texte != blank -%}
              <p>{{ block.settings.texte | escape }}</p>
            {%- endif -%}
            {%- if block.settings.lien_label != blank and block.settings.lien != blank -%}
              <a href="{{ block.settings.lien }}" class="cs-lien">{{ block.settings.lien_label | escape }} {% render 'icone', nom: 'fleche', taille: 18 %}</a>
            {%- endif -%}
          </div>
          {%- if block.settings.image != blank -%}
            <div class="cs-stack__visuel">
              {% render 'forme', img: block.settings.image, shape: block.settings.shape, ratio: '3/2', sizes: '(min-width: 900px) 40vw, 90vw' %}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "CS · Cartes empilées",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "info": "28 caractères max" },
    { "type": "text", "id": "titre", "label": "Titre (H2)", "info": "60 caractères max" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "info": "180 caractères max" },
    { "type": "checkbox", "id": "numerotation", "label": "Numéroter les cartes", "info": "Uniquement si c'est une vraie séquence (§8.6).", "default": false },
    { "type": "select", "id": "bg_style", "label": "Fond",
      "options": [ { "value": "base", "label": "Base" }, { "value": "alt", "label": "Alterné" }, { "value": "halo", "label": "Halo braise" } ], "default": "base" },
    { "type": "select", "id": "animation", "label": "Animation d'apparition",
      "options": [ { "value": "auto", "label": "Automatique (sticky)" }, { "value": "none", "label": "Aucune" } ], "default": "auto" },
    { "type": "range", "id": "padding_haut", "label": "Espace haut", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" },
    { "type": "range", "id": "padding_bas", "label": "Espace bas", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "carte",
      "name": "Carte",
      "limit": 5,
      "settings": [
        { "type": "select", "id": "fond", "label": "Fond de la carte",
          "options": [
            { "value": "surface", "label": "Surface" },
            { "value": "surface-2", "label": "Surface élevée" },
            { "value": "verre", "label": "Verre" }
          ],
          "default": "surface" },
        { "type": "text", "id": "titre", "label": "Titre", "info": "40 caractères max" },
        { "type": "textarea", "id": "texte", "label": "Texte", "info": "220 caractères max" },
        { "type": "image_picker", "id": "image", "label": "Visuel (optionnel)" },
        { "type": "select", "id": "shape", "label": "Forme du visuel",
          "options": [
            { "value": "soft", "label": "Douce" },
            { "value": "diag-1", "label": "Diagonale 1" },
            { "value": "diag-2", "label": "Diagonale 2" },
            { "value": "arche", "label": "Arche" },
            { "value": "organique", "label": "Organique" }
          ],
          "default": "soft" },
        { "type": "text", "id": "lien_label", "label": "Micro-CTA (label)", "info": "24 caractères max" },
        { "type": "url", "id": "lien", "label": "Micro-CTA (lien)" }
      ]
    }
  ],
  "presets": [ { "name": "CS · Cartes empilées" } ]
}
{% endschema %}
