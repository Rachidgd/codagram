{%- comment -%}
  cs-stats.liquid · Chiffres interactifs (§8.4, compteurs §4.7).
  MUST §2.3 : chiffres réels sourcés. Un block sans valeur + label ne rend rien.
{%- endcomment -%}
{%- liquid
  assign a_chiffres = false
  for block in section.blocks
    if block.settings.valeur != blank and block.settings.label != blank
      assign a_chiffres = true
    endif
  endfor
-%}
{%- if a_chiffres -%}
{{ 'section-stats.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign anim = section.settings.animation
  if anim == 'auto'
    assign anim = 'up'
  endif
-%}
<section id="{{ section.id }}"
  class="cs-section cs-stats{% if section.settings.bg_style == 'alt' %} cs-section--alt{% elsif section.settings.bg_style == 'halo' %} cs-section--halo{% endif %}"
  style="--pt: {{ section.settings.padding_haut }}px; --pb: {{ section.settings.padding_bas }}px;">
  <div class="cs-container">
    {%- if section.settings.titre != blank -%}
      <header class="cs-section__tete cs-section__tete--centre" {% unless anim == 'none' %}data-reveal="{{ anim }}"{% endunless %}>
        {% render 'eyebrow', texte: section.settings.eyebrow %}
        <h2 class="cs-h2">{{ section.settings.titre | escape }}</h2>
        {%- if section.settings.intro != blank -%}
          <p>{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}
    <div class="cs-stats__rangee" data-reveal-group>
      {%- for block in section.blocks -%}
        {%- if block.settings.valeur != blank and block.settings.label != blank -%}
          <div class="cs-stats__item" {% unless anim == 'none' %}data-reveal="{{ anim }}"{% endunless %} {{ block.shopify_attributes }}>
            {% render 'chiffre',
              valeur: block.settings.valeur,
              prefixe: block.settings.prefixe,
              suffixe: block.settings.suffixe,
              label: block.settings.label,
              contexte: block.settings.contexte %}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "CS · Chiffres clés",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "info": "28 caractères max" },
    { "type": "text", "id": "titre", "label": "Titre (H2)", "info": "60 caractères max" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "info": "180 caractères max" },
    { "type": "select", "id": "bg_style", "label": "Fond",
      "options": [ { "value": "base", "label": "Base" }, { "value": "alt", "label": "Alterné" }, { "value": "halo", "label": "Halo braise" } ], "default": "base" },
    { "type": "select", "id": "animation", "label": "Animation d'apparition",
      "options": [ { "value": "auto", "label": "Automatique (recommandé)" }, { "value": "up", "label": "Montée" }, { "value": "scale", "label": "Zoom" }, { "value": "clip", "label": "Rideau" }, { "value": "fade", "label": "Fondu" }, { "value": "none", "label": "Aucune" } ], "default": "auto" },
    { "type": "range", "id": "padding_haut", "label": "Espace haut", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" },
    { "type": "range", "id": "padding_bas", "label": "Espace bas", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "chiffre",
      "name": "Chiffre",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "valeur", "label": "Valeur", "info": "8 caractères max, nombre seul (ex. 243). Chiffre réel, daté, attribuable (§2.3)." },
        { "type": "text", "id": "prefixe", "label": "Préfixe", "info": "Ex. +" },
        { "type": "text", "id": "suffixe", "label": "Suffixe", "info": "Ex. %" },
        { "type": "text", "id": "label", "label": "Label", "info": "30 caractères max" },
        { "type": "text", "id": "contexte", "label": "Contexte", "info": "60 caractères max. Un chiffre sans contexte est refusé (§2.3)." },
        { "type": "text", "id": "source_interne", "label": "Source interne", "info": "Non affichée : traçabilité de la preuve." }
      ]
    }
  ],
  "presets": [ { "name": "CS · Chiffres clés" } ]
}
{% endschema %}
