{%- comment -%}
  cs-equipe.liquid · Cartes membres (§8.18) : E-E-A-T incarné.
  Photo shape arche, hover désaturée → couleur.
{%- endcomment -%}
{%- liquid
  assign a_membres = false
  for block in section.blocks
    if block.settings.nom != blank
      assign a_membres = true
    endif
  endfor
-%}
{%- if a_membres -%}
{{ 'section-equipe.css' | asset_url | stylesheet_tag }}

<section id="{{ section.id }}"
  class="cs-section cs-equipe{% if section.settings.bg_style == 'alt' %} cs-section--alt{% elsif section.settings.bg_style == 'halo' %} cs-section--halo{% endif %}"
  style="--pt: {{ section.settings.padding_haut }}px; --pb: {{ section.settings.padding_bas }}px;">
  <div class="cs-container">
    {%- if section.settings.titre != blank -%}
      <header class="cs-section__tete" data-reveal="up">
        {% render 'eyebrow', texte: section.settings.eyebrow %}
        <h2 class="cs-h2">{{ section.settings.titre | escape }}</h2>
        {%- if section.settings.intro != blank -%}
          <p>{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}
    <div class="cs-equipe__grille" data-reveal-group>
      {%- for block in section.blocks -%}
        {%- if block.settings.nom != blank -%}
          <div class="cs-equipe__carte" data-reveal="up" {{ block.shopify_attributes }}>
            {%- if block.settings.photo != blank -%}
              <div class="cs-equipe__photo" data-shape="arche">
                {% render 'image', img: block.settings.photo, sizes: '(min-width: 900px) 25vw, 46vw', ratio: '4/5', alt: block.settings.nom %}
              </div>
            {%- endif -%}
            <h3 class="cs-h3">{{ block.settings.nom | escape }}</h3>
            {%- if block.settings.role != blank -%}
              <p class="cs-equipe__role">{{ block.settings.role | escape }}</p>
            {%- endif -%}
            {%- if block.settings.ligne != blank -%}
              <p class="cs-equipe__ligne">{{ block.settings.ligne | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "CS · Équipe",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "info": "28 caractères max" },
    { "type": "text", "id": "titre", "label": "Titre (H2)", "info": "60 caractères max" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "info": "180 caractères max" },
    { "type": "select", "id": "bg_style", "label": "Fond",
      "options": [ { "value": "base", "label": "Base" }, { "value": "alt", "label": "Alterné" }, { "value": "halo", "label": "Halo braise" } ], "default": "base" },
    { "type": "select", "id": "animation", "label": "Animation d'apparition",
      "options": [ { "value": "auto", "label": "Automatique (montée)" }, { "value": "none", "label": "Aucune" } ], "default": "auto" },
    { "type": "range", "id": "padding_haut", "label": "Espace haut", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" },
    { "type": "range", "id": "padding_bas", "label": "Espace bas", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "membre",
      "name": "Membre",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo réelle", "info": "Jamais de stock (§3.6)." },
        { "type": "text", "id": "nom", "label": "Nom" },
        { "type": "text", "id": "role", "label": "Rôle", "info": "40 caractères max" },
        { "type": "text", "id": "ligne", "label": "Une ligne", "info": "90 caractères max" }
      ]
    }
  ],
  "presets": [ { "name": "CS · Équipe" } ]
}
{% endschema %}
