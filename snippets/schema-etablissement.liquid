{%- comment -%}
  Données structurées de l'établissement.
  Émises une seule fois, sur toutes les pages, avec un @id stable : les autres
  blocs JSON-LD du thème (services, articles) s'y rattachent par référence
  plutôt que de redéclarer le cabinet.
{%- endcomment -%}

{%- liquid
  assign type = settings.seo_type_etablissement | default: 'HealthAndBeautyBusiness'
  assign racine = shop.url
  assign identifiant = racine | append: '/#etablissement'
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": {{ type | json }},
    "@id": {{ identifiant | json }},
    "name": {{ settings.cabinet_nom | default: shop.name | json }},
    "url": {{ racine | json }}
    {%- if settings.seo_description_etablissement != blank -%}
      , "description": {{ settings.seo_description_etablissement | strip_html | json }}
    {%- endif -%}
    {%- if settings.logo != blank -%}
      , "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
      , "image": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
    {%- endif -%}
    {%- if settings.cabinet_tel != blank -%}
      , "telephone": {{ settings.cabinet_tel | json }}
    {%- endif -%}
    {%- if settings.cabinet_email != blank -%}
      , "email": {{ settings.cabinet_email | json }}
    {%- endif -%}
    {%- if settings.cabinet_prix_indicatif != blank -%}
      , "priceRange": {{ settings.cabinet_prix_indicatif | json }}
    {%- endif -%}
    , "currenciesAccepted": {{ shop.currency | json }}
    {%- if settings.cabinet_rue != blank or settings.cabinet_ville != blank -%}
      , "address": {
        "@type": "PostalAddress"
        {%- if settings.cabinet_rue != blank -%}
          , "streetAddress": {{ settings.cabinet_rue | json }}
        {%- endif -%}
        {%- if settings.cabinet_cp != blank -%}
          , "postalCode": {{ settings.cabinet_cp | json }}
        {%- endif -%}
        {%- if settings.cabinet_ville != blank -%}
          , "addressLocality": {{ settings.cabinet_ville | json }}
        {%- endif -%}
        , "addressCountry": {{ settings.cabinet_pays | default: 'FR' | json }}
      }
    {%- endif -%}
    {%- if settings.cabinet_lat != blank and settings.cabinet_lon != blank -%}
      , "geo": {
        "@type": "GeoCoordinates",
        "latitude": {{ settings.cabinet_lat | json }},
        "longitude": {{ settings.cabinet_lon | json }}
      }
    {%- endif -%}
    {%- if settings.cabinet_horaires_donnees != blank -%}
      {%- assign lignes = settings.cabinet_horaires_donnees | strip | newline_to_br | split: '<br />' -%}
      , "openingHours": [
        {%- for ligne in lignes -%}
          {%- assign propre = ligne | strip -%}
          {%- if propre != blank -%}
            {{ propre | json }}{%- unless forloop.last -%},{%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    {%- endif -%}
    {%- if settings.rdv_url != blank -%}
      , "potentialAction": {
        "@type": "ReserveAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ settings.rdv_url | json }},
          "inLanguage": {{ request.locale.iso_code | json }},
          "actionPlatform": [
            "http://schema.org/DesktopWebPlatform",
            "http://schema.org/MobileWebPlatform"
          ]
        },
        "result": { "@type": "Reservation", "name": {{ settings.rdv_libelle | default: 'Prendre rendez-vous' | json }} }
      }
    {%- endif -%}
    {%- capture reseaux -%}
      {%- if settings.reseau_instagram != blank -%}{{ settings.reseau_instagram | json }},{%- endif -%}
      {%- if settings.reseau_tiktok != blank -%}{{ settings.reseau_tiktok | json }},{%- endif -%}
      {%- if settings.reseau_facebook != blank -%}{{ settings.reseau_facebook | json }},{%- endif -%}
      {%- if settings.reseau_linkedin != blank -%}{{ settings.reseau_linkedin | json }},{%- endif -%}
      {%- if settings.reseau_google != blank -%}{{ settings.reseau_google | json }},{%- endif -%}
    {%- endcapture -%}
    {%- assign reseaux = reseaux | strip | split: ',' | compact -%}
    {%- if reseaux.size > 0 -%}
      , "sameAs": [{{ reseaux | join: ',' }}]
    {%- endif -%}
  }
</script>
