{%- comment -%}
  Métadonnées de partage. Une image dédiée par type de contenu quand elle
  existe, sinon l'image sociale de marque.
{%- endcomment -%}

{%- liquid
  assign og_type = 'website'
  assign share_image = null

  case request.page_type
    when 'article'
      assign og_type = 'article'
      if article.image != blank
        assign share_image = article.image
      endif
    when 'page'
      if page.metafields.seo_release.share_image.value != blank
        assign share_image = page.metafields.seo_release.share_image.value
      endif
    when 'product'
      assign og_type = 'product'
      if product.featured_image != blank
        assign share_image = product.featured_image
      endif
  endcase

  if share_image == null and settings.share_image != blank
    assign share_image = settings.share_image
  endif
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ title | default: shop.name | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- if description != blank %}
  <meta property="og:description" content="{{ description | strip_html | truncate: 300 | escape }}">
{%- endif %}
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">

{%- if share_image != blank %}
  <meta property="og:image" content="http:{{ share_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ share_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: share_image.aspect_ratio | round }}">
  {%- if share_image.alt != blank %}<meta property="og:image:alt" content="{{ share_image.alt | escape }}">{% endif %}
{%- endif %}

{%- if request.page_type == 'article' %}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  {%- if article.metafields.editorial.updated_at.value != blank %}
    <meta property="article:modified_time" content="{{ article.metafields.editorial.updated_at.value | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  {%- endif %}
  {%- if article.author != blank %}<meta property="article:author" content="{{ article.author | escape }}">{% endif %}
{%- endif %}

<meta name="twitter:card" content="{% if share_image != blank %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ title | default: shop.name | escape }}">
{%- if description != blank %}
  <meta name="twitter:description" content="{{ description | strip_html | truncate: 200 | escape }}">
{%- endif %}
{%- if share_image != blank %}
  <meta name="twitter:image" content="https:{{ share_image | image_url: width: 1200 }}">
{%- endif %}
