{%- comment -%}
  Fil d'Ariane structuré. Reconstruit la hiérarchie logique du site —
  Accueil › Protocoles › [soin] pour les pages de soin, Accueil › Journal ›
  [article] pour le blog — plutôt que de refléter l'URL plate de Shopify.
{%- endcomment -%}

{%- unless template.name == 'index' or template.name == 'password' -%}
  {%- liquid
    assign racine = shop.url
    assign fil = ''

    case template.name
      when 'page'
        assign est_soin = false
        if page.metafields.ely.famille == 'protocole' or page.template_suffix contains 'soin'
          assign est_soin = true
        endif
        if est_soin
          assign fil = 'protocoles'
        endif
        assign titre_courant = page.title
        assign url_courante = page.url
      when 'blog'
        assign titre_courant = blog.title
        assign url_courante = blog.url
      when 'article'
        assign fil = 'journal'
        assign titre_courant = article.title
        assign url_courante = article.url
      when 'product'
        assign titre_courant = product.title
        assign url_courante = product.url
      when 'collection'
        assign titre_courant = collection.title
        assign url_courante = collection.url
      else
        assign titre_courant = page_title
        assign url_courante = request.path
    endcase
  -%}

  {%- if titre_courant != blank -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": {{ 'referencement.accueil' | t | json }},
            "item": {{ racine | json }}
          }
          {%- if fil == 'protocoles' -%}
            , {
              "@type": "ListItem",
              "position": 2,
              "name": {{ 'referencement.protocoles' | t | json }},
              "item": {{ racine | append: '/pages/protocoles' | json }}
            }
            , {
              "@type": "ListItem",
              "position": 3,
              "name": {{ titre_courant | json }},
              "item": {{ racine | append: url_courante | json }}
            }
          {%- elsif fil == 'journal' -%}
            , {
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | default: 'Journal' | json }},
              "item": {{ racine | append: blog.url | json }}
            }
            , {
              "@type": "ListItem",
              "position": 3,
              "name": {{ titre_courant | json }},
              "item": {{ racine | append: url_courante | json }}
            }
          {%- else -%}
            , {
              "@type": "ListItem",
              "position": 2,
              "name": {{ titre_courant | json }},
              "item": {{ racine | append: url_courante | json }}
            }
          {%- endif -%}
        ]
      }
    </script>
  {%- endif -%}
{%- endunless -%}
