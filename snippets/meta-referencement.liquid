{%- comment -%}
  Métadonnées de référencement.
  Shopify n'émet ni <title> ni meta description : c'est au thème de le faire.
  Les valeurs de repli sont construites depuis les réglages du cabinet pour
  qu'aucune page ne parte sans description.
{%- endcomment -%}

{%- liquid
  assign titre = page_title

  assign description = page_description
  if description == blank
    if template.name == 'index' and settings.seo_description_etablissement != blank
      assign description = settings.seo_description_etablissement
    else
      assign description = shop.description
    endif
  endif
  assign description = description | strip_html | strip_newlines | truncate: 300

  assign image_partage = settings.image_partage
  if template.name == 'article' and article.image
    assign image_partage = article.image
  elsif template.name == 'page' and page.metafields.ely.image_partage != blank
    assign image_partage = page.metafields.ely.image_partage
  endif
-%}

<title>
  {{- titre -}}
  {%- if current_tags -%}
    {{- ' — ' }}{{ current_tags | join: ', ' -}}
  {%- endif -%}
  {%- if current_page != 1 -%}
    {{- ' — ' }}{{ 'referencement.page' | t: numero: current_page -}}
  {%- endif -%}
  {%- unless titre contains shop.name -%}
    {{- ' · ' }}{{ shop.name -}}
  {%- endunless -%}
</title>

{%- if description != blank -%}
  <meta name="description" content="{{ description | escape }}">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ titre | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code }}">
{%- if description != blank -%}
  <meta property="og:description" content="{{ description | escape }}">
{%- endif -%}

{%- case template.name -%}
  {%- when 'article' -%}
    <meta property="og:type" content="article">
    {%- if article.published_at -%}
      <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
    {%- endif -%}
  {%- else -%}
    <meta property="og:type" content="website">
{%- endcase -%}

{%- if image_partage != blank -%}
  <meta property="og:image" content="https:{{ image_partage | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: image_partage.aspect_ratio | round }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https:{{ image_partage | image_url: width: 1200 }}">
{%- else -%}
  <meta name="twitter:card" content="summary">
{%- endif -%}

<meta name="twitter:title" content="{{ titre | escape }}">
{%- if description != blank -%}
  <meta name="twitter:description" content="{{ description | escape }}">
{%- endif -%}
