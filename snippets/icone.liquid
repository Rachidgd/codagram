{%- comment -%}
  Jeu d'icônes dessiné pour Ély'Skin.

  Deux familles, un seul langage : filet de 1 px, géométrie au compas, aucun
  angle arrondi décoratif, aucun pictogramme figuratif issu d'une bibliothèque.

  — « ui.* »      : interface (flèches, fermeture, coordonnées, réseaux).
  — « sigle.* »   : marques abstraites des sept protocoles. Chacune traduit le
                    principe physique du soin, pas l'objet qui le délivre.

  Paramètres : nom, taille (défaut 20), classe, trait (défaut 1)
{%- endcomment -%}

{%- liquid
  assign t = taille | default: 20
  assign e = trait | default: 1
-%}

<svg
  class="ely-icone {{ classe }}"
  width="{{ t }}"
  height="{{ t }}"
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="{{ e | times: 40 | divided_by: t }}"
  aria-hidden="true"
  focusable="false"
>
  {%- case nom -%}
    {%- comment -%} ——— Interface ——— {%- endcomment -%}
    {%- when 'ui.fleche-diagonale' -%}
      <path d="M12 28 28 12M28 12h-12M28 12v12"/>
    {%- when 'ui.fleche-droite' -%}
      <path d="M8 20h24M24 12l8 8-8 8"/>
    {%- when 'ui.fleche-gauche' -%}
      <path d="M32 20H8M16 12l-8 8 8 8"/>
    {%- when 'ui.fleche-bas' -%}
      <path d="M20 8v24M12 24l8 8 8-8"/>
    {%- when 'ui.fermer' -%}
      <path d="M11 11 29 29M29 11 11 29"/>
    {%- when 'ui.menu' -%}
      <path d="M6 14h28M6 26h20"/>
    {%- when 'ui.chevron' -%}
      <path d="M14 16l6 6 6-6"/>
    {%- when 'ui.coche' -%}
      <path d="M10 21l6.5 6.5L30 13"/>
    {%- when 'ui.telephone' -%}
      <path d="M13 8h6l3 7-4 2a13 13 0 0 0 6 6l2-4 7 3v6c0 1.1-.9 2-2 2C18.5 30 10 21.5 10 10c0-1.1.9-2 2-2z"/>
    {%- when 'ui.courriel' -%}
      <rect x="6" y="11" width="28" height="18"/>
      <path d="M6 13l14 10 14-10"/>
    {%- when 'ui.epingle' -%}
      <path d="M20 34s10-10.6 10-17a10 10 0 1 0-20 0c0 6.4 10 17 10 17z"/>
      <circle cx="20" cy="17" r="3.6"/>
    {%- when 'ui.horloge' -%}
      <circle cx="20" cy="20" r="13"/>
      <path d="M20 12v8.5l6 3.5"/>
    {%- when 'ui.instagram' -%}
      <rect x="8" y="8" width="24" height="24" rx="7"/>
      <circle cx="20" cy="20" r="6"/>
      <circle cx="27" cy="13" r="1.4" fill="currentColor" stroke="none"/>
    {%- when 'ui.tiktok' -%}
      <path d="M23 7v18.2a5.8 5.8 0 1 1-5.8-5.8c.6 0 1.2.1 1.8.3"/>
      <path d="M23 7c.6 4.3 3.3 6.8 7.4 7.2"/>
    {%- when 'ui.facebook' -%}
      <path d="M25 9h-3.5C19 9 18 10.6 18 13v4h-4v5h4v13"/>
      <path d="M14 22h4m0 0h5"/>
    {%- when 'ui.linkedin' -%}
      <rect x="8" y="8" width="24" height="24"/>
      <path d="M14 18v9M14 14v.5M20 27v-6a3 3 0 0 1 6 0v6"/>
      <path d="M20 18v9"/>

    {%- comment -%}
      ——— Sigles des protocoles ———
      Chaque marque encode le principe d'action, sur la même grille de 40.
    {%- endcomment -%}

    {%- when 'sigle.hydrafacial' -%}
      {%- comment -%} Vortex d'aspiration : spirale de points, resserrement centripète. {%- endcomment -%}
      <circle cx="20" cy="20" r="14.5"/>
      <path d="M20 6.5a13.5 13.5 0 0 1 0 27 9.5 9.5 0 0 1 0-19 5.5 5.5 0 0 1 0 11"/>
      <circle cx="20" cy="20" r="1.6" fill="currentColor" stroke="none"/>

    {%- when 'sigle.microneedling' -%}
      {%- comment -%} Trame d'impacts : grille régulière de micro-perforations. {%- endcomment -%}
      <circle cx="20" cy="20" r="14.5"/>
      <g fill="currentColor" stroke="none">
        <circle cx="14" cy="14" r="1.1"/><circle cx="20" cy="14" r="1.1"/><circle cx="26" cy="14" r="1.1"/>
        <circle cx="14" cy="20" r="1.1"/><circle cx="20" cy="20" r="1.1"/><circle cx="26" cy="20" r="1.1"/>
        <circle cx="14" cy="26" r="1.1"/><circle cx="20" cy="26" r="1.1"/><circle cx="26" cy="26" r="1.1"/>
      </g>
      <path d="M20 3v5M20 32v5M3 20h5M32 20h5"/>

    {%- when 'sigle.peeling' -%}
      {%- comment -%} Strates : couches décalées, la plus haute se soulève. {%- endcomment -%}
      <circle cx="20" cy="20" r="14.5"/>
      <path d="M8.5 25h23M9.5 29.5h21"/>
      <path d="M11 20.5c4-5 8-7.5 12-7.5s6.5 1.6 8.4 3.6"/>
      <path d="M31.4 16.1c-2.6 1.4-5.2 2.3-7.8 2.6"/>

    {%- when 'sigle.diagnostic' -%}
      {%- comment -%} Mire de relevé : réticule et graduations. {%- endcomment -%}
      <circle cx="20" cy="20" r="14.5"/>
      <circle cx="20" cy="20" r="6.5"/>
      <path d="M20 5.5v5M20 29.5v5M5.5 20h5M29.5 20h5"/>
      <path d="M9.8 9.8l2.6 2.6M27.6 27.6l2.6 2.6M30.2 9.8l-2.6 2.6M12.4 27.6l-2.6 2.6"/>

    {%- when 'sigle.hifu' -%}
      {%- comment -%} Focalisation : ondes convergeant vers un point profond. {%- endcomment -%}
      <circle cx="20" cy="20" r="14.5"/>
      <path d="M9 12c3.6 3.4 7.3 5.1 11 5.1S27.4 15.4 31 12"/>
      <path d="M11.6 17c2.8 2.6 5.6 3.9 8.4 3.9s5.6-1.3 8.4-3.9"/>
      <path d="M14.6 22.3c1.8 1.6 3.6 2.4 5.4 2.4s3.6-.8 5.4-2.4"/>
      <circle cx="20" cy="29" r="1.6" fill="currentColor" stroke="none"/>

    {%- when 'sigle.led' -%}
      {%- comment -%} Rayonnement : émission continue depuis une source pleine. {%- endcomment -%}
      <circle cx="20" cy="20" r="6"/>
      <path d="M20 2v6M20 32v6M2 20h6M32 20h6"/>
      <path d="M7.3 7.3l4.2 4.2M28.5 28.5l4.2 4.2M32.7 7.3l-4.2 4.2M11.5 28.5l-4.2 4.2"/>
      <circle cx="20" cy="20" r="14.5" stroke-dasharray="1.5 4"/>

    {%- when 'sigle.drainage' -%}
      {%- comment -%} Flux : trois courants parallèles orientés dans le même sens. {%- endcomment -%}
      <circle cx="20" cy="20" r="14.5"/>
      <path d="M7 15.5c3.5-2.6 6.4-2.6 8.7 0s5.2 2.6 8.7 0 6.4-2.6 8.7 0"/>
      <path d="M7 21c3.5-2.6 6.4-2.6 8.7 0s5.2 2.6 8.7 0 6.4-2.6 8.7 0"/>
      <path d="M7 26.5c3.5-2.6 6.4-2.6 8.7 0s5.2 2.6 8.7 0 6.4-2.6 8.7 0"/>

    {%- when 'sigle.protocole' -%}
      {%- comment -%} Marque générique : trois strates de protocole. {%- endcomment -%}
      <circle cx="20" cy="20" r="14.5"/>
      <path d="M12 15h16M12 20h16M12 25h9"/>
  {%- endcase -%}
</svg>
