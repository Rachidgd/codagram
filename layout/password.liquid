<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-js="off">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.c_absolu }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ shop.name }}</title>

    <link rel="preload" as="font" type="font/woff2" href="{{ 'jost-var-latin.woff2' | asset_url }}" crossorigin>
    <style>
      @font-face {
        font-family: "Jost";
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url({{ 'jost-var-latin.woff2' | asset_url }}) format("woff2");
      }
      @font-face {
        font-family: "Instrument Sans";
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url({{ 'instrument-var-latin.woff2' | asset_url }}) format("woff2");
      }
      :root {
        --color-porcelaine: {{ settings.c_porcelaine | default: '#f6f3ef' }};
        --color-encre: {{ settings.c_encre | default: '#191512' }};
        --color-absolu: {{ settings.c_absolu | default: '#1b3a31' }};
        --color-brume: {{ settings.c_brume | default: '#9fb3aa' }};
        --color-peau: {{ settings.c_peau | default: '#e0c4b2' }};
      }
      html { background: var(--color-absolu); }
      body { margin: 0; font-family: "Instrument Sans", Arial, sans-serif; }
    </style>
    <link rel="stylesheet" href="{{ 'ely.css' | asset_url }}">
    {{ content_for_header }}
  </head>

  <body class="surface-sombre">
    <main class="mot-de-passe">
      <div class="lisiere mot-de-passe__contenu">
        {{ content_for_layout }}
      </div>
    </main>
  </body>
</html>
