<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0b0e0d">
    <title>{{ shop.name }}</title>
    <link rel="canonical" href="{{ canonical_url }}">

    <style>
      @font-face {
        font-family: "Jost";
        src: url("{{ 'cc-jost.woff2' | asset_url }}") format("woff2");
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "CC Mono";
        src: url("{{ 'cc-jbmono.woff2' | asset_url }}") format("woff2");
        font-weight: 400 700;
        font-style: normal;
        font-display: swap;
      }
      html { background: #0b0e0d; }
    </style>

    {{ 'signal.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>
    {{ content_for_header }}
  </head>

  <body class="surface-dark">
    <main id="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
